expression PEDIDOS_IGNORAR =
		let
		    Source = PEDIDOS_RAW,
		    Tipado = Table.TransformColumnTypes(Source,{{"Orden", type text}, {"Tagetik", type text}, {"Cantidad", type number}, {"Importe", type number}, {"Fecha Pedido", type date}, {"Documento Compras", type text}, {"Texto de cabecera", type text}, {"Solicitud de Pedido", type text}, {"Sociedad", type text}, {"Contrato Marco", type text}, {"Proveedor", type text}, {"Solicitante", type text}, {"Número de imputación", type text}, {"Texto de posición", type text}, {"Fecha de Entrega", type date}, {"Indicador Liberación", type text}, {"Indicador de borrado", type text}, {"Tipo pedido", type text}, {"Demanda", type text}, {"Ignorar", type text}, {"Observaciones", type text}, {"Posición", type text}}),
		    Renombrado = Table.RenameColumns(Tipado,{{"Importe", "Coste"}, {"Fecha Pedido", "Fecha"}}),
		    #"Sanitizar Proveedor" = Table.ReplaceValue(Renombrado,null,"-",Replacer.ReplaceValue,{"Proveedor"}),
		    #"Sanitizar proveedor 2" = Table.ReplaceValue(#"Sanitizar Proveedor","","-",Replacer.ReplaceValue,{"Proveedor"}),
		    #"Add KEY_PEDIDO" = Table.AddColumn(#"Sanitizar proveedor 2", "KEY_PEDIDO", each [Documento Compras]&"_"&[Posición]&"_"&[Orden]),
		    #"Add KEY_BUDGET" = Table.AddColumn(#"Add KEY_PEDIDO", "KEY_BUDGET", each [Orden]&"_"&[Tagetik]),
		    #"Tipado 2" = Table.TransformColumnTypes(#"Add KEY_BUDGET",{{"KEY_BUDGET", type text}, {"KEY_PEDIDO", type text}}),
		    Personalizado1 = Table.AddColumn(#"Tipado 2", "Proveedor Nombre", each
		     let
		             match = Table.SelectRows(PROVEEDORES, (p) => p[Proveedor] = [Proveedor]),
		             firstMatch = if Table.RowCount(match) > 0 then match{0}[Nombre] else [Proveedor]
		    in
		        firstMatch
		),
		    #"Add ERROR_KB (vlookup)" = Table.AddColumn(#"Personalizado1", "ERROR_KB", each
		     let
		        match = Table.SelectRows(PRESUPUESTO, (r) => r[KEY_BUDGET] = [KEY_BUDGET] and r[Año] = Date.Year(AÑO_ACTUAL)),
		        firstMatch = if Table.RowCount(match) > 0 then null else true
		    in
		        firstMatch
		),
		    Filtrado = Table.SelectRows(#"Add ERROR_KB (vlookup)", each ([Ignorar] = "true")),
		    #"Add TABLA_ORIGEN" = Table.AddColumn(Filtrado, "Tabla Origen", each "Pedidos", type text)
		in
		    #"Add TABLA_ORIGEN"
