expression COMPROMETIDO = ```
		let
		    Source = COMPROMETIDO_RAW,
		    Filtrado = Table.SelectRows(Source, each ([Ignorar] = null)),
		    Tipado = Table.TransformColumnTypes(Filtrado,{
		        {"Sociedad", type text}, {"Documento Compras", type text}, {"Proveedor", type text}, {"Posición", type text}, 
		        {"Fecha Registro", type date}, {"Texto explicativo", type text}, {"Descripción Cuenta", type text}, {"Cantidad", type number}, 
		        {"Unidad", type text}, {"Coste", type number}, {"Fecha Esperada Cargo", type date}, {"Orden", type text}, 
		        {"Tagetik", type text}, {"Ignorar", type text}, {"Observaciones", type text}, {"Demanda", type text}
		    }),
		    #"Add KEY_PEDIDO" = Table.AddColumn(Tipado, "KEY_PEDIDO", each [Documento Compras]&"_"&[Posición]&"_"&[Orden]),
		    #"Tipado 2" = Table.TransformColumnTypes(#"Add KEY_PEDIDO",{{"KEY_PEDIDO", type text}}),
		    #"Columnas quitadas" = Table.RemoveColumns(#"Tipado 2",{"Ignorar", "Observaciones", "Sociedad", "Fecha Registro"}),
		    #"Sanitizar proveedor 1" = Table.ReplaceValue(#"Columnas quitadas", null, "-", Replacer.ReplaceValue, {"Proveedor"}),
		    #"Sanitizar proveedor 2" = Table.ReplaceValue(#"Sanitizar proveedor 1","","-",Replacer.ReplaceValue,{"Proveedor"}),
		    #"Add FECHA IMPACTO BUDGET" = Table.AddColumn(#"Sanitizar proveedor 2", "FECHA IMPACTO BUDGET", each 
		        let
		            currentYearStart = AÑO_ACTUAL,
		            fechaEsperada = [Fecha Esperada Cargo]
		        in
		            if fechaEsperada < currentYearStart then currentYearStart else fechaEsperada
		    ),
		    #"Renombrar IMPACTO BUDGET" = Table.RenameColumns(#"Add FECHA IMPACTO BUDGET",{{"Coste", "COSTE IMPACTO BUDGET"}}),
		    #"Add DEMANDA IMPACTO BUDGET" = Table.AddColumn(#"Renombrar IMPACTO BUDGET", "DEMANDA IMPACTO BUDGET", each
		        let
		            match = Table.SelectRows(PEDIDOS, (p) => p[KEY_PEDIDO] = [KEY_PEDIDO]),
		            firstMatch = if Table.RowCount(match) > 0 then match{0}[Demanda] else [Demanda]
		        in
		            firstMatch
		    ),
		    #"Columnas quitadas1" = Table.RemoveColumns(#"Add DEMANDA IMPACTO BUDGET",{"Demanda", "Fecha Esperada Cargo"}),
		    #"Add ERROR_KP (Vlookup)" = Table.AddColumn(#"Columnas quitadas1", "ERROR_KP", each
		        let
		            match = Table.SelectRows(PEDIDOS, (r) => r[KEY_PEDIDO] = [KEY_PEDIDO]),
		            isDocEmpty = [Documento Compras] = null or Text.Trim([Documento Compras]) = "",
		            firstMatch = if Table.RowCount(match) > 0 or isDocEmpty then null else true
		        in
		            firstMatch
		    ),
		    #"Add New Tagetik (lookup)" = Table.AddColumn(#"Add ERROR_KP (Vlookup)", "New Tagetik", each 
		        let
		            currentKeyPedido = [KEY_PEDIDO],
		            match = Table.First(Table.SelectRows(PEDIDOS, (r) => r[KEY_PEDIDO] = currentKeyPedido), null)
		        in
		            if match <> null then match[Tagetik] else [Tagetik]
		    ),
		    #"Remove Tagetik" = Table.RemoveColumns(#"Add New Tagetik (lookup)",{"Tagetik"}),
		    #"Renombrar New Tagetik" = Table.RenameColumns(#"Remove Tagetik",{{"New Tagetik", "Tagetik"}}),
		    #"Add KEY_BUDGET" = Table.AddColumn(#"Renombrar New Tagetik", "KEY_BUDGET", each [Orden]&"_"&[Tagetik]),
		    #"Add ERROR_KB (Vlookup)" = Table.AddColumn(#"Add KEY_BUDGET", "ERROR_KB", each
		        let
		            match = Table.SelectRows(PRESUPUESTO, (r) => r[KEY_BUDGET] = [KEY_BUDGET] and r[Año] = Date.Year(AÑO_ACTUAL)),
		            firstMatch = if Table.RowCount(match) > 0 then null else true
		        in
		            firstMatch
		    ),
		    #"Add IGNORAR (Vlookup)" = Table.AddColumn(#"Add ERROR_KB (Vlookup)", "Ignorar", each 
		        let
		            match = Table.SelectRows(PEDIDOS_IGNORAR, (r) => 
		                r[#"Documento Compras"] = [#"Documento Compras"] and
		                r[Posición] = [Posición]
		            ),
		            hayIgnorar = if Table.RowCount(match) > 0 then true else null
		        in
		            hayIgnorar
		    ),
		    #"Filas filtradas" = Table.SelectRows(#"Add IGNORAR (Vlookup)", each [Ignorar] = null),
		    #"Add TABLA_ORIGEN" = Table.AddColumn(#"Filas filtradas", "Tabla Origen", each "Comprometido", type text),
		    #"Columnas reordenadas" = Table.ReorderColumns(#"Add TABLA_ORIGEN",{
		        "Documento Compras", "Proveedor", "Posición", "Texto explicativo", "Descripción Cuenta", "Cantidad", "Unidad", 
		        "COSTE IMPACTO BUDGET", "Orden", "Tagetik", "KEY_PEDIDO", "FECHA IMPACTO BUDGET", "DEMANDA IMPACTO BUDGET", 
		        "ERROR_KP", "KEY_BUDGET", "ERROR_KB", "Ignorar", "Tabla Origen"
		    })
		in
		    #"Columnas reordenadas"
		```
	lineageTag: f0031d0c-d00f-487c-bda9-7c7b89cebc8b
	queryGroup: ARCHIVOS_TRATADOS

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Exception

expression RECEPCIONES = ```
		let
		    Source = RECEPCIONES_RAW,
		    Filtrado = Table.SelectRows(Source, each ([Ignorar] = null)),
		    Tipado = Table.TransformColumnTypes(Filtrado,{{"Fecha Registro", type date}, {"Fecha Contable", type date}, {"Documento Compras", type text}, {"Proveedor", type text}, {"Coste", type number}, {"Orden", type text}, {"Tagetik", type text}, {"Posición", type text}, {"Sociedad", type text}, {"Texto explicativo", type text}, {"Descripción Cuenta", type text}, {"Cantidad", type number}, {"Unidad", type text}, {"Documento CO", type text}, {"Ignorar", type text}, {"Observaciones", type text}}),
		    Renombrado = Table.RenameColumns(Tipado,{{"Fecha Contable", "Fecha"}}),
		    #"Add KEY_PEDIDO" = Table.AddColumn(Renombrado, "KEY_PEDIDO", each if [Documento Compras] <> null and [Documento Compras] <> "" then [Documento Compras]&"_"&[Posición]&"_"&[Orden] else null),
		    #"Tipado 2" = Table.TransformColumnTypes(#"Add KEY_PEDIDO",{{"KEY_PEDIDO", type text}}),
		    #"Columnas quitadas" = Table.RemoveColumns(#"Tipado 2",{"Fecha Registro", "Ignorar", "Observaciones", "Sociedad"}),
		    #"Renombrado IMPACTO BUDGET" = Table.RenameColumns(#"Columnas quitadas",{{"Fecha", "FECHA IMPACTO BUDGET"}, {"Coste", "COSTE IMPACTO BUDGET"}}),
		    #"Sanitizar proveedor" = Table.ReplaceValue(#"Renombrado IMPACTO BUDGET", null, "-", Replacer.ReplaceValue, {"Proveedor"}),
		    #"Sanitizar proveedor 2" = Table.ReplaceValue(#"Sanitizar proveedor","","-",Replacer.ReplaceValue,{"Proveedor"}),
		    #"Add DEMANDA IMPACTO BUDGET" = Table.AddColumn(#"Sanitizar proveedor 2", "DEMANDA IMPACTO BUDGET", each
		     let
		             match = Table.SelectRows(PEDIDOS, (p) => p[KEY_PEDIDO] = [KEY_PEDIDO]),
		             firstMatch = if Table.RowCount(match) > 0 then match{0}[Demanda] else [Demanda]
		    in
		        firstMatch
		),
		    #"Columnas quitadas1" = Table.RemoveColumns(#"Add DEMANDA IMPACTO BUDGET",{"Demanda"}),
		    #"Add ERROR_KP (lookup)" = Table.AddColumn(#"Columnas quitadas1", "ERROR_KP", each let
		    currentYear = Date.Year(AÑO_ACTUAL),
		    isMatch = Table.RowCount(Table.SelectRows(PEDIDOS, (r) => r[KEY_PEDIDO] = [KEY_PEDIDO])),
		    isDocEmpty = [Documento Compras] = null or Text.Trim([Documento Compras]) = "",
		    isDocPrevYear = Date.Year([FECHA IMPACTO BUDGET]) < currentYear,
		    firstMatch = if isDocEmpty or isDocPrevYear then null else if isMatch > 0 then null else true
		in
		    firstMatch
		),
		    #"Add New Tagetik (lookup)" = Table.AddColumn(
		    #"Add ERROR_KP (lookup)", 
		    "New Tagetik", 
		    each 
		        let
		            currentKeyPedido = [KEY_PEDIDO],
		            fechaImpacto = [FECHA IMPACTO BUDGET],
		            isPreviousYear = Date.Year(fechaImpacto) < Date.Year(AÑO_ACTUAL),
		            match = Table.First(Table.SelectRows(PEDIDOS, (r) => r[KEY_PEDIDO] = currentKeyPedido), null)
		        in
		            if isPreviousYear then
		                [Tagetik]
		            else
		                if match <> null then match[Tagetik] else [Tagetik]
		),
		    #"Remove Tagetik" = Table.RemoveColumns(#"Add New Tagetik (lookup)",{"Tagetik"}),
		    #"Renombar New Tagetik" = Table.RenameColumns(#"Remove Tagetik",{{"New Tagetik", "Tagetik"}}),
		    #"Add KEY_BUDGET" = Table.AddColumn(#"Renombar New Tagetik", "KEY_BUDGET", each [Orden]&"_"&[Tagetik]),
		    #"Add ERROR_KB (Vlookup)" = Table.AddColumn(#"Add KEY_BUDGET", "ERROR_KB", each
		     let
		        sourceTable = if Date.Year([FECHA IMPACTO BUDGET]) = Date.Year(AÑO_ACTUAL) then PRESUPUESTO else PRESUPUESTO_HISTORICO,
		        match = Table.SelectRows(sourceTable, (r) => r[KEY_BUDGET] = [KEY_BUDGET]),
		        firstMatch = if Table.RowCount(match) > 0 then null else true
		    in
		        firstMatch
		),
		    #"Add IGNORAR (Vlookup)" = Table.AddColumn(#"Add ERROR_KB (Vlookup)", "Ignorar", each 
		        let
		        match = Table.SelectRows(PEDIDOS, (r) => r[KEY_PEDIDO] = [KEY_PEDIDO] and r[Ignorar] <> null),
		        hayIgnorar = if Table.RowCount(match) > 0 then true else null
		    in
		        hayIgnorar
		    ),
		    #"Filas filtradas" = Table.SelectRows(#"Add IGNORAR (Vlookup)", each [Ignorar] = null),
		    #"Add TABLA_ORIGEN" = Table.AddColumn(#"Filas filtradas", "Tabla Origen", each "Recepciones", type text),
		    #"Columnas reordenadas" = Table.ReorderColumns(#"Add TABLA_ORIGEN",{"Documento Compras", "Proveedor", "FECHA IMPACTO BUDGET", "Posición", "Texto explicativo", "Descripción Cuenta", "Doc. Referencia", "Clase Doc. Referencia", "Texto Cabecera Doc", "Cantidad", "Unidad", "COSTE IMPACTO BUDGET", "Orden", "Tagetik", "Documento CO", "KEY_PEDIDO", "DEMANDA IMPACTO BUDGET", "ERROR_KP", "KEY_BUDGET", "ERROR_KB", "Ignorar", "Tabla Origen"})
		in
		    #"Columnas reordenadas"
		```
	lineageTag: acee4100-b260-4e72-b265-9f44d8a441ac
	queryGroup: ARCHIVOS_TRATADOS

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

expression PROVISIONES = ```
		let
		    Source = PROVISIONES_RESTO_RAW,
		    Filtrado = Table.SelectRows(Source, each ([Desactivar provisión] = null)),
		    Unpivoted = Table.UnpivotOtherColumns(Filtrado, {"Tagetik", "Id Partida Forecast", "Descripción partida Forecast", "Solicitante", "Proveedor", "Importe", "Tipo Provisión", "Documento Compras"}, "Mes", "Coste"),
		    #"Tipado 1" = Table.TransformColumnTypes(Unpivoted,{{"Mes", type text}}),
		    #"Add Fecha Provison Otras" = Table.AddColumn(#"Tipado 1", "Fecha Provisión Otras", each Number.ToText(Date.Year(DateTime.LocalNow())) &"/"&[Mes]),
		    #"Tipo cambiado1" = Table.TransformColumnTypes(#"Add Fecha Provison Otras",{{"Fecha Provisión Otras", type date}}),
		    #"Columnas quitadas3" = Table.RemoveColumns(#"Tipo cambiado1",{"Mes"}),
		    #"Add Provisiones Demanda" = Table.Combine({#"Columnas quitadas3", PROVISIONES_DEMANDA_RAW}),
		    #"Filas filtradas" = Table.SelectRows(#"Add Provisiones Demanda", each ([Desactivar provisión] = null)),
		    #"Add Fecha Provision Demanda" = Table.AddColumn(#"Filas filtradas", "Fecha Provisión Demanda", each if [Inicio Real] <> null then [Inicio Real] else if [Inicio Plan] <> null then [Inicio Plan] else [Inicio Estimado]),
		    #"Consolidar FECHA IMPACTO BUDGET" = Table.AddColumn(#"Add Fecha Provision Demanda", "Fecha Impacto Budget", each if [Fecha Provisión Otras] <> null then [Fecha Provisión Otras] else [Fecha Provisión Demanda]),
		    #"Consolidar COSTE IMPACTO BUDGET" = Table.AddColumn(#"Consolidar FECHA IMPACTO BUDGET", "Coste Impacto Budget", each 
		if [Tipo Provisión] = "HISTORICA" then
		   if [Fecha Impacto Budget] < DateTime.Date(DateTime.LocalNow()) then 0 else [Coste]
		else if [Tipo Provisión] = "FUTURO" then [Coste]
		else [Importe]
		),
		    #"Add ORDEN (vlookup)" = Table.AddColumn(#"Consolidar COSTE IMPACTO BUDGET", "Orden", each
		     let
		        currentYear = AÑO_ACTUAL,
		        match = Table.SelectRows(PRESUPUESTO, (r) => r[Tagetik] = [Tagetik] and r[Año] = currentYear),
		        firstMatch = if Table.RowCount(match) > 0 then match{0}[Orden] else null
		    in
		        firstMatch
		),
		    #"Add KEY_BUDGET" = Table.AddColumn(#"Add ORDEN (vlookup)", "KEY_BUDGET", each [Orden]&"_"&[Tagetik]),
		    #"Columnas quitadas" = Table.RemoveColumns(#"Add KEY_BUDGET",{"Coste", "Fecha Provisión Otras", "Inicio Estimado", "Inicio Plan", "Inicio Real", "Desactivar provisión", "Fecha Provisión Demanda", "Importe"}),
		    #"Tipado 2" = Table.TransformColumnTypes(#"Columnas quitadas",{{"Fecha Impacto Budget", type date}, {"Coste Impacto Budget", type number}, {"KEY_BUDGET", type text}, {"Orden", type text}}),
		    #"Columnas reordenadas" = Table.ReorderColumns(#"Tipado 2",{"Orden", "Tagetik", "Id Partida Forecast", "Descripción partida Forecast", "Solicitante", "Proveedor", "Tipo Provisión", "Documento Compras", "Horas", "Fecha Impacto Budget", "Coste Impacto Budget", "KEY_BUDGET"}),
		    #"Columnas con nombre cambiado" = Table.RenameColumns(#"Columnas reordenadas",{{"Coste Impacto Budget", "COSTE IMPACTO BUDGET"}, {"Fecha Impacto Budget", "FECHA IMPACTO BUDGET"}}),
		    #"Sanitizar proveedor" = Table.ReplaceValue(#"Columnas con nombre cambiado", null, "-", Replacer.ReplaceValue, {"Proveedor"}),
		    #"Add DEMANDA IMPACTO BUDGET" = Table.AddColumn(#"Sanitizar proveedor", "DEMANDA IMPACTO BUDGET", each if [Tipo Provisión] = "DEMANDA" then [Id Partida Forecast] else null),
		    #"Check PROVISION DEMANDA PEDIDO" = Table.AddColumn(#"Add DEMANDA IMPACTO BUDGET", "Check demanda en pedido", each
		    let
		        match = if [Tipo Provisión] = "DEMANDA" then
		                    Table.SelectRows(PEDIDOS, (p) => p[Demanda] = [DEMANDA IMPACTO BUDGET])
		                 else
		                    null,
		        firstMatch = if match <> null and Table.RowCount(match) > 0 then "True" else null
		    in
		        firstMatch
		),
		    #"Filas filtradas1" = Table.SelectRows(#"Check PROVISION DEMANDA PEDIDO", each ([Check demanda en pedido] = null) and ([COSTE IMPACTO BUDGET] <> 0)),
		    #"Columnas quitadas1" = Table.RemoveColumns(#"Filas filtradas1",{"Check demanda en pedido"}),
		    #"Add ERROR_KB (Vlookup)" = Table.AddColumn(#"Columnas quitadas1", "ERROR_KB", each
		     let
		        year = Date.Year([FECHA IMPACTO BUDGET]),
		        match = Table.SelectRows(PRESUPUESTO, (r) => r[KEY_BUDGET] = [KEY_BUDGET] and r[Año] = year),
		        firstMatch = if Table.RowCount(match) > 0 then null else true
		    in
		        firstMatch
		),
