	measure ZMD_Color_Fila_Demanda = ```
			
			VAR PedidoFila = ISINSCOPE(PEDIDOS[Documento Compras])
			VAR PosicionFila = ISINSCOPE(PEDIDOS[Posición])
			VAR DocumentoFila = ISINSCOPE(IMPACTO_BUDGET[Doc. Referencia])
			
			RETURN
			    SWITCH(TRUE(),
			        DocumentoFila, "#FFFFFF",    // blanco
			        PosicionFila, "#DDDDDD",     // gris oscuro
			        PedidoFila, "#BBBBBB",       // gris medio
			        "#000000"                    // gris claro por defecto
			    )
			
			
			```
		displayFolder: DEMANDA
		lineageTag: 52d7b5c6-89eb-427a-a29c-8ced69af2db8

	measure ZMD_Color_Fila_Proveedor = ```
			
			VAR ContratoMarcoFila = ISINSCOPE(PEDIDOS[Contrato Marco])
			VAR ProveedorFila = ISINSCOPE(PROVEEDORES[Nombre])
			
			RETURN
			    SWITCH(TRUE(),
			        ContratoMarcoFila, "#FFFFFF",     // blanco
			        ProveedorFila, "#DDDDDD",         // gris oscuro
			        "#000000"                         // gris medio por defecto
			    )
			
			
			
			```
		displayFolder: PROVEEDORES
		lineageTag: def8261c-1df5-407b-8d9a-7b39deb363ae

	measure ZMD_Color_Fila_Comunes = ```
			
			VAR EsOrden = ISINSCOPE(COMUNES_PRESUPUESTO[DESCRIPCION ORDEN])
			VAR EsArea = ISINSCOPE(COMUNES_PRESUPUESTO[AREA])
			VAR EsSubarea = ISINSCOPE(COMUNES_PRESUPUESTO[SUBAREA])
			VAR EsPartida = ISINSCOPE(COMUNES_RECEPCIONES[Partida])
			
			RETURN
			    SWITCH(TRUE(),
			        EsPartida, "#FFFFFF",   // blanco
			        EsSubarea, "#DDDDDD",   // gris claro (contrastado)
			        EsOrden, "#BBBBBB",     // gris medio
			        EsArea, "#999999",      // gris oscuro
			        "#000000"               // negro por defecto
			    )
			
			
			
			
			
			```
		displayFolder: COMUNES
		lineageTag: 16b6f378-276b-4b3b-bb35-e209c6e288b3

	measure ZMD_Color_Fila_Comunes_AZUL = ```
			
			VAR EsOrden = ISINSCOPE(COMUNES_PRESUPUESTO[DESCRIPCION ORDEN])
			VAR EsArea = ISINSCOPE(COMUNES_PRESUPUESTO[AREA])
			VAR EsSubarea = ISINSCOPE(COMUNES_PRESUPUESTO[SUBAREA])
			VAR EsPartida = ISINSCOPE(COMUNES_RECEPCIONES[Partida])
			
			RETURN
			    SWITCH(TRUE(),
			        EsPartida, "#D0E4FF",    // azul muy claro
			        EsSubarea, "#7FBFFF",    // azul claro (contrastado)
			        EsOrden, "#5CA6E0",      // azul medio
			        EsArea, "#337AB7",       // azul oscuro
			        "#000000"                // negro por defecto
			    )
			
			
			
			```
		displayFolder: COMUNES
		lineageTag: 0e56aa7b-ca31-452b-8701-ad03c9fc2dc1

	measure ZMD_Color_Fila_Comunes_VERDE = ```
			
			VAR EsOrden = ISINSCOPE(COMUNES_PRESUPUESTO[DESCRIPCION ORDEN])
			VAR EsArea = ISINSCOPE(COMUNES_PRESUPUESTO[AREA])
			VAR EsSubarea = ISINSCOPE(COMUNES_PRESUPUESTO[SUBAREA])
			VAR EsPartida = ISINSCOPE(COMUNES_RECEPCIONES[Partida])
			
			RETURN
			    SWITCH(TRUE(),
			        EsPartida, "#D9F2D9",    // verde muy claro
			        EsSubarea, "#8FD88F",    // verde claro
			        EsOrden, "#5DBA5D",      // verde medio
