	measure ZMD_EJE_MAXIMO_GLOBAL = ```
			
			VAR AnioActual = [ZMD_PARAMS_AÑO_ACTUAL]
			VAR AnioPrevio = [ZMD_PARAMS_AÑO_PREVIO]
			
			-- Tabla virtual de los 12 meses
			VAR TablaMeses = GENERATESERIES(1, 12)
			
			-- 1. Máximos mensuales para FORECAST
			VAR MaxForecast =
			    MAXX(
			        TablaMeses,
			        VAR MesActual = [Value]
			        RETURN
			            CALCULATE(
			                SUM(FORECAST[Coste]),
			                FILTER(
			                    FORECAST,
			                    YEAR(FORECAST[Date]) = AnioActual &&
			                    MONTH(FORECAST[Date]) = MesActual
			                )
			            )
			    )
			
			-- 2. Máximos mensuales para COMPROMETIDO + RECEPCIONADO (año actual)
			VAR MaxCompRec =
			    MAXX(
			        TablaMeses,
			        VAR MesActual = [Value]
			        RETURN
			            CALCULATE(
			                SUM(IMPACTO_BUDGET[COSTE IMPACTO BUDGET]),
			                FILTER(
			                    IMPACTO_BUDGET,
			                    IMPACTO_BUDGET[Tabla Origen] IN { "Comprometido", "Recepciones" } &&
			                    YEAR(IMPACTO_BUDGET[FECHA IMPACTO BUDGET]) = AnioActual &&
			                    MONTH(IMPACTO_BUDGET[FECHA IMPACTO BUDGET]) = MesActual
			                )
			            )
			    )
			
			-- 3. Máximos mensuales para RECEPCIONADO (año previo)
			VAR MaxRecepPrev =
			    MAXX(
			        TablaMeses,
			        VAR MesActual = [Value]
			        RETURN
			            CALCULATE(
			                SUM(IMPACTO_BUDGET[COSTE IMPACTO BUDGET]),
			                FILTER(
			                    IMPACTO_BUDGET,
			                    IMPACTO_BUDGET[Tabla Origen] = "Recepciones" &&
			                    YEAR(IMPACTO_BUDGET[FECHA IMPACTO BUDGET]) = AnioPrevio &&
			                    MONTH(IMPACTO_BUDGET[FECHA IMPACTO BUDGET]) = MesActual
			                )
			            )
			    )
			
			RETURN
			    MAX( MAX(MaxForecast, MaxCompRec), MaxRecepPrev )
			
			
			
			
			```
		displayFolder: FORECAST
		lineageTag: 40aa77c9-2883-492b-aac6-a9caa406476f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition MEDIDAS = m
