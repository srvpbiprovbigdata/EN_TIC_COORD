	measure ZMD_PARAM_Comunes_Disponible_Anterior = [ZMD_PARAM_Comunes_Presupuesto] - [ZMD_PARAM_Comunes_Recepciones_Anterior]
		displayFolder: COMUNES
		lineageTag: e7b58d86-b71d-4bfc-a8f2-bce397663dd1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure ZMD_PARAM_Comunes_Recepciones_Anterior = ```
			
			VAR MaxFecha = MAX(COMUNES_RECEPCIONES[Fecha])
			VAR MaxMes = MONTH(MaxFecha)
			VAR MaxAnio = YEAR(MaxFecha)
			VAR UltimoMesCompleto = EOMONTH(DATE(MaxAnio, MaxMes, 1), -1)
			
			RETURN
			CALCULATE(
			    SUM(COMUNES_RECEPCIONES[Value]),
			    FILTER(
			        COMUNES_RECEPCIONES,
			        COMUNES_RECEPCIONES[Fecha] <= UltimoMesCompleto
			    )
			)
			
			```
		displayFolder: COMUNES
		lineageTag: 2f4747fb-dd68-4412-beca-1e6df3374f9f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure ZMD_Forecast_Planificado_Todo =
			CALCULATE(
			    SUM(FORECAST[Coste]),
			    FILTER(
			        FORECAST,
			        YEAR(FORECAST[Date]) = [ZMD_PARAMS_AÑO_ACTUAL] &&
			        MONTH(FORECAST[Date]) >= [ZMD_PARAM_Forecast_Mes]
			    )
			)
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		displayFolder: FORECAST
		lineageTag: f15380a1-71e2-43ef-82e2-efaa2830705e

	measure ZMD_Forecast_Disponible_PrevMonth = [ZMD_Presupuesto] - [ZMD_Forecast_Recepcionado_PrevMonth] - [ZMD_Forecast_Planificado_PendientePrevMonth]
		displayFolder: FORECAST
		lineageTag: 9a71133d-104f-4382-ac49-e60d81e5e825

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure ZMD_Forecast_Planificado_Pendiente =
			CALCULATE(
			    SUM(FORECAST[Coste]),
			    FILTER(
			        FORECAST,
			        YEAR(FORECAST[Date]) = [ZMD_PARAMS_AÑO_ACTUAL] &&
			        MONTH(FORECAST[Date]) >= MONTH(TODAY())
			    )
			)
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: FORECAST
