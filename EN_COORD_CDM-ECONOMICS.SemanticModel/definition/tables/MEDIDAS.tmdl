	measure ZMD_Demandas_Q_Sin_Economics =
			
			CALCULATE(
			    SUM(DEMANDA[Presupuesto Total]),
			    FILTER(
			        DEMANDA,
			        ISBLANK(
			            CALCULATE(
			                COUNTROWS(IMPACTO_BUDGET),
			                FILTER(
			                    IMPACTO_BUDGET,
			                    IMPACTO_BUDGET[DEMANDA IMPACTO BUDGET] = DEMANDA[Demanda] &&
			                    IMPACTO_BUDGET[Tabla Origen] IN { "Recepciones", "Comprometido" }
			                )
			            )
			        )
			    )
			)
		displayFolder: DEMANDA
		lineageTag: 3b15cecb-3cbd-4243-aeab-8c866ae362ad

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure ZMD_Demandas_P_Sin_Economics = ```
			
			CALCULATE(
			    COUNT(DEMANDA[Demanda]),
			    FILTER(
			        DEMANDA,
			        ISBLANK(
			            CALCULATE(
			                COUNTROWS(IMPACTO_BUDGET),
			                FILTER(
			                    IMPACTO_BUDGET,
			                    IMPACTO_BUDGET[DEMANDA IMPACTO BUDGET] = DEMANDA[Demanda] &&
			                    IMPACTO_BUDGET[Tabla Origen] IN { "Recepciones", "Comprometido" }
			                )
			            )
			        )
			    )
			)
			
			```
