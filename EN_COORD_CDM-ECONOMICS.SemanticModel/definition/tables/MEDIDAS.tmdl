	measure ZMD_Forecast_Planificado_PendientePrevMonth =
			
			VAR MesHoy = MONTH(TODAY())
			VAR MesForecast = [ZMD_PARAM_Forecast_Mes]
			
			RETURN
			IF (
			    MesHoy = MesForecast,
			    [ZMD_FORECAST_Planificado_todo],
			    CALCULATE(
			        SUM(FORECAST[Coste]),
			        FILTER(
			            FORECAST,
			            YEAR(FORECAST[Date]) = [ZMD_PARAMS_AÑO_ACTUAL] &&
			            MONTH(FORECAST[Date]) >= (MesHoy - 1)
			        )
			    )
			)
		displayFolder: FORECAST
		lineageTag: 96a6d4d8-0683-4730-8c63-4270edcb5777

		annotation PBI_FormatHint = {"isGeneralNumber":true}

