	measure ZMD_Recepcionado_YTD_Filtrado = ```
			
			VAR FechaMax = MAX(COMUNES_RECEPCIONES[Fecha])
			VAR FechaInicioAnio = DATE(YEAR(FechaMax), 1, 1)
			VAR FechaFinMes = EOMONTH(FechaMax, 0)
			RETURN
			COALESCE(
			    CALCULATE(
			        SUM(IMPACTO_BUDGET[COSTE IMPACTO BUDGET]),
			        IMPACTO_BUDGET[Tabla Origen] = "Recepciones",
			        IMPACTO_BUDGET[Orden] = "100000000193",
			        FILTER(
			            IMPACTO_BUDGET,
			            IMPACTO_BUDGET[FECHA IMPACTO BUDGET] >= FechaInicioAnio &&
			            IMPACTO_BUDGET[FECHA IMPACTO BUDGET] <= FechaFinMes
			        )
			    ),
			    0
			)
			
			
			
			
			```
		displayFolder: COMUNES
		lineageTag: 9adaf813-3f04-4126-9fb5-8e6a436c97a9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure ZMD_Matrix_Comunes_Presupuesto_Porcentaje = ```
			
			VAR TieneAreaNoBlanca =
			    COUNTROWS(
			        FILTER(
			            VALUES(COMUNES_PRESUPUESTO[AREA]),
			            NOT ISBLANK(COMUNES_PRESUPUESTO[AREA])
			        )
			    ) > 0
			
			VAR PorcentajeExistente = SELECTEDVALUE(COMUNES_PRESUPUESTO[% Energy])
			
			RETURN
			IF(
			    TieneAreaNoBlanca && NOT ISBLANK(PorcentajeExistente), 
			    PorcentajeExistente,
			    DIVIDE(
			        [ZMD_Matrix_Comunes_Presupuesto],
			        [ZMD_Matrix_Comunes_Presupuesto_Global],
			        BLANK() 
			    )
			)
			```
		displayFolder: COMUNES
		lineageTag: 7a9a4528-fddf-444d-a6fd-209b788c3a3c

