	measure ZMD_Forecast_Fichero_Mensual =
			
			VAR AnioActual = [ZMD_PARAMS_AÑO_ACTUAL]
			VAR MesActualIteracion = MONTH(MAX(FORECAST[Date]))
			
			VAR CosteForecastMesActual =
			    CALCULATE(
			        SUM(FORECAST[Coste]),
			        FILTER(
			            ALL(FORECAST[Date]),  -- solo elimina filtro de fecha, no de relaciones
			            YEAR(FORECAST[Date]) = AnioActual &&
			            MONTH(FORECAST[Date]) = MesActualIteracion
			        )
			    )
			
			RETURN
			    CosteForecastMesActual
		displayFolder: FORECAST
