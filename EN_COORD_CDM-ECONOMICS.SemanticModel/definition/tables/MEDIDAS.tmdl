	measure ZMD_Disponible_PrevMonth = [ZMD_Presupuesto] - [ZMD_Recepcionado_PrevMonth] - [ZMD_Comprometido_PrevMonth] - [ZMD_Provisiones_PrevMonth]
		displayFolder: OVERVIEW
		lineageTag: fa82e5e1-9b99-436f-b79c-a7db090d8e44

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure ZMD_Provisiones_PrevMonthVar = ```
			
			VAR ProvisionesActual = [ZMD_Provisiones_YTD]
			VAR ProvisionesAnterior = [ZMD_Provisiones_PrevMonth]
			
			VAR Variacion = 
			    IF(ProvisionesAnterior <> 0, 
			        (ProvisionesActual - ProvisionesAnterior) / ProvisionesAnterior, 
			        BLANK()
			    )
			
			VAR Simbolo = 
			    SWITCH(TRUE(),
			        Variacion > 0, UNICHAR(9650),  -- ▲ Triángulo arriba
			        Variacion < 0, UNICHAR(9660),  -- ▼ Triángulo abajo
			        UNICHAR(61)  -- = Signo igual
			    )
			
			RETURN 
			    FORMAT(Variacion, "0.00%") & " " & Simbolo
			
			```
		displayFolder: OVERVIEW
		lineageTag: 270b6ba0-4d49-4151-b1bd-eac1d89fee5a

	measure ZMD_Comprometido_PrevMonthVar = ```
			
			VAR ComprometidoActual = [ZMD_Comprometido_YTD]
			VAR ComprometidoAnterior = [ZMD_Comprometido_PrevMonth]
			
			VAR Variacion = 
			    IF(ComprometidoAnterior <> 0, 
			        (ComprometidoActual - ComprometidoAnterior) / ComprometidoAnterior, 
			        BLANK()
			    )
			
			VAR Simbolo = 
			    SWITCH(TRUE(),
			        Variacion > 0, UNICHAR(9650),  -- ▲ Triángulo arriba
			        Variacion < 0, UNICHAR(9660),  -- ▼ Triángulo abajo
			        UNICHAR(61)  -- = Signo igual
			    )
			
			RETURN 
			    FORMAT(Variacion, "0.00%") & " " & Simbolo
			
			```
		displayFolder: OVERVIEW
		lineageTag: 9ddb71b1-0dc0-4021-8fc0-ade8e7e3c3a3

