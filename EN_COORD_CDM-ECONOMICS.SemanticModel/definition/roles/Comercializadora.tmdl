role Comercializadora
	modelPermission: read

	tablePermission PRESUPUESTO = [Unidad] == "Comercial."

	tablePermission COMUNES_AMORTIZACIONES = [Value] == Blank()

	tablePermission COMUNES_PRESUPUESTO = [% Energy] == Blank()

	tablePermission COMUNES_RECEPCIONES = [Value] == Blank()

	annotation PBI_Id = 824cfe57727b47bcb5e2abd8d296fba0

