	column 'ZCC_URL Demanda' = CONCATENATE("https://acciona.service-now.com/dmn_demand.do?sysparm_query=number%3d",Demandas[number])
		lineageTag: cf503f90-bfce-4ee9-877a-333f8c1131f6
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column ZCC_Primera_Fecha_Inicio_Demanda = ```
			
			VAR MinWorkStartDate = 
			    CALCULATE(
			        MIN('Completa'[work_start]),
			        FILTER(
			            'Completa',
			            'Completa'[UnionConDemanda] = 'Demandas'[sys_id]
			        )
			    )
			RETURN
			IF(
			    NOT(ISBLANK(MinWorkStartDate)),
			    MinWorkStartDate,
			    IF(
			        NOT(ISBLANK('Demandas'[start_date])),
			        'Demandas'[start_date],
			        BLANK()
			    )
			)
			```
		formatString: dd/mm/yyyy
		lineageTag: ae829ecc-5acd-4941-b76a-b9a90fc3022e
		summarizeBy: none

		variation Variación
			isDefault
			relationship: 5abbb727-e539-4d4d-a168-4be6d5321aab
			defaultHierarchy: LocalDateTable_636b0a11-939f-4283-85ba-48e7192347fb.'Jerarquía de fechas'

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	column ZCC_Ultima_Fecha_Fin_Demanda = ```
			
			VAR MaxWorkEndDate = 
			    CALCULATE(
			        MAX('Completa'[schedule_end_date]),
			        FILTER(
			            'Completa',
			            'Completa'[UnionConDemanda] = 'Demandas'[sys_id]
			        )
			    )
			RETURN
			IF(
			    NOT(ISBLANK(MaxWorkEndDate)),
			    MaxWorkEndDate,
			    IF(
			        NOT(ISBLANK('Demandas'[due_date])),
			        'Demandas'[due_date],
			        BLANK()
			    )
			)
			```
		formatString: dd/mm/yyyy
		lineageTag: 049e31dc-6a14-4e85-a2e6-0fda0bffb70f
		summarizeBy: none

		variation Variación
			isDefault
			relationship: 8d6efb12-5b95-4b01-8486-536ee134629b
			defaultHierarchy: LocalDateTable_c48d018b-b78a-482d-ab5a-28213d9ace68.'Jerarquía de fechas'

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	column ZCC_ProyectoAsociado = ```
			
			VAR Proyecto = 
			    CALCULATE(
			        MIN('Completa'[number]),
			        FILTER(
			            'Completa',
			            'Completa'[UnionConDemanda] = 'Demandas'[sys_id]
			        )
			    )
			RETURN 
			IF(
			    ISBLANK(Proyecto),
			    BLANK(),
			    Proyecto
			)
			```
		lineageTag: efa72001-2d05-4b2e-be93-4e5d6edb3981
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column ZCC_NegocioAsociado = RELATED('Equipos Gestores'[Negocio])
		lineageTag: 7265b27c-ae89-4c3a-8809-aa4a3db1274d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Tiene_Proyectos/Evolutivos_Asociados =
			
			IF(
			    ISBLANK(Demandas[ZCC_ProyectoAsociado]),
