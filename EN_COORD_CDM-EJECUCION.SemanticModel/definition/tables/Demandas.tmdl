table Demandas
	lineageTag: c4549296-f92c-4c92-9f00-941db39d042f

	measure ZMD_Demandas_Que_Terminan_En_30_Días =
			
			VAR FechaActual = TODAY()
			VAR FechaLimite = FechaActual + 30
			RETURN
			CALCULATE(
			    COUNTROWS(Demandas),
			    'Demandas'[approved_end_date] >= FechaActual,
			    'Demandas'[approved_end_date] <= FechaLimite
			)
		formatString: 0
		lineageTag: 0915d2d1-bc3a-4885-be7a-a2e82fdd4ca1

	measure ZMD_Demandas_Que_Terminan_En_7_Días =
			
			VAR FechaActual = TODAY()
			VAR FechaLimite = FechaActual + 7
			RETURN
			CALCULATE(
			    COUNTROWS(Demandas),
			    'Demandas'[approved_end_date] >= FechaActual,
			    'Demandas'[approved_end_date] <= FechaLimite
			)
		formatString: 0
		lineageTag: a088eac7-1a67-49b7-b060-40785f356edb

	measure ZMD_KPI_Demandas_CerradasEsteAno =
			
			CALCULATE(
			    COUNT('Demandas'[number]),
			    FILTER(
			        'Demandas',
			        YEAR('Demandas'[u_actual_end_date]) = YEAR(TODAY())
			    )
			)
		formatString: 0
		lineageTag: 5c79245c-8e15-475f-9873-165c129e2be6

	measure ZMD_Demandas_sinProyEvol =
			
			COUNTROWS(
			    FILTER(
			        Demandas,
			        ISBLANK(
			            CALCULATE(
			                MIN('Completa'[number]),
			                FILTER(
			                    'Completa',
			                    'Completa'[UnionConDemanda] = Demandas[sys_id]
			                )
			            )
			        )
			    )
			)
		formatString: 0
		lineageTag: 822e0836-b617-4170-be35-b3f2f87b88d2

	measure Recuento_Demandas_Sin_Proyecto = ```
			
			CALCULATE(
			    COUNTROWS('Demandas'),
			    'Demandas'[ZCC_ProyectoAsociado] = FALSE()
			)
			
			```
		formatString: 0
		lineageTag: 51603c33-6f12-479c-8c3e-bf133750d8cd

	measure ZMD_AvisoSeleccionDemanda =
			
			IF(
			    OR(
			        ISFILTERED('Demandas'[number]),
			        ISFILTERED('Demandas'[short_description])
			    ),
			    BLANK(),
			    "Por favor, seleccione una demanda en el filtro."
			)
		lineageTag: e607cad1-9c41-4bcf-a09f-ca336a1940a8

