	partition Demandas = m
		mode: import
		source =
				let
				    Origen = Sql.Databases("QECCDWH.ACCIONA.INT:60001"),
				    DWH = Origen{[Name="DWH"]}[Data],
				    SERV_NOW_EN_V_dmn_demand = DWH{[Schema="SERV_NOW_EN",Item="V_dmn_demand"]}[Data],
				    #"Columnas quitadas" = Table.RemoveColumns(SERV_NOW_EN_V_dmn_demand,{"work_notes_list", "work_start", "u_idl", "u_id_plan", "watch_list", "wf_activity", "dv_wf_activity", "work_end", "work_notes", "user_input", "variables", "visited_state", "universal_request", "dv_universal_request", "dv_upon_approval", "upon_reject", "u_volume_impacted_users", "upon_approval", "enablers", "enhancement", "escalation", "idea", "dv_idea", "investment_class", "dv_investment_class", "investment_type", "dv_investment_type", "knowledge", "labor_costs", "out_of_scope", "primary_program", "dv_primary_program", "rate_model", "dv_rate_model", "reassignment_count", "rejection_goto", "dv_rejection_goto", "scrum_epic", "dv_scrum_epic", "scrum_story", "dv_scrum_story", "service_offering", "dv_service_offering"}),
				    #"Filas en blanco eliminadas" = Table.SelectRows(#"Columnas quitadas", each not List.IsEmpty(List.RemoveMatchingItems(Record.FieldValues(_), {"", null}))),
				    #"Errores quitados" = Table.RemoveRowsWithErrors(#"Filas en blanco eliminadas", {"active"})
				in
				    #"Errores quitados"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navegación

