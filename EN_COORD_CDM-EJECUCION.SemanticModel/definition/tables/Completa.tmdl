	column ZCC_Proyectos_Contados_Segun_FormuladelBacklog = ```
			
			VAR _Current_EOM = EOMONTH(MAX(CalendarTable[Date]), 0)
			VAR _work_start = 'Completa'[opened_at]
			VAR _work_end = 'Completa'[closed_at]
			VAR _ZCC_Estado_Evolutivo = 'completa'[ZCC_Estado_Evolutivo]
			VAR _ZCC_Proyecto_Evol = 'completa'[ZCC_Proyecto- Evol]
			
			VAR _Contado = 
			    IF(
			        (
			            _work_start <= _Current_EOM
			            && _work_start > DATE(2019, 1, 1)
			        )
			        || (
			            ISBLANK(_work_start)
			            && _ZCC_Estado_Evolutivo <> "Cerrado"
			        )
			        || (
			            _work_end <= _Current_EOM
			            && _work_end > DATE(2019, 1, 1)
			        )
			        || (
			            ISBLANK(_work_end)
			            && _ZCC_Estado_Evolutivo = "Cerrado"
			        )
			        && _ZCC_Proyecto_Evol = "Evolutivo",
			        1,
			        0
			    )
			
			RETURN
			    _Contado
			```
		formatString: 0
		lineageTag: 117e6d18-90a5-49e9-b1ec-da4a500b0c82
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

