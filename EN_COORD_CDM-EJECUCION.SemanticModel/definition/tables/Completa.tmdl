	column ZCC_KPIPrincipal_Proyectos_Duracion_DemandavsEjecucion = ```
			
			IF(
			    NOT(ISBLANK('Completa'[ZCC_ Estimado inicio demanda])) && 
			    NOT(ISBLANK('Completa'[ZCC_ Estimado fin demanda])) && 
			    NOT(ISBLANK('Completa'[ZCC_Duracion_linea_base_inicial])),
			    DATEDIFF('Completa'[ZCC_ Estimado inicio demanda], 'Completa'[ZCC_ Estimado fin demanda], DAY) - 'Completa'[ZCC_Duracion_linea_base_inicial],
			    BLANK()
			)
			```
		lineageTag: 082db35b-10c1-4882-b3e0-ba38ee441199
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column ZCC_KPIPrincipal_Proyectos_%_Duracion_DemandavsEjecucion = ```
			
			IF(
			    NOT(ISBLANK(Completa[ZCC_Duracion_linea_base_inicial])) && 
			    NOT(ISBLANK(Completa[ZCC_KPIDuracion_Demanda_Proyecto]))  &&
			    Completa[ZCC_Duracion_linea_base_inicial] <> 0 &&
			    Completa[ZCC_KPIDuracion_Demanda_Proyecto] <> 0,
			    ((Completa[ZCC_Duracion_linea_base_inicial] - Completa[ZCC_KPIDuracion_Demanda_Proyecto]) / Completa[ZCC_KPIDuracion_Demanda_Proyecto]),
			    BLANK()
			)
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 2014ddd0-cb94-474d-9f04-c7388e0cdb53
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column ZCC_KPIPrincipal_Evolutivos_Duracion_DemandavsEjecucion = ```
			
			IF(
			    NOT(ISBLANK('Completa'[ZCC_ Estimado inicio demanda])) && 
			    NOT(ISBLANK('Completa'[ZCC_ Estimado fin demanda])) && 
			    NOT(ISBLANK('Completa'[ZCC_Duracion_del_proyecto_Planificada])),
			    DATEDIFF('Completa'[ZCC_ Estimado inicio demanda], 'Completa'[ZCC_ Estimado fin demanda], DAY) - 'Completa'[ZCC_Duracion_del_proyecto_Planificada],
			    BLANK()
			)
			```
		lineageTag: 58f96bbe-7abb-4f10-b1da-946e6248f7d1
