	measure ZMD_Diferencia_Costes = ```
			
			VAR EvolutivoCost = SUM('Completa'[cost])
			VAR DemandaCost = SUM('Demandas'[total_costs])
			RETURN
			IF(
			ISBLANK(EvolutivoCost) || (EvolutivoCost)= 0 || (DemandaCost)= 0 || ISBLANK(DemandaCost),
			    BLANK(),
			    EvolutivoCost - DemandaCost
			)
			
			```
		lineageTag: 11e6c48a-cb16-4403-8855-4b5e46bebe81

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure ZMD_Diferencia_Costes_% = ```
			
			VAR EvolutivoCost = SUM('Completa'[cost])
			VAR DemandaCost = SUM('Demandas'[total_costs])
			RETURN
			IF(
			    ISBLANK(EvolutivoCost) || (EvolutivoCost)= 0 || (DemandaCost)= 0 || ISBLANK(DemandaCost),
			    BLANK(),
			    (EvolutivoCost / DemandaCost) -1
			)
			
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 54483775-1d43-409e-bf0f-7825f26c1e7e

