	measure AA_Backlog_Evolutivo_Mensualacumulado = ```
			
			VAR _Current_EOM = EOMONTH(MAX(CalendarTable[Date]), 0)
			VAR _Past_EOM = EOMONTH(MAX(CalendarTable[Date]), -1)
			 
			VAR _tareasAbiertas =
			    CALCULATE(
			        COUNT('completa'[number]),
			        (
			            --'completa'[opened_at] <= _Current_EOM
			            --&& 'completa'[opened_at] > DATE(2019, 1, 1)
			            'completa'[opened_at] <= DATE(2023, 12, 31)
			            && 'completa'[opened_at] > DATE(2019, 1, 1)  
			            ),
			        'completa'[ZCC_Proyecto- Evol] = "Evolutivo"
			    )
			VAR _tareasAbiertas2 =
			    CALCULATE(
			        COUNT('completa'[number]),
			        (
			            --'completa'[opened_at] <= _Current_EOM
			            --&& 'completa'[opened_at] > DATE(2019, 1, 1)  
			            'completa'[opened_at] <= DATE(2023, 12, 31)
			            && 'completa'[opened_at] > DATE(2019, 1, 1)  
			            ),
			        'Completa'[ZCC_Elemento_Activo] = "Abierto",
			        ('Completa'[ZCC_Estado_Demanda] = "Completed" || 'Completa'[ZCC_Estado_Demanda] = "Rejected" || 'Completa'[ZCC_Estado_Demanda] = "Canceled"),
			        'completa'[ZCC_Proyecto- Evol] = "Evolutivo"
			    )
			 
			VAR _tareasCerradas =
			    CALCULATE(
			        COUNT('completa'[number]),
			        (
			            --'Completa'[ZCC_GraficaBacklog_New_Closed_at] <= _Current_EOM
			            'Completa'[ZCC_GraficaBacklog_New_Closed_at] <= DATE(2023, 12, 31)
			            && 'completa'[ZCC_GraficaBacklog_New_Closed_at] > DATE(2019, 1, 1)
			        )
			        ,
			        'completa'[ZCC_Proyecto- Evol] = "Evolutivo" 
			    )
			 
			RETURN
			    (_tareasAbiertas - _tareasAbiertas2) - _tareasCerradas
			
			```
		formatString: 0
		lineageTag: 89f55ddb-3109-444b-95b8-a7b9143ba1eb

