	measure Filtro_Visual = ```
			
			VAR PeriodoSeleccionado = SELECTEDVALUE('TablaPeriodo'[Periodo])
			RETURN
			IF(
			    PeriodoSeleccionado = "Última Semana" && 'Completa'[ZMD_KPI_Evolutivo_CerradosUltimos7Dias] = 1,
			    1,
			    IF(
			        PeriodoSeleccionado = "Último Mes" && 'Completa'[ZMD_KPI_Evolutivo_CerradosUltimos30Dias] = 1,
			        1,
			        BLANK()
			    )
			)
			
			```
		formatString: 0
		lineageTag: 747d2dde-7057-4744-82b9-dfec07bde5f8

	measure ZMD_KPI_Evolutivo_euros_Termina_Semana_Actual =
			
			VAR FechaActual = TODAY()
			VAR SemanaActual = WEEKNUM(FechaActual, 2)  // El segundo parámetro indica que la semana comienza en lunes
			VAR AnoActual = YEAR(FechaActual)
			RETURN
			SUMX(
			    FILTER(
			        'Completa',
			        WEEKNUM('Completa'[schedule_end_date], 2) = SemanaActual &&
			        YEAR('Completa'[schedule_end_date]) = AnoActual
			    ),
			    'Completa'[cost]
			)
		lineageTag: 1e179290-823e-4f7a-b7d9-03000fa6da26

		annotation PBI_FormatHint = {"isGeneralNumber":true}

