	measure ZMD_KPIPrincipal_Proyectos_Duracion_Ejecucion = ```
			
			IF(
			    NOT(ISBLANK('Completa'[ZMD_Suma_Duracion_del_proyecto_Real_Suma])) && 
			    NOT(ISBLANK('Completa'[ZMD_Suma_Duracion_del_proyecto_Planificada_Suma])),
			    ('Completa'[ZMD_Suma_Duracion_del_proyecto_Real_Suma] - 'Completa'[ZMD_Suma_Duracion_del_proyecto_Planificada_Suma]) /
			    CALCULATE(
			        COUNTROWS('Completa'),
			        FILTER(
			            'Completa',
			            NOT(ISBLANK(Completa[schedule_start_date])) &&
			            NOT(ISBLANK(Completa[schedule_end_date])) &&
			            Completa[schedule_start_date] <> 0 &&
			            Completa[schedule_end_date] <> 0 &&
			            NOT(ISBLANK(Completa[work_start_delDatalake])) &&
			            NOT(ISBLANK(Completa[work_end_delDatalake])) &&
			            Completa[work_start_delDatalake] <> 0 &&
			            Completa[work_end_delDatalake] <> 0
			        )
			    ),
