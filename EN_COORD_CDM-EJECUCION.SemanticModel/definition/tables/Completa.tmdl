	column ZCC_KPIPrincipal_Inicio_Retrasado = ```
			
			IF(
			    NOT ISBLANK('Completa'[schedule_start_date]), 
			    IF(
			        NOT ISBLANK('Completa'[work_start]), 
			        DATEDIFF('Completa'[schedule_start_date], 'Completa'[work_start], DAY),
			        IF(
			            'Completa'[schedule_start_date] < TODAY(),
			            DATEDIFF('Completa'[schedule_start_date], TODAY(), DAY),
			            BLANK()
			        )
			    )
			)
			```
		formatString: 0
		lineageTag: 24ac46ad-014d-4117-9495-d0e42788b274
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column ZCC_Duracion_del_proyecto_Planificada = ```
			
			IF(
			    NOT(ISBLANK('Completa'[schedule_start_date])) && 
			    NOT(ISBLANK('Completa'[schedule_end_date])) &&
			    'Completa'[schedule_start_date] <> 0 &&
			    'Completa'[schedule_end_date] <> 0,
			    DATEDIFF('Completa'[schedule_start_date], 'Completa'[schedule_end_date], DAY),
			    BLANK()
			)
			
			```
		formatString: 0
		lineageTag: 8d4ca1e8-578b-4f9f-8744-02bf10516a7d
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column ZCC_KPIPrincipal_%_Inicio_Retrasado = ```
			
			
			    IF(
			
			        Completa[ZCC_KPIPrincipal_Inicio_Retrasado]=0 || Completa[ZCC_Duracion_del_proyecto_Planificada]= 0,
			
			        BLANK(),
			
			        (('Completa'[ZCC_KPIPrincipal_Inicio_Retrasado] / Completa[ZCC_Duracion_del_proyecto_Planificada]))
			    )
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: a8ef1409-7238-4643-b977-e9c66ac902bc
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column ZCC_KPIPrincipal_Fin_Retrasado = ```
			
			
				IF(	
			
				not isblank(('Completa'[schedule_end_date])), 
			
			   IF(
			
			       NOT ISBLANK('Completa'[work_end]),
			
			       DATEDIFF('Completa'[schedule_end_date],'Completa'[work_end], DAY),
			
			        IF(
			
			            'Completa'[schedule_end_date] < TODAY(),
			
			            TODAY() - 'Completa'[schedule_end_date], 
			
			        BLANK()
			
			   )))
			
			```
		lineageTag: b7ceb61b-7954-45f9-b9c8-0efb8b1c0bf4
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column ZCC_KPIPRINCIPAL_%_Fin_Retrasado = ```
			
			    DIVIDE(
			        'Completa'[ZCC_KPIPrincipal_Fin_Retrasado],
			        DATEDIFF('Completa'[schedule_start_date], 'Completa'[schedule_end_date], DAY),
			        BLANK()
			    ) 
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 102d4c80-997d-40ec-8a49-1939f89ed9ce
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column ZCC_Duracion_linea_base_inicial = ```
			
			IF(
			    NOT(ISBLANK('Completa'[ZCC_línea_base_finish])) && 
			    NOT(ISBLANK('Completa'[ZCC_línea_base_start])), 
			    IF(
			        'Completa'[ZCC_línea_base_finish] = 'Completa'[ZCC_línea_base_start], 
			        BLANK(), 
			        'Completa'[ZCC_línea_base_finish] - 'Completa'[ZCC_línea_base_start]
			    ), 
			    BLANK()
			)
			
			```
		dataType: double
