	column ZCC_KPIDuracion_Ejecucion_Real_ProyectoMODIFICADAEVOLUTIVO = ```
			
			IF(
			    NOT(ISBLANK('Completa'[work_end])) && 
			    NOT(ISBLANK('Completa'[work_start])) &&
			    ('Completa'[work_end] > 'Completa'[work_start]),
			    NETWORKDAYS('Completa'[work_start], 'Completa'[work_end]),
			    IF(
			        ISBLANK('Completa'[work_end]) && 
			        NOT(ISBLANK('Completa'[ZCC_KPIDuracion_Ejecucion_Planificado_Proyecto])) &&
			        'Completa'[ZCC_KPIDuracion_Ejecucion_Planificado_Proyecto] <> 0,
			        'Completa'[ZCC_KPIDuracion_Ejecucion_Planificado_Proyecto], 	
			        BLANK()
			    )
			)
			```
		lineageTag: a6487aa2-bf4d-4d9e-a6ec-87678686ced2
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Proyecto_Contado_Backlog = ```
			
			VAR _Current_EOM = EOMONTH(TODAY(), 0)
			VAR _Past_EOM = EOMONTH(TODAY(), -1)
			 
			RETURN
			    IF(
			        'completa'[opened_at] <= _Current_EOM
			&& 'completa'[opened_at] > DATE(2019, 1, 1)
			&& (
			            ISBLANK('completa'[ZCC_GraficaBacklog_New_Closed_at])
			            || 'completa'[ZCC_GraficaBacklog_New_Closed_at] > _Current_EOM
			        )
			&& 'completa'[ZCC_Proyecto- Evol] = "Proyecto",
			        "Contado",
			        "No Contado"
			    )
			```
		lineageTag: 44cb35da-908e-4169-9c98-8c117de69196
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column ZCC_Demanda = ```
			RELATED(Demandas[number]) 
			```
		lineageTag: d3dc88e4-8e18-477b-9082-28fcf55de3b0
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column ZCC_TotalDuracionDeman = ```
			
			 VAR _DemanActual = Completa[ZCC_Demanda]
			 RETURN
			SUMX(
			    FILTER(Completa, Completa[ZCC_Demanda] = _DemanActual),
			    Completa[ZMD_KPIDuracion_Ejecucion_Planificado_Proyecto]
			)
			```
		lineageTag: f7c52e05-3a0a-449f-8c1a-73afcb80672a
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column ZCC_Tamaño = RELATED(Demandas[ZCC_Tamaño])
		lineageTag: 98659b35-2375-4811-87d5-58cd99c7b484
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column ZCC_MargenAñadido =
			
			SWITCH(Completa[ZCC_Tamaño],
			-- se calcula el 200% del max estipulado de la talla (X = 0-40h), se divide entre 8, y se suma el 80% de 1/8 parte a la duración total de la demanda
			"XS", Completa[ZCC_TotalDuracionDeman] + 8,
			-- se calcula el 150% del max estipulado de la talla (S = 40-750h), se divide entre 8, y se suma el 70% de 1/8 parte a la duración total de la demanda
			-- "S", Completa[ZCC_TotalDuracionDeman]+98,
			"S", Completa[ZCC_TotalDuracionDeman] + (((Completa[ZCC_TotalDuracionDeman]*40)/750)*2),
			-- se calcula el 100% del max estipulado de la talla (M = 750-1500h), se divide entre 8, y se suma el 60% de 1/8 parte a la duración total de la demanda
			-- "M", Completa[ZCC_TotalDuracionDeman]+113,
			"M", Completa[ZCC_TotalDuracionDeman] + (((Completa[ZCC_TotalDuracionDeman]/4)*750)/1500),
			 BLANK())
		lineageTag: 9df83b4c-0afc-4a10-af86-903607e502b9
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column ZCC_FechaTope =
			
			CALCULATE(SUM(Completa[ZCC_MargenAñadido])) + Completa[work_start].[Date]
		formatString: Short Date
		lineageTag: e4625bd3-5335-441c-8968-a3c133bea029
		summarizeBy: none

		variation Variación
			isDefault
			relationship: 7d2cf83d-6b78-4aad-b15d-94706a34cd8c
			defaultHierarchy: LocalDateTable_652882da-d5e2-4f6c-9305-9941d903e6f9.'Jerarquía de fechas'

		annotation SummarizationSetBy = Automatic

	column ZCC_KPI_Excede_Margen =
			
			IF(Completa[ZCC_Tamaño] = "", "N",
			IF(TODAY() > Completa[ZCC_FechaTope].[Date], "S", "N"))
		lineageTag: a17baa40-a653-4aad-adc3-2a816c69893f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column ZCC_Estado_Demanda = ```
