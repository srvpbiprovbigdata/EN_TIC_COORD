			    NOT(ISBLANK('Completa'[ZMD_Suma_Diferencia_Estimado_fin_inicio_demanda])) && 
			    NOT(ISBLANK('Completa'[ZMD_Suma_Duracion_linea_base_inicial])),
			    ('Completa'[ZMD_Suma_Diferencia_Estimado_fin_inicio_demanda] - 'Completa'[ZMD_Suma_Duracion_linea_base_inicial]) /
