	column ZCC_ColumnaRepetidos =
			
			VAR CurrentValue = Completa[ZCC_Dv_top_task proyectos]
			VAR CountOccurrences =
			    CALCULATE(
			        COUNTROWS(Completa),
			        FILTER(Completa, Completa[ZCC_Dv_top_task proyectos] = CurrentValue)
			    )
			RETURN
			IF(CountOccurrences > 1, "Repetido", "Único")
