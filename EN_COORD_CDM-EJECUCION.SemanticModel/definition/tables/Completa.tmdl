	measure ZMD_KPI_Evolutivo_Que_Terminan_En_7_Días =
			
			VAR FechaActual = TODAY()
			VAR FechaLimite = FechaActual + 7
			RETURN
			CALCULATE(
			    COUNTROWS('Completa'),
			    'Completa'[schedule_end_date] >= FechaActual,
			    'Completa'[schedule_end_date] <= FechaLimite
			)
		formatString: 0
		lineageTag: 90816b4e-b904-47fc-bd99-c92c5c23ce4e

	measure ZMD_KPI_Evolutivo_Que_Terminan_En_30_Días =
			
