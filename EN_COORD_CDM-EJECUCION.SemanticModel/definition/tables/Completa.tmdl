		lineageTag: 9ded6e4d-b60f-489d-8491-1c50d144d763
		summarizeBy: none
		sourceColumn: UnionConDemanda

		annotation SummarizationSetBy = Automatic

	column ZCC_Estado_Evolutivo = ```
			
			SWITCH(
			    TRUE(),
			    LEFT('Completa'[Number], 7) = "PRJTASK" && 'Completa'[dv_state] = "Open", "Iniciacion",
			    LEFT('Completa'[Number], 7) = "PRJTASK" && 'Completa'[dv_state] = "Pending", "Planificacion",
			    LEFT('Completa'[Number], 7) = "PRJTASK" && ('Completa'[dv_state] = "Work in Progress" || 'Completa'[dv_state] = "Deploy/Launch" || 'Completa'[dv_state] = "In Development" || 'Completa'[dv_state] = "Testing/QA" || 'Completa'[dv_state] = "In Analysis"), "Ejecucion",
			    LEFT('Completa'[Number], 7) = "PRJTASK" && ('Completa'[dv_state] = "Closed Complete" || 'Completa'[dv_state] = "Closed Incomplete" || 'Completa'[dv_state] = "Closed Skipped"), "Cerrado",
			    
			    LEFT('Completa'[Number], 4) = "ENHC" && 'Completa'[dv_state] = "Draft", "Planificacion",
			    LEFT('Completa'[Number], 4) = "ENHC" && ('Completa'[dv_state] = "Deploy/Launch" || 'Completa'[dv_state] = "In Development" || 'Completa'[dv_state] = "Testing/QA" || 'Completa'[dv_state] = "In Analysis"), "Ejecucion",
			    LEFT('Completa'[Number], 4) = "ENHC" && ('Completa'[dv_state] = "Closed Complete" || 'Completa'[dv_state] = "Cancelled"), "Cerrado",
			    LEFT('Completa'[Number], 4) = "ENHC" && 'Completa'[dv_state] = "On Hold", "Pausados",
			    
			    LEFT('Completa'[Number], 3) = "PRJ" && 'Completa'[dv_phase] = "Planning", "Planificacion",
			    LEFT('Completa'[Number], 3) = "PRJ" && 'Completa'[dv_phase] = "Initiating", "Iniciacion",
			    LEFT('Completa'[Number], 3) = "PRJ" && 'Completa'[dv_phase] = "Executing", "Ejecucion",
			    LEFT('Completa'[Number], 3) = "PRJ" && 'Completa'[dv_phase] = "In Pause", "Pausados",
			    LEFT('Completa'[Number], 3) = "PRJ" && 'Completa'[dv_phase] = "Closing",
			        IF(
			            'Completa'[dv_state] <> "Closed Complete" && 
			            'Completa'[dv_state] <> "Closed Incomplete" && 
			            'Completa'[dv_state] <> "Closed Skipped", 
			            "Cierre", 
			            "Cerrado"
			        ),
			    BLANK()
			)
			
			```
		lineageTag: 8c4058cd-81df-4583-9286-93ee83b1b6dd
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column ZCC_línea_base_start = ```
			
			CALCULATE(
			    MIN('SERV_NOW_EN V_u_project_baseline'[prj_schedule_start_date]),
			    FILTER(
			        RELATEDTABLE('SERV_NOW_EN V_u_project_baseline'),
			        'SERV_NOW_EN V_u_project_baseline'[item_sys_created_on] = 
			        CALCULATE(
			            MIN('SERV_NOW_EN V_u_project_baseline'[item_sys_created_on]),
			            RELATEDTABLE('SERV_NOW_EN V_u_project_baseline')
			        )
			    )
			)
			
