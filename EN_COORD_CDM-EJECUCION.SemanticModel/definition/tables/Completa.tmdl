	measure ZMD_Suma_Diferencia_Estimado_fin_inicio_demanda =
			
			SUMX(
			    FILTER(
			        Completa,
			        NOT(ISBLANK(Completa[ZCC_ Estimado inicio demanda])) &&
			        NOT(ISBLANK(Completa[ZCC_ Estimado fin demanda]))
			    ),
			    DATEDIFF(
			        Completa[ZCC_ Estimado inicio demanda],
			        Completa[ZCC_ Estimado fin demanda],
			        DAY
			    )
			)
		formatString: 0
		lineageTag: 8a6e5822-2c3c-4837-8006-e38e3a243270

	measure ZMD_Suma_Duracion_del_proyecto_Planificada_Suma =
			
			SUMX(
			    FILTER(
			        Completa,
			        NOT(ISBLANK(Completa[schedule_start_date])) &&
			        NOT(ISBLANK(Completa[schedule_end_date])) &&
			        Completa[schedule_start_date] <> 0 &&
			        Completa[schedule_end_date] <> 0
			    ),
			    DATEDIFF(
			        Completa[schedule_start_date],
			        Completa[schedule_end_date],
			        DAY
			    )
			)
		formatString: 0
		lineageTag: 9b9e1b04-0f8e-42f4-8dda-1b6d6d7cbbf3

