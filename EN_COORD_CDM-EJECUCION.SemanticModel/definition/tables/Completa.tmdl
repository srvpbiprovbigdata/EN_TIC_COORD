	column ZCC_Tipo = ```
			
			IF (
			    LEFT('Completa'[number], 4) = "ENHC", 
			    "mejora", 
			    IF (
			        'Completa'[ZCC_Proyecto- Evol] = "Evolutivo", 
			        IF (
			            LEFT('Completa'[number], 7) = "prjtask", 
			                "evolutivo",  
			            IF (
			                LEFT('Completa'[number], 3) = "prj", 
			            "proyecto evolutivo",
			                "proyecto"
			            )
			        ), 
