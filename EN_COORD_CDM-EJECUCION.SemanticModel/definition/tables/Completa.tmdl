		annotation SummarizationSetBy = Automatic

	column 'ZCC_Proyecto- Evol' = if(Completa[u_project_type]= "Project","Proyecto","Evolutivo")
		lineageTag: 55e289f4-848c-49ca-84de-81795014358c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column ZCC_KPI_Evolutivo_No_Iniciado = ```
			
			IF(
			    NOT ISBLANK('Completa'[work_start]),
			    DATEDIFF('Completa'[schedule_start_date], 'Completa'[work_start], DAY),
			    IF(
			        (
			--            ('Evolutivo'[dv_state] = "Open" || 
			--             'Evolutivo'[dv_state] = "Pending" || 
			--             'Evolutivo'[dv_state] = "Work in Progress"
			--            ) &&
			            'Completa'[schedule_start_date] < TODAY()
			        ),
			        DATEDIFF('Completa'[schedule_start_date], TODAY(), DAY),
			        BLANK()  
			    )
			)
			
			```
		formatString: 0
		lineageTag: 62ae420f-fec7-4aa1-b0ec-1b4e40a5fc15
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column ZCC_KPI_%_Evolutivo_No_Iniciad = ```
			
			    IF(
			        DATEDIFF('Completa'[schedule_start_date], 'Completa'[schedule_end_date], DAY) = 0,
			        BLANK(),
			        (('Completa'[ZCC_KPI_Evolutivo_No_Iniciado] / DATEDIFF('Completa'[schedule_start_date], 'Completa'[schedule_end_date], DAY))-1)*100 
			    )
			```
		lineageTag: cdc84f28-35c1-408c-82d3-b46444020118
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column ZCC_KPI_Evolutivo_Retrasado_Fin_Planificacion = ```
			
			IF(
			    NOT ISBLANK('Completa'[work_end]) && NOT ISBLANK('Completa'[schedule_end_date]),
			    DATEDIFF('Completa'[schedule_end_date], 'Completa'[work_end], DAY),
			    IF(
			        NOT ISBLANK('Completa'[schedule_end_date]) && 'Completa'[schedule_end_date] < TODAY(),
			        DATEDIFF('Completa'[schedule_end_date], TODAY(), DAY),
			        BLANK()
			    )
			)
			
			```
		dataType: int64
		formatString: 0
		lineageTag: c371c2b7-8340-4ebf-b105-d3dbfe9a24ed
		summarizeBy: sum

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

	column ZCC_KPI_%_Evolutivo_Retrasado_Fin_Planificacion = ```
			
			    DIVIDE(
			        'Completa'[ZCC_KPI_Evolutivo_Retrasado_Fin_Planificacion],
			        (DATEDIFF('Completa'[schedule_start_date], 'Completa'[schedule_end_date], DAY)-1) * 100,
			        BLANK()
			    )
			```
		lineageTag: fb753a29-a839-434d-a69d-4261e773ac02
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column ZCC_KPI_Evolutivo_Duracion_Ejecucion =
			
			IF(
			    NOT(ISBLANK('Completa'[work_start])) && NOT(ISBLANK('Completa'[work_end])) &&
			    NOT(ISBLANK('Completa'[schedule_start_date])) && NOT(ISBLANK('Completa'[schedule_end_date])),
			    DATEDIFF('Completa'[work_start], 'Completa'[work_end], DAY) - DATEDIFF('Completa'[schedule_start_date], 'Completa'[schedule_end_date], DAY),
			    BLANK()
			)
		formatString: 0
		lineageTag: 18a548fa-302f-4fca-8b6f-cb8d4bbd7cf4
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column ZCC_KPI_%_Evolutivo_Duracion_Ejecucion =
			
			IF(
			    NOT(ISBLANK('Completa'[work_start])) && NOT(ISBLANK('Completa'[work_end])) &&
			    NOT(ISBLANK('Completa'[schedule_start_date])) && NOT(ISBLANK('Completa'[schedule_end_date])) &&
			    DATEDIFF('Completa'[schedule_start_date], 'Completa'[schedule_end_date], DAY) <> 0,
			    ((DATEDIFF('Completa'[work_start], 'Completa'[work_end], DAY) / DATEDIFF('Completa'[schedule_start_date], 'Completa'[schedule_end_date], DAY)) ),
			    BLANK()
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: f6e9c750-9ddb-4575-b54b-9e71ed88657a
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column ZCC_Elemento_Activo = ```
			
			IF(
			    Completa[ZCC_Estado_Evolutivo] = "Cerrado", 
			    "Cerrado", 
			    "Abierto"
			)
			```
		lineageTag: 6d6410ae-1143-4650-bce1-de0dece9f950
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column zcc_indice_status = if('Completa'[dv_status]="Green", "3 - Green",if('Completa'[dv_status]="Red", "1 - Red", if('Completa'[dv_status]="Yellow" , "2 - Yellow")))
		lineageTag: 1c5d77de-a7fd-4044-a90f-8eabcee74368
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column UnionConDemanda
