	column ZCC_porcentaje_avance_actual =
			
			IF(
			    'Completa'[dv_state] = "Cerrado",
			    100,
			    IF(
			        NOT(ISBLANK('Completa'[start_date])) && NOT(ISBLANK('Completa'[end_date])),
			        MAX(
			            0,
			            MIN(
			                (DATEDIFF('Completa'[start_date], TODAY(), DAY) / DATEDIFF('Completa'[start_date], 'Completa'[end_date], DAY)) * 100,
			                100
			            )
			        ),
			        BLANK()
			    )
			)
		formatString: 0
		lineageTag: 320fffc5-9a82-49d6-ada3-05b559688380
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

