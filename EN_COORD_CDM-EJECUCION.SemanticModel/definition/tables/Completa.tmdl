		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column ZCC_KPIPrincipal_Evolutivos_%_Duracion_DemandavsEjecucion = ```
			
			IF(
			    NOT(ISBLANK('Completa'[ZCC_ Estimado fin demanda])) && 
			    NOT(ISBLANK('Completa'[ZCC_ Estimado inicio demanda])) && 
			    NOT(ISBLANK('Completa'[ZCC_Duracion_del_proyecto_Planificada])) && 
			    'Completa'[ZCC_Duracion_del_proyecto_Planificada] <> 0,
			    ((DATEDIFF('Completa'[ZCC_ Estimado inicio demanda], 'Completa'[ZCC_ Estimado fin demanda], DAY) / 'Completa'[ZCC_Duracion_del_proyecto_Planificada]))-1,
			    BLANK()
			)
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
