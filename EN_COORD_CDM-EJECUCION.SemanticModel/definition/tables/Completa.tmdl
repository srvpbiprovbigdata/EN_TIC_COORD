			        'Días Alertas por Fase'[Días],
			        'Días Alertas por Fase'[Estado],
			        'Completa'[ZCC_Estado_Evolutivo_Ordenado]
			    )
			RETURN
			    IF(
			        ISBLANK(Umbral),
			        BLANK(),
			        IF(
			            NOT ISBLANK('Completa'[ZCC_DiasDesdeUltimoEstado_ProyEvoAbiertos]) && 
			            'Completa'[ZCC_DiasDesdeUltimoEstado_ProyEvoAbiertos] > Umbral,
