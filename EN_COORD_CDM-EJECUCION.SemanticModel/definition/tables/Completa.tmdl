	measure GraficaBacklogElementosAbiertos = ```
			
			VAR _Current_EOM = EOMONTH(MAX(CalendarTable[Date]), 0)
			VAR _Past_EOM = EOMONTH(MAX(CalendarTable[Date]), -1)
			 
			VAR _abiertas =
			    CALCULATE(
			        COUNT('Completa'[number]),
			        'Completa'[work_start_delDatalake] <= _Current_EOM,
			        'Completa'[work_start_delDatalake] > _Past_EOM
			    )
			 
			RETURN
			    _abiertas
			```
		formatString: 0
		lineageTag: e56bd456-32ba-4318-8569-c6d6e096c7fc

	measure GraficaBacklogElementosCerradas = ```
			
			VAR _Current_EOM = EOMONTH(MAX(CalendarTable[Date]), 0)
			VAR _Past_EOM = EOMONTH(MAX(CalendarTable[Date]), -1)
			 
			VAR _abiertas =
			    CALCULATE(
			        COUNT('Completa'[number]),
			        'Completa'[work_end] <= _Current_EOM,
			        'Completa'[work_end] > _Past_EOM
			    )
			 
			RETURN
			   - _abiertas
			```
		formatString: 0
		lineageTag: 47fd723e-88fe-45c9-b7b3-97d98a909770

	measure ZMD_KPI_Evolutivo_Termina_Semana_Actual =
			
			VAR FechaActual = TODAY()
			VAR SemanaActual = WEEKNUM(FechaActual, 2)  // El segundo parámetro indica que la semana comienza en lunes
			VAR AnoActual = YEAR(FechaActual)
			RETURN
			CALCULATE(
			    COUNTROWS('Completa'),
			    WEEKNUM('Completa'[schedule_end_date], 2) = SemanaActual,
			    YEAR('Completa'[schedule_end_date]) = AnoActual
			)
		formatString: 0
		lineageTag: 4f4fc236-45b3-437b-9ec8-a2345c5a614d

