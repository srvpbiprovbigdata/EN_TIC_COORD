	column ZCC_Proyecto_Producto_Riesgo_Probabilidad_Impacto = ```
			
			IF(
			    ISBLANK('SERV_NOW_EN V_u_project_risks'[dv_risk_probability]) || 
			    ISBLANK('SERV_NOW_EN V_u_project_risks'[dv_prj_score_risk]) || 
			    ISBLANK('SERV_NOW_EN V_u_project_risks'[dv_risk_u_impact]),
			    BLANK(),
			    IF(
			        'SERV_NOW_EN V_u_project_risks'[dv_risk_state] = "Closed",
			        0,
			        'SERV_NOW_EN V_u_project_risks'[dv_prj_score_risk] * 
			        SWITCH(
			            'SERV_NOW_EN V_u_project_risks'[dv_risk_probability],
			            "High", 4,
			            "Moderate", 3,
			            "Low", 2,
			            1
			        ) * 
			        SWITCH(
			            'SERV_NOW_EN V_u_project_risks'[dv_risk_u_impact],
			            "High", 4,
			            "Moderate", 3,
			            "Low", 2,
			            1
			        )
			    )
			)
			
			```
		formatString: 0
		lineageTag: a0ec2f49-faa6-4f1a-bcbd-313dd53e5d6f
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column ZCC_Proyecto_Numero_de_Probabilidad = ```
			
			    SWITCH(
			        'SERV_NOW_EN V_u_project_risks'[dv_risk_probability],
			        "High", 3,
			        "Moderate", 2,
			        "Low", 1,
			        0
			    )
			
			```
		formatString: 0
		lineageTag: 7c4cfd59-ffe6-4049-bfc6-5a10ecbe5f7a
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition 'SERV_NOW_EN V_u_project_risks' = m
		mode: import
		source =
				let
				    Origen = Sql.Databases("QECCDWH.ACCIONA.INT:60001"),
				    DWH = Origen{[Name="DWH"]}[Data],
				    SERV_NOW_EN_V_u_project_risks = DWH{[Schema="SERV_NOW_EN",Item="V_u_project_risks"]}[Data]
				in
				    SERV_NOW_EN_V_u_project_risks

	annotation PBI_ResultType = Table

