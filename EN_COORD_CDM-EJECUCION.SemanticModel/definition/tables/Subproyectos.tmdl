table Subproyectos
	lineageTag: 671b7332-4a55-4572-aa0f-97cfa2cec4b9

	measure BacklogMensual = ```
			
			VAR _Current_EOM = EOMONTH(MAX(CalendarTable[Date]), 0)
			VAR _Past_EOM = EOMONTH(MAX(CalendarTable[Date]), -1)
			 
			VAR _tareasAbiertas =
			    CALCULATE(
			        COUNT('Subproyectos'[number]),
			        'Subproyectos'[work_start] <= _Current_EOM,
			        'Subproyectos'[work_start] > _Past_EOM
			    )
			 
			VAR _tareasCerradas =
			    CALCULATE(
			        COUNT('Subproyectos'[number]),
			        'Subproyectos'[work_end] <= _Current_EOM,
			        'Subproyectos'[work_end] > _Past_EOM
			    )
			 
			RETURN
			    _tareasAbiertas - _tareasCerradas
			```
		formatString: 0
		lineageTag: 20f414a5-4d25-4e97-b1c2-127cd7600a95

	measure BacklogMensualacumulado = ```
			
			VAR _Current_EOM = EOMONTH(MAX(CalendarTable[Date]), 0)
			VAR _Past_EOM = EOMONTH(MAX(CalendarTable[Date]), -1)
			 
			VAR _tareasAbiertas =
			    CALCULATE(
			        COUNT('Completa'[number]),
			        'Completa'[work_start_delDatalake] <= _Current_EOM,
			        'Completa'[work_start_delDatalake] > 01/01/2019
			    )
			 
			VAR _tareasCerradas =
			    CALCULATE(
			        COUNT('Completa'[number]),
			        'Completa'[work_end_delDatalake] <= _Current_EOM,
			        'Completa'[work_end_delDatalake] > 01/01/2019
			    )
			 
			RETURN
			    _tareasAbiertas - _tareasCerradas
			```
		formatString: 0
		lineageTag: abc22e39-d72c-41dc-ac7f-93ccae23acf0

