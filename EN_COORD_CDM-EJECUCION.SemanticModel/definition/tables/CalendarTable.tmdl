	partition CalendarTable = calculated
		mode: import
		source = ```
				
				ADDCOLUMNS (
				    CALENDAR (DATE (2019, 1, 1), DATE (YEAR(TODAY()), MONTH(TODAY()), DAY(TODAY()))),
				    "Year", YEAR([Date]),
				    "Month", MONTH([Date]),
				    "Day", DAY([Date]),
				    "MonthYear", FORMAT([Date], "MMM YYYY"),
				    "MonthName", FORMAT([Date], "MMMM")
				)
				
				```

	annotation PBI_Id = 1a554ea8054a43c19571d98e19b3b3c3

