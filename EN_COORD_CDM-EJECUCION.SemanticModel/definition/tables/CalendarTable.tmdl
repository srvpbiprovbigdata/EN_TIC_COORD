table CalendarTable
	lineageTag: 88394c87-e253-4613-ad4b-84958aa130c8

	measure ZMD_%_ALERTAS = 0
		formatString: 0
		lineageTag: ddfb6527-f3f2-405c-a3f2-781350e6db96

	measure ZMD_Proyectos_Que_Comienzan_En_30_Días =
			
			VAR FechaActual = TODAY()
			VAR FechaLimite = FechaActual + 30
			RETURN
			CALCULATE(
			    COUNTROWS('Subproyectos'),
			    'Subproyectos'[schedule_start_date] >= FechaActual,
			    'Subproyectos'[schedule_start_date] <= FechaLimite
			)
		formatString: 0
		lineageTag: 70048d96-a160-4a78-a789-83009cd13578

	measure ZMD_Proyectos_Que_Terminan_En_30_Días =
			
			VAR FechaActual = TODAY()
			VAR FechaLimite = FechaActual + 30
			RETURN
			CALCULATE(
			    COUNTROWS('Subproyectos'),
			    'Subproyectos'[schedule_end_date] >= FechaActual,
			    'Subproyectos'[schedule_end_date] <= FechaLimite
			)
		formatString: 0
		lineageTag: 7d94a6a0-6740-4182-8ac1-3375bf6492a7

	measure ZMD_Proyectos_Actuales_Ajustados = COUNTROWS('Subproyectos')- [ZMD_Proyectos_Que_Terminan_En_30_Días]+[ZMD_Proyectos_Que_Comienzan_En_30_Días]
		formatString: 0
		lineageTag: ba247910-45dd-4f27-ba52-92b4558ae2be

	measure ZMD_Evolutivos_Que_Comienzan_En_30_Días =
			
			VAR FechaActual = TODAY()
			VAR FechaLimite = FechaActual + 30
			RETURN
			CALCULATE(
			    COUNTROWS('Tareas'),
			    'Tareas'[schedule_start_date] >= FechaActual,
			    'Tareas'[schedule_start_date] <= FechaLimite
			)
		formatString: 0
		lineageTag: 9749651a-f647-4cbe-961c-4aa0fe5cc9f3

