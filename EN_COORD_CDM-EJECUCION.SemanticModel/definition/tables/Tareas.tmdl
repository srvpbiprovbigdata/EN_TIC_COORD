table Tareas
	lineageTag: 9a1c1f29-e486-4c8a-ba50-f5d22abff962

	measure ZMD_KPI_EvolutivosAbiertos30a60Dias =
			
			CALCULATE(
			    COUNT('Tareas'[number]),
			    FILTER(
			        'Tareas',
			        'Tareas'[work_start] >= TODAY() - 60 &&
			        'Tareas'[work_start] < TODAY() - 30
			    )
			)
		formatString: 0
		lineageTag: c07617bf-71b2-43e6-bf92-22340f6c76cb

	measure ZMD_KPI_EvolutivosAbiertosUltimos30Dias =
			
			CALCULATE(
			    COUNT('Tareas'[number]),
			    FILTER(
			        'Tareas',
			        'Tareas'[work_start] >= TODAY() - 30 &&
			        'Tareas'[work_start] <= TODAY()
			    )
			)
		formatString: 0
		lineageTag: 5f8f4522-028a-48c5-925c-704d32b88ead

	measure ZMD_KPI_EvolutivosCerradosUltimos30Dias =
			
			CALCULATE(
			    COUNT('Tareas'[number]),
			    FILTER(
			        'Tareas',
			        'Tareas'[work_end] >= TODAY() - 30 &&
			        'Tareas'[work_end] <= TODAY()
			    )
			)
		formatString: 0
		lineageTag: 3eaabb5a-cb93-4f7b-81bc-885b78b456ff

	measure ZMD_KPI_EvolutivosCerrados30a60Dias =
			
			CALCULATE(
			    COUNT('Tareas'[number]),
			    FILTER(
			        'Tareas',
			        'Tareas'[work_end] >= TODAY() - 60 &&
