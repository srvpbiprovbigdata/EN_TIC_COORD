	column ZCC_%_Evolutivos_Desviacionconporcentaje_completado = ```
			IF( 
			        ISBLANK('Tareas'[work_start]) || 'Tareas'[ZCC_Evolutivos_Desviacionconporcentaje_completado]=0 || 'Tareas'[ZCC_Duracion_del_Evolutivo_que_deberia_tener_segun_porcentaje_completado]=0,
