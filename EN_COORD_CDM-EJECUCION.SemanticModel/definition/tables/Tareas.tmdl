		lineageTag: 3d50a835-d5dd-4c79-9db2-d858695357d0
		summarizeBy: none
		sourceColumn: work_start

		variation Variación
			isDefault
			relationship: 27a3b681-f06b-4239-af10-348a2f05143f
			defaultHierarchy: LocalDateTable_f94bb52a-5d32-4226-b73b-82ad37b202b2.'Jerarquía de fechas'

