	column ZCC_Evolutivos_Alerta_Desviacionconporcentajecompletado = ```
			
			    IF(
			        'Tareas'[ZCC_%_Evolutivos_Desviacionconporcentaje_completado] > 50,
			        "Rojo",
			        IF(
			            'Tareas'[ZCC_%_Evolutivos_Desviacionconporcentaje_completado] > 20,
			            "Naranja",
			            IF(
			                'Tareas'[ZCC_%_Evolutivos_Desviacionconporcentaje_completado] > 0,
			                "Amarillo",
			                IF(
			                ISBLANK('Tareas'[ZCC_%_Evolutivos_Desviacionconporcentaje_completado]),
			                BLANK(),
			                    IF(
			                'Tareas'[ZCC_%_Evolutivos_Desviacionconporcentaje_completado] < 0,
			                "Verde",
			                BLANK() 
			            )
			        )
			    )))
