		lineageTag: 84c6a91c-f8bb-485a-ad49-55927a0770cf

	measure Total_Evolutivos_Mejoras_Proyectos =
			
			COUNTROWS('Subproyectos') +
			COUNTROWS('Tareas') +
			COUNTROWS('SERV_NOW_EN V_rm_enhancement Enlazado_a_Completa')
		formatString: 0
