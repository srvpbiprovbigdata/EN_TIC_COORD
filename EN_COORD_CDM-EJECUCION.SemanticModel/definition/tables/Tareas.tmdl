	column Columna
		type: calculated
		lineageTag: 74daa874-7eac-4e05-a807-133a3ce26349
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column ZCC_Evolutivo_Fin_Planificacion_Retrasado = ```
			
			   IF(
			       NOT ISBLANK('Tareas'[work_end]),
			       DATEDIFF('Tareas'[schedule_end_date],'Tareas'[work_end], DAY),
			        IF(
			            'Tareas'[schedule_end_date] < TODAY(),
			            TODAY() - 'Tareas'[schedule_end_date], 
			        BLANK()
			   ))
			```
		lineageTag: b5cd7e7e-46cc-4320-91e7-828365ea3c9c
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column ZCC_Evolutivo_Retrasado_Duracion_Planificacion = ```
			
			    IF(
			        ISBLANK('Tareas'[work_start]),
			        BLANK(),
			        IF(
			            NOT ISBLANK('Tareas'[work_end]),
			            DATEDIFF('Tareas'[work_start], 'Tareas'[work_end], DAY),
			        DATEDIFF('Tareas'[work_start], TODAY(), DAY)
			    )
			    )  
			```
		formatString: 0
		lineageTag: 4ba69790-6bf4-4f9c-8f3e-cbc3c0f896e3
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column ZCC_Evolutivo_%_Retrasado_Duracion_Planificacion = ```
			
			    IF(
			        ISBLANK('Tareas'[ZCC_Evolutivo_Retrasado_Duracion_Planificacion]),
			        BLANK(),
			   DIVIDE('Tareas'[ZCC_Evolutivo_Retrasado_Duracion_Planificacion],
			   DATEDIFF('Tareas'[schedule_start_date],'Tareas'[schedule_end_date],DAY),
			   0
			   )-1)
			```
		lineageTag: d27ce25b-d7e5-457a-9f2b-85327f8b1b70
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column ZCC_Evolutivo_Alerta_Retrasada_Duracion_Planificacion = ```
			
			    IF(
			        'Tareas'[ZCC_Evolutivo_%_Retrasado_Duracion_Planificacion] > 50,
			        "Rojo",
			        IF(
			            'Tareas'[ZCC_Evolutivo_%_Retrasado_Duracion_Planificacion] > 30,
			            "Naranja",
			            IF(
			                'Tareas'[ZCC_Evolutivo_%_Retrasado_Duracion_Planificacion] > 0,
			                "Amarillo",
			                IF(
			                'Tareas'[ZCC_Evolutivo_%_Retrasado_Duracion_Planificacion] < 0,
			                "Verde",
			                BLANK() 
			            )
			        )
			    ))
			```
		lineageTag: c0c83513-eadc-42d2-9e4f-77f755025b07
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column ZCC_Evolutivo_Variacion_Presupuesto =
			
			IF(
			    'Tareas'[budget_cost] = 0 || 'Tareas'[cost] = 0,
			    BLANK(),
			    ('Tareas'[cost] - 'Tareas'[budget_cost])
			)
		lineageTag: 5625144b-a8e7-42e2-872c-b8ce20a192cd
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column ZCC_%_Evolutivo_Variacion_Presupuesto =
			
			IF(
			    'Tareas'[budget_cost] = 0 || 'Tareas'[cost] = 0,
			    BLANK(),
			    ('Tareas'[cost] / 'Tareas'[budget_cost])-1
			)
		lineageTag: 3aef6478-f6da-49bd-84e3-c885350e089d
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column ZCC_Evolutivo_Alerta_Variacion_Presupuesto = ```
			
			    IF(
			        'Tareas'[ZCC_%_Evolutivo_Variacion_Presupuesto] > 50,
			        "Rojo",
			        IF(
			            'Tareas'[ZCC_%_Evolutivo_Variacion_Presupuesto] > 20,
			            "Naranja",
			            IF(
			                'Tareas'[ZCC_%_Evolutivo_Variacion_Presupuesto] > 0,
			                "Amarillo",
			                IF(
			                ISBLANK('Tareas'[ZCC_%_Evolutivo_Variacion_Presupuesto]),
			                BLANK(),
			                    IF(
			                'Tareas'[ZCC_%_Evolutivo_Variacion_Presupuesto] < 0,
			                "Verde",
			                BLANK() 
			            )
			        )
			    )))
			```
		lineageTag: 817967e1-33c4-4af6-8590-263b8227b029
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column ZCC_Duracion_del_Evolutivo = ```
			
			        DATEDIFF('Tareas'[schedule_start_date], 'Tareas'[schedule_end_date], DAY)
			```
		formatString: 0
		lineageTag: 38a0e3eb-db2e-432d-b122-aaa64d2243e9
		summarizeBy: sum

