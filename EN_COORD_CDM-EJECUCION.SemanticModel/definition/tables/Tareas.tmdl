			)
		formatString: 0
		lineageTag: 72a04d3d-00d2-4096-a573-b41cc3b0c435

	measure ZMD_KPI_EvolutivosCerradosUltimos7Dias =
			
			CALCULATE(
			    COUNT('Tareas'[number]),
			    FILTER(
			        'Tareas',
			        'Tareas'[work_end] >= TODAY() - 7 &&
			        'Tareas'[work_end] <= TODAY()
			    )
			)
		formatString: 0
		lineageTag: 897970e9-ffab-44a6-a4a6-850bcdd2c324

	measure ZMD_Evolutivos_Que_Terminan_En_30_Días =
			
			VAR FechaActual = TODAY()
			VAR FechaLimite = FechaActual + 30
			RETURN
			CALCULATE(
			    COUNTROWS('Tareas'),
			    'Tareas'[schedule_end_date] >= FechaActual,
			    'Tareas'[schedule_end_date] <= FechaLimite
			)
		formatString: 0
		lineageTag: 3cefb3d7-5c39-45bf-bab0-0e6c5bebf4b5

	measure ZMD_Evolutivos_Que_Terminan_En_7_Días =
			
			VAR FechaActual = TODAY()
			VAR FechaLimite = FechaActual + 7
			RETURN
			CALCULATE(
			    COUNTROWS('Tareas'),
			    'Tareas'[schedule_end_date] >= FechaActual,
			    'Tareas'[schedule_end_date] <= FechaLimite
			)
		formatString: 0
		lineageTag: 86c0fe08-22e2-4ba2-9bb2-46ebb490896b

	measure ZMD_Recuento_Evolutivos_FFP_Caducada = ```
			
			CALCULATE(
			    COUNTROWS('Tareas'),
			    FILTER(
			        'Tareas',
			        ISBLANK('Tareas'[work_end]) && 
			        NOT(ISBLANK('Tareas'[schedule_end_date])) && 
			        'Tareas'[schedule_end_date] < TODAY()
			    )
			)
			```
		formatString: 0
		lineageTag: d159a236-e604-4f05-909f-fcceb216e087

