table _backlogTotalGrupos
	lineageTag: 9bafa19e-9c1c-43c4-8e19-227eacff2f0e

	measure AcumuladoTotal =
			
			CALCULATE(
			    Sum(_backlogTotalGrupos[abTotal])+0,
			    FILTER(ALLSELECTED(_backlogTotalGrupos), _backlogTotalGrupos[fecha]<=MAX(_backlogTotalGrupos[fecha]))
			)
		formatString: 0
		lineageTag: 1edba9c6-099b-49d6-93cc-ca0c6740a50e

	measure TotalIncidencias = sum(_backlogTotalGrupos[abTotal])+0
		formatString: 0
		lineageTag: 4bc489c5-1332-4d92-baaf-f7ef51f8104a

	measure _MesActualAbiertas = CALCULATE(SUM(_backlogTotalGrupos[abTotal])+0, FILTER(_backlogTotalGrupos, and(_backlogTotalGrupos[Año] = YEAR(TODAY()), _backlogTotalGrupos[NroMes] = MONTH(TODAY()))))
		formatString: 0
		lineageTag: 63a0f396-86df-4b8a-ad98-aa6495f352b9

	measure _MesActualAbiertasMesesPasados = CALCULATE(SUM(_backlogTotalGrupos[abMesesPasadosTotal])+0, FILTER(_backlogTotalGrupos, and(_backlogTotalGrupos[Año] = YEAR(TODAY()), _backlogTotalGrupos[NroMes] = MONTH(TODAY()))))
		formatString: 0
		lineageTag: 99820e1e-38f8-4142-b624-3fb61740e9e9

	column _myMesAñoInc
		lineageTag: 05f40a9f-a5e7-47de-b300-7417e35e2cf3
		summarizeBy: none
		isNameInferred
		sourceColumn: incident[_myMesAñoInc]

		annotation SummarizationSetBy = Automatic

	column AbiertasTotal
		formatString: 0
		lineageTag: ed37578d-da97-4b1d-a453-5093cabc94ab
		summarizeBy: sum
		sourceColumn: [Abiertas]

		annotation SummarizationSetBy = Automatic

	column abTotal = if(_backlogTotalGrupos[AbiertasTotal]=BLANK(), 0, _backlogTotalGrupos[AbiertasTotal])
		formatString: 0
		lineageTag: 3cddcd69-688f-487c-8ac7-f5ca5d8a9615
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Año
		formatString: 0
		lineageTag: 90bb87e6-09c2-4d46-959e-0aeddb091bf6
		summarizeBy: sum
		isNameInferred
		sourceColumn: LocalDateTable_aff3165d-b0d1-41f3-8899-50f1e94669e0[Año]

		annotation SummarizationSetBy = Automatic

	column NroMes
		formatString: 0
		lineageTag: a61210d1-25b0-42c3-bec5-b8bd9a7b9653
		summarizeBy: sum
		isNameInferred
		sourceColumn: LocalDateTable_aff3165d-b0d1-41f3-8899-50f1e94669e0[NroMes]

		annotation SummarizationSetBy = Automatic

	column fecha = DATE(_backlogTotalGrupos[Año],_backlogTotalGrupos[NroMes],1)
		formatString: d-m-yy
		lineageTag: 4ebb0496-87fe-46ad-8779-ea2d2a966721
		summarizeBy: none

		variation Variación
			isDefault
			relationship: 710d700f-0bbf-4d58-af00-29a66ac55016
			defaultHierarchy: LocalDateTable_7d74df67-cb49-45fa-9c67-7a20edd89039.'Jerarquía de fechas'

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	column abMesesPasadosTotal = [AcumuladoTotal]-_backlogTotalGrupos[abTotal]
		formatString: 0
		lineageTag: ecda741d-ed00-4ccd-869a-7c873be06454
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Cerradas = CALCULATE(COUNTROWS(incident),filter(incident, and(incident[__Util]="Si",and(_backlogTotalGrupos[_myMesAñoInc]=incident[_myMesAñoIncCerrada],incident[Estado]="Cerrado"))))
		formatString: 0
		lineageTag: 672cc13f-996c-4089-b424-cd2967c0a0df
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition _backlogTotalGrupos-d94c1f3f-177d-4911-a655-8803ffc87793 = calculated
		mode: import
		source = ```
				
				    SUMMARIZE (
				    'incident',
				    incident[_myMesAñoInc],
				    incident[Fecha Apertura].[NroMes], 
				    incident[Fecha Apertura].[Año],
				    "Abiertas", CALCULATE(COUNT(incident[_myMesAñoInc]),FILTER(incident,and(incident[__Util]="Si",incident[__EstadoGeneral]="Abierta")))
				    )
				```

	annotation PBI_Id = 2be4883576e34e95b26c54d354ff00b1

