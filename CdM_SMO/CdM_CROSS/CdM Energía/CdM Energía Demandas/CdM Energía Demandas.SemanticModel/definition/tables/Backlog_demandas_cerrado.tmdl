	partition Backlog_demandas_cerrado = calculated
		mode: import
		source = ```
				
				    SELECTCOLUMNS(
				        'dmn_demand',
				        "1 - Number", dmn_demand[number],
				        "2 - Estado", dmn_demand[dv_state],
				        "3 - MesAño", dmn_demand[MesAñoCerrada],
				        "4 - NroMes", dmn_demand[closed_at].[NroMes], 
				        "5 - Año", dmn_demand[closed_at].[Año],
				        "6 - Porfolio", dmn_demand[dv_portfolio],
				        "7 - Prioridad", dmn_demand[dv_priority],
				        "8 - Tallaje", dmn_demand[Tallaje],
				        "9 - Presupuesto", dmn_demand[u_total_budget],
				        "10 - Tipo", "Cerradas"
				            )
				```

	annotation PBI_Id = 2ac937afffd64d40aee995eb8ca79e8a

