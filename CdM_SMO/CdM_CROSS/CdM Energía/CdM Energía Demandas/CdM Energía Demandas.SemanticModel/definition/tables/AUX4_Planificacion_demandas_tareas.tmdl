	partition AUX4_Planificacion_demandas_tareas = calculated
		mode: import
		source =
				
				SELECTCOLUMNS('Traza_Demandas',
				 "1 ID", 'Traza_Demandas'[number],
				 "2 Iniciativagenerada", 'Traza_Demandas'[TareaProyecto4],
				 "3 Descripcion", RELATED(pm_project_task[short_description]),
				 "4 Fecha inicio", RELATED(pm_project_task[start_date]),
				 "5 Fecha fin", RELATED(pm_project_task[end_date]),
				 "6 Porcentaje completo", RELATED('pm_project_task'[percent_complete])
				)

	annotation PBI_Id = 1b085d9438f24698a332511ab140c016

