table Backlog_tareas_demanda
	lineageTag: 3274f61f-b655-4f32-b5d3-629b30c29c14

	measure abiertas_este_mes = COUNTROWS(FILTER(Backlog_tareas_demanda, [7 - Tipo] = "Abiertas"))
		formatString: 0
		lineageTag: b23cbcd5-4382-4159-8bb5-bb8e784fb56a

	measure cerradas_este_mes = COUNTROWS(FILTER(Backlog_tareas_demanda, [7 - Tipo] = "Cerradas"))
		formatString: 0
		lineageTag: 5501b04b-a74b-4af2-aa31-4e1bdd21b31f

	measure Backlog_demandas_acumulado = ```
			
			VAR MesActual = MAX('Backlog_tareas_demanda'[9 - Fecha])
			RETURN
			    CALCULATE(
			        COUNTROWS('Backlog_tareas_demanda'),
			        FILTER(
			            ALLEXCEPT('Backlog_tareas_demanda', Backlog_tareas_demanda[2 - Estado],'Backlog_tareas_demanda'[5 - Aplicacion] , 'Backlog_tareas_demanda'[6 - Grupo], 'Backlog_tareas_demanda'[8 - Porfolio], 'Backlog_tareas_demanda'[9 - Prioridad], 'Backlog_tareas_demanda'[10 - Tallaje], 'Backlog_tareas_demanda'[11 - Negocio]),
			            'Backlog_tareas_demanda'[9 - Fecha] < MesActual &&
			            'Backlog_tareas_demanda'[7 - Tipo] = "Abiertas" &&
			            RELATED(Demandas_Tasks[PortfolioDemanda]) <> "Vacio"
			        )
			    ) - 
			    CALCULATE(
			        COUNTROWS('Backlog_tareas_demanda'),
			        FILTER(
			            ALLEXCEPT('Backlog_tareas_demanda', 'Backlog_tareas_demanda'[2 - Estado],'Backlog_tareas_demanda'[5 - Aplicacion] , 'Backlog_tareas_demanda'[6 - Grupo], 'Backlog_tareas_demanda'[8 - Porfolio], 'Backlog_tareas_demanda'[9 - Prioridad], 'Backlog_tareas_demanda'[10 - Tallaje], 'Backlog_tareas_demanda'[11 - Negocio]),
			            'Backlog_tareas_demanda'[9 - Fecha] < MesActual &&
			            'Backlog_tareas_demanda'[9 - Fecha] >= DATE(2019,12,1) &&
			            'Backlog_tareas_demanda'[7 - Tipo] = "Cerradas" && 
			            RELATED(Demandas_Tasks[PortfolioDemanda]) <> "Vacio"
			        )
			    )
			```
		formatString: 0
		lineageTag: 73966a86-ef65-40c0-902a-a93077cb4e1a

