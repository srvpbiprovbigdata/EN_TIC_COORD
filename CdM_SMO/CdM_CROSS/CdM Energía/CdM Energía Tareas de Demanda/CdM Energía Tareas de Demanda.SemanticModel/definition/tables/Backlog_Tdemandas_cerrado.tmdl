	partition Backlog_Tdemandas_cerrado = calculated
		mode: import
		source = ```
				
				    SELECTCOLUMNS(
				        'Demandas_Tasks',
				        "1 - Number", Demandas_Tasks[number],
				        "2 - Estado", Demandas_Tasks[dv_state],
				        "3 - FechaMes", Demandas_Tasks[closed_at].[NroMes],
				        "4 - FechaAño", Demandas_Tasks[closed_at].[Año],
				        "5 - Aplicacion" , Demandas_Tasks[AplicacionDemanda],
				        "6 - Grupo" , Demandas_Tasks[dv_assignment_group],
				        "7 - Tipo" , "Cerradas",
				        "8 - Porfolio", Demandas_Tasks[Demandas.dv_portfolio],
				        "9 - Prioridad", Demandas_Tasks[_dv_priority - español],
				        "10 - Tallaje", Demandas_Tasks[TallajeDemanda_SoloLetra],
				        "11 - Negocio", RELATED('Grupo Asignación'[Unidad Tecnología])
				    )
				```

	annotation PBI_Id = 2e0b25cae0574e5da6ca55690570affd

