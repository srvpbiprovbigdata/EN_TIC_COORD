	partition 'AUX_ficha - Mejoras' = calculated
		mode: import
		source =
				SELECTCOLUMNS('Ficha - dmn_demand',
				"1 - ID", 'Ficha - dmn_demand'[Proyectos_Mejoras_generados],
				"2 - ID_demanda", 'Ficha - dmn_demand'[number],
				"3 - Título", RELATED('Ficha - rm_enhancement'[short_description]),
				"4 - Impacto", RELATED('Ficha - rm_enhancement'[dv_impact]),
				"5 - Estado", RELATED('Ficha - rm_enhancement'[dv_state]),
				"6 - Portfolio", 'Ficha - dmn_demand'[dv_portfolio],
				"7 - Grupo asignación", RELATED('Ficha - rm_enhancement'[dv_assignment_group]),
				"8 - Ejecución", "",
				"9 - Prioridad" , RELATED('Ficha - rm_enhancement'[dv_priority]),
				"10 - Esfuerzo", RELATED('Ficha - rm_enhancement'[dv_work_effort]),
				"11 - Descripción", RELATED('Ficha - rm_enhancement'[description]),
				"12 - Aplicación", RELATED('Ficha - rm_enhancement'[dv_cmdb_ci_business_app]),
				"13 - Fecha plan inicio", RELATED('Ficha - rm_enhancement'[start_date]),
				"14 - Fecha plan fin", RELATED('Ficha - rm_enhancement'[end_date]),
				"15 - Fecha apertura", RELATED('Ficha - rm_enhancement'[opened_at]),
				"16 - Fecha cierre", RELATED('Ficha - rm_enhancement'[closed_at]),
