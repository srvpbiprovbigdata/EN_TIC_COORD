	partition Backlog_demandas_cerrado = calculated
		mode: import
		source = ```
				SELECTCOLUMNS(
				    'Ficha - dmn_demand',
				    "1 - Number", 'Ficha - dmn_demand'[number],
				    "2 - Estado", 'Ficha - dmn_demand'[dv_state],
				    "3 - NroMes", 'Ficha - dmn_demand'[closed_at].[NroMes], 
				    "4 - Año", 'Ficha - dmn_demand'[closed_at].[Año],
				    "5 - Porfolio", 'Ficha - dmn_demand'[dv_portfolio],
				    "6 - Prioridad", 'Ficha - dmn_demand'[dv_priority],
				    "7 - Tallaje", 'Ficha - dmn_demand'[dv_size.1],
				    "8 - Presupuesto", 'Ficha - dmn_demand'[u_total_budget],
				    "9 - Tipo", "Cerradas",
				    "10 - Unidad tecnológica", RELATED('Porfolios 3'[Unidad Tecnología]),
				    "11 - Aplicación", 'Ficha - dmn_demand'[dv_u_business_applications]
				)
				```

	annotation PBI_Id = d27bcb9406c04517892e770019223aa5

