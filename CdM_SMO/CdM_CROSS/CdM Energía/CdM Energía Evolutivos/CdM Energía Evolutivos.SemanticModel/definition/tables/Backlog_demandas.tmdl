table Backlog_demandas
	lineageTag: e1abe479-2ab4-4cbb-9269-fc634aecafd1

	measure abiertas_este_mes = COUNTROWS(FILTER(Backlog_demandas, [9 - Tipo] = "Abiertas"))
		formatString: 0
		lineageTag: 799a4c51-9751-4fad-80c7-970f89637104

	measure cerradas_este_mes = COUNTROWS(FILTER(Backlog_demandas, [9 - Tipo] = "Cerradas"))
		formatString: 0
		lineageTag: fedf597b-f358-43bf-9de9-193eb588991c

	measure Backlog_demandas_acumulado = ```
			
			VAR MesActual = MAX('Backlog_demandas'[11- Fecha])
			RETURN
			    CALCULATE(
			        COUNTROWS('Backlog_demandas'),
			        FILTER(
			            ALLEXCEPT('Backlog_demandas', 'Backlog_demandas'[2 - Estado],'Backlog_demandas'[5 - Porfolio] , Backlog_demandas[6 - Prioridad],Backlog_demandas[7 - Tallaje]),
			            'Backlog_demandas'[11- Fecha] < MesActual &&
			            'Backlog_demandas'[9 - Tipo] = "Abiertas"
			        )
			    ) - 
			    CALCULATE(
			        COUNTROWS('Backlog_demandas'),
			        FILTER(
			            ALLEXCEPT('Backlog_demandas', 'Backlog_demandas'[2 - Estado],'Backlog_demandas'[5 - Porfolio] , Backlog_demandas[6 - Prioridad],Backlog_demandas[7 - Tallaje]),
			            'Backlog_demandas'[11- Fecha] < MesActual &&
			            'Backlog_demandas'[11- Fecha] >= DATE(2019,12,1) &&
			            'Backlog_demandas'[9 - Tipo] = "Cerradas"           
			        )
			    )
			```
		formatString: 0
		lineageTag: 31f397fa-fe89-4743-b716-cea29922c5bd

