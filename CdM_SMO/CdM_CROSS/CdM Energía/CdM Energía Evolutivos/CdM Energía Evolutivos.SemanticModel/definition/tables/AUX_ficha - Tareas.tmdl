	partition 'AUX_ficha - Tareas' = calculated
		mode: import
		source = ```
				SELECTCOLUMNS('Ficha - dmn_demand',
				"1 - ID", 'Ficha - dmn_demand'[Ficha - pm_project_task.number],
				"2 - ID_demanda", 'Ficha - dmn_demand'[number],
				"3 - Título", RELATED('Ficha - pm_project_task'[short_description]),
				"4 - Impacto", RELATED('Ficha - pm_project_task'[dv_impact]),
				"5 - Estado", RELATED('Ficha - pm_project_task'[dv_state]),
				"6 - Portfolio", 'Ficha - dmn_demand'[dv_portfolio],
				"7 - Grupo asignación", RELATED('Ficha - pm_project_task'[dv_assignment_group]),
				"8 - Ejecución", "",
				"9 - Prioridad" , RELATED('Ficha - pm_project_task'[dv_priority]),
				"10 - Esfuerzo", RELATED('Ficha - pm_project_task'[dv_work_effort]),
				"11 - Descripción", RELATED('Ficha - pm_project_task'[description]),
				"12 - Aplicación", RELATED('Ficha - pm_project_task'[dv_cmdb_ci_business_app]),
				"13 - Fecha plan inicio", RELATED('Ficha - pm_project_task'[start_date]),
				"14 - Fecha plan fin", RELATED('Ficha - pm_project_task'[end_date]),
				"15 - Fecha apertura", RELATED('Ficha - pm_project_task'[opened_at]),
				"16 - Fecha cierre", RELATED('Ficha - pm_project_task'[closed_at]),
				"17 - Percent complete", RELATED('Ficha - pm_project_task'[percent_complete])
				)
				
				```

