	column Impacto_ES =
			SWITCH(
			    'Ficha_evolutivos'[4 - Impacto],
			    "3 - Low", "3 - Bajo",
			    "2 - Medium", "2 - Medio",
			    "1 - High", "1 - Alto"
			)
		lineageTag: e413fe43-dcaf-48a2-917b-c6d68d22c63f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Prioridad_ES =
			SWITCH(
			    'Ficha_evolutivos'[9 - Prioridad],
			    "3 - Moderate", "3 - Moderado",
			    "2 - High", "2 - Alto",
			    "1 - Critical", "1 - Crítico",
			    "4 - Low", "4 - Bajo",
			    "5 - Very Low", "5 - Muy Bajo"
			)
		lineageTag: c9f09acb-cd7e-4541-bc12-b42403efa905
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Estado_ES = ```
			SWITCH(
			    'Ficha_evolutivos'[5 - Estado],
			    "Open", "Abierto",
			    "Work in Progress", "En curso",
			    "Pending", "Pendiente",
			    "Closed Incomplete", "Cerrado incompleto",
			    "Closed Skipped", "Cerrado omitido",
			    "Draft", "Borrador",
			    "In Analysis", "En análisis", 
			    "In Development", "En proceso",
			    "Testing/QA", "En pruebas",
			    "Deploy/Launch", "Despliegue",
			    "On Hold", "En espera",
			    "Cancelled", "Cancelado",
			    "Closed Complete", "Cerrado completo"
			
			)
			```
		lineageTag: 2fb991d1-eed5-4076-90e5-29dfe0437253
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

