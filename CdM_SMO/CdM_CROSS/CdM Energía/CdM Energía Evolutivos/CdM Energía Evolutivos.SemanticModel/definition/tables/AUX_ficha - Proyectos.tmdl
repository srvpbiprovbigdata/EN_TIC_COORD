	partition 'AUX_ficha - Proyectos' = calculated
		mode: import
		source =
				SELECTCOLUMNS('Ficha - dmn_demand',
				"1 - ID", 'Ficha - dmn_demand'[Proyectos_Mejoras_generados],
				"2 - ID_demanda", 'Ficha - dmn_demand'[number],
				"3 - Título", RELATED('Ficha - pm_project'[short_description]),
				"4 - Impacto", RELATED('Ficha - pm_project'[dv_impact]),
				"5 - Estado", RELATED('Ficha - pm_project'[dv_state]),
				"6 - Portfolio", 'Ficha - dmn_demand'[dv_portfolio],
				"7 - Grupo asignación", RELATED('Ficha - pm_project'[dv_assignment_group]),
				"8 - Ejecución", RELATED('Ficha - pm_project'[execution_type]),
				"9 - Prioridad" , RELATED('Ficha - pm_project'[dv_priority]),
				"10 - Esfuerzo", RELATED('Ficha - pm_project'[dv_work_effort]),
				"11 - Descripción", RELATED('Ficha - pm_project'[description]),
				"12 - Aplicación", RELATED('Ficha - pm_project'[dv_cmdb_ci_business_app]),
				"13 - Fecha plan inicio", RELATED('Ficha - pm_project'[start_date]),
				"14 - Fecha plan fin", RELATED('Ficha - pm_project'[end_date]),
				"15 - Fecha apertura", RELATED('Ficha - pm_project'[opened_at]),
				"16 - Fecha cierre", RELATED('Ficha - pm_project'[closed_at]),
				"17 - Percent complete", RELATED('Ficha - pm_project'[percent_complete])
				)

	annotation PBI_Id = 08be9821312c42b7a591460c7482eca6

