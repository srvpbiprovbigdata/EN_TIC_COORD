	column Ev4 = if(and(and(and('Ev4&5TareasProyectos-Mantener'[u_demand] = "Sin demanda asociada", 'Ev4&5TareasProyectos-Mantener'[dv_top_portfolio] = "EN.Supply Chain"), related(Ev4Proyectos[Ev4])=TRUE()),'Ev4&5TareasProyectos-Mantener'[milestone]=FALSE()), TRUE(), FALSE())
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 23dff96f-4b70-412e-b158-3440f38c5f9f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Ev5App = RELATED(Ev5Proyectos[dv_cmdb_ci_business_app])
		lineageTag: e6aa2486-d104-4b61-b2cc-732b9174f613
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Ev4App = RELATED(Ev4Proyectos[dv_cmdb_ci_business_app])
		lineageTag: 43962694-e0d8-4781-900c-d1e0ac7e7983
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column EvAppTareas = if(or('Ev4&5TareasProyectos-Mantener'[Ev5App] = "",'Ev4&5TareasProyectos-Mantener'[Ev5App] = BLANK()), 'Ev4&5TareasProyectos-Mantener'[Ev4App], 'Ev4&5TareasProyectos-Mantener'[Ev5App])
		lineageTag: 4b148142-96b6-4907-af48-4d9eac8929af
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column DuracionProyecto = (DATEDIFF('Ev4&5TareasProyectos-Mantener'[end_date], 'Ev4&5TareasProyectos-Mantener'[start_date],DAY)*(-1))
		formatString: 0
		lineageTag: 66bff75f-e86e-4380-9df3-08286b44c498
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Dias de avance teorico' = ```
			IF('Ev4&5TareasProyectos-Mantener'[end_date]<TODAY(), 
			(DATEDIFF('Ev4&5TareasProyectos-Mantener'[end_date], 'Ev4&5TareasProyectos-Mantener'[start_date],DAY)*(-1)), 
			(DATEDIFF(TODAY(),'Ev4&5TareasProyectos-Mantener'[start_date],DAY)*(-1)))
			```
		formatString: 0
		lineageTag: 8c1baa7c-dd3d-44bb-8e14-b5a0e62cac73
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column '% avance teorico' = DIVIDE('Ev4&5TareasProyectos-Mantener'[Dias de avance teorico], 'Ev4&5TareasProyectos-Mantener'[DuracionProyecto], 0)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: ec48cba8-ec7f-4b9b-aa97-3726c5c210c0
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column '% comparativo entre teorico y real' = 'Ev4&5TareasProyectos-Mantener'[% avance teorico] - ('Ev4&5TareasProyectos-Mantener'[percent_complete]/100)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 55b72db6-269c-43ed-8700-55fee5a1a42d
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Estado proyectos desviados en alcance' = IF('Ev4&5TareasProyectos-Mantener'[% comparativo entre teorico y real]<=0.10,"Entre 0 y 10%",IF('Ev4&5TareasProyectos-Mantener'[% comparativo entre teorico y real]<=0.25,"Entre 11 y 25%",IF('Ev4&5TareasProyectos-Mantener'[% comparativo entre teorico y real]>0.25,">25%","Sin avance")))
		lineageTag: 8d5c4e7c-d578-4590-8af7-bcfcb9b4ab12
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

