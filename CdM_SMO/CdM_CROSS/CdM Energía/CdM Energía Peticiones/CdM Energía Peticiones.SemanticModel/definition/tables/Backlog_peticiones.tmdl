table Backlog_peticiones
	lineageTag: eb2c2d48-e00d-4dcd-a5c1-a18dfd2a7e71

	measure abiertas_este_mes = COUNTROWS(FILTER(Backlog_peticiones, [6 - Tipo] = "Abiertas"))
		formatString: #,0
		lineageTag: 986715d9-7038-496c-8169-d0d8750007c3

	measure cerradas_este_mes = COUNTROWS(FILTER(Backlog_peticiones, [6 - Tipo] = "Cerrado"))
		formatString: #,0
		lineageTag: eb9e360d-d18d-46fc-b35f-d66148fb3f68

	measure Backlog_peticiones_acumulado = ```
			
			VAR MesActual = MAX('Backlog_peticiones'[Fecha])
			RETURN
			    CALCULATE(
			        COUNTROWS('Backlog_peticiones'),
			        FILTER(
			            ALLEXCEPT('Backlog_peticiones', 'Backlog_peticiones'[2 - Estado],'Backlog_peticiones'[5 - Elemento]),
			            'Backlog_peticiones'[Fecha] < MesActual &&
			            'Backlog_peticiones'[6 - Tipo] = "Abiertas"
			        )
			    ) - 
			    CALCULATE(
			        COUNTROWS('Backlog_peticiones'),
			        FILTER(
			            ALLEXCEPT('Backlog_peticiones', 'Backlog_peticiones'[2 - Estado],'Backlog_peticiones'[5 - Elemento]),
			            'Backlog_peticiones'[Fecha] < MesActual &&
			            'Backlog_peticiones'[Fecha] >= DATE(2021,12,1) &&
			            'Backlog_peticiones'[6 - Tipo] = "Cerrado"           
			        )
			    )
			```
		formatString: #,0
		lineageTag: 7622a1dc-0b9c-4f38-b710-3b33af2469a8

