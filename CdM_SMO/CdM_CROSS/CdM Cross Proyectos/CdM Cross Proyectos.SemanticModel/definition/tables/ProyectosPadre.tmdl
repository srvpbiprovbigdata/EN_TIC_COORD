		dataType: string
		lineageTag: 7bf62765-ac97-4759-b602-49cbea6032c4
		summarizeBy: none
		sourceColumn: _dv_priority - español

		annotation SummarizationSetBy = Automatic

	column Tallaje-Demanda = LOOKUPVALUE('Demandas'[dv_size],'Demandas'[sys_id], [demand])
		lineageTag: a8d56060-a3bf-4db7-b126-014d99f86ae4
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'URL ProyectoPadre' = CONCATENATE("https://acciona.service-now.com/pm_project.do?sysparm_query=number%3d",ProyectosPadre[number])
		lineageTag: c84b8343-e27e-4d1a-a66c-6de8a66da355
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column '_% Percent_complete' = (('ProyectosPadre'[percent_complete])/100)+0
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: e0ef213c-d42c-41a5-9b92-1ebaaa1bb893
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Suma_Presupuestos_BudgetCost_GradoAvance_SoloProyectosEnergia = SUM(ProyectosPadre[BudgetCost_GradoAvance_SoloProyectosEnergia])+0
		lineageTag: a1e2b664-e362-401f-a595-ed9242ba290b
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column '% Presupuesto_TOTAL' = (DIVIDE([BudgetCost_GradoAvance_SoloProyectosEnergia],[Suma_Presupuestos_BudgetCost_GradoAvance_SoloProyectosEnergia],BLANK()))*100
		formatString: 0.00000
		lineageTag: e8761e52-f14f-4236-9309-0018e486b192
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Avance_Ponderado = ([_% Percent_complete]*[% Presupuesto_TOTAL])/100
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 541cf24b-cf3e-4f1d-98d4-bacd56c916fd
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column CandidatosENERGIAParaCalcular_GradoAvance = if(and(related(Demandas[Es_Portfolio_Energia])=TRUE(), ProyectosPadre[ProyectoDemandaEnergia]=TRUE()), "Candidato")
		lineageTag: 402d16a3-aacc-4ed5-bcb5-b2a5119993c5
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column BudgetCost_GradoAvance_SoloProyectosEnergia = if(and(or(ProyectosPadre[dv_phase]="Executing", ProyectosPadre[dv_phase]="In Pause"), ProyectosPadre[CandidatosENERGIAParaCalcular_GradoAvance] = "Candidato"), ProyectosPadre[cost], 0)
		lineageTag: f15de1c5-f35d-4e8d-81b7-a011a474fb38
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column DuracionProyecto = ((DATEDIFF('ProyectosPadre'[end_date],'ProyectosPadre'[start_date],HOUR)/24*(-1)))
		formatString: 0.00
		lineageTag: 774753cd-6bd9-472d-b41d-ce6c098e7b65
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column DuracionProyecto_ConPorcentajeCompletado = ('ProyectosPadre'[DuracionProyecto]*'ProyectosPadre'[percent_complete])/100
		formatString: 0.00
		lineageTag: 297999b2-26c8-4098-bc97-c50ace75df66
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Fecha_Objetivo = 'ProyectosPadre'[start_date] + 'ProyectosPadre'[DuracionProyecto_ConPorcentajeCompletado]
		formatString: General Date
		lineageTag: b87f713a-39df-4890-88fa-9d65b1e63a7a
		summarizeBy: none

		variation Variación
			isDefault
			relationship: 87011054-7ad3-4253-a59e-843a291d91bf
			defaultHierarchy: LocalDateTable_71a9d493-2e92-4703-abcb-69fb97a4f85c.'Jerarquía de fechas'

		annotation SummarizationSetBy = Automatic

	column Desviacion = TODAY() - 'ProyectosPadre'[Fecha_Objetivo]
		dataType: double
		formatString: 0.00
		lineageTag: 7847ce22-90fd-43fa-8cc5-5660627691d9
		summarizeBy: sum

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

	column Porcentaje_Desviacion_Decimal = DIVIDE('ProyectosPadre'[Desviacion],'ProyectosPadre'[DuracionProyecto], 0)*100
		formatString: 0.00
		lineageTag: 71faab62-8070-4130-b5ea-8a08a86b3b6a
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Porcentaje_Desviacion = DIVIDE('ProyectosPadre'[Desviacion],'ProyectosPadre'[DuracionProyecto], 0)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 08500531-7316-4fcb-b31f-73cad451e288
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Desviacion_Ponderada_Por_Presupuesto_Decimal = ('ProyectosPadre'[Porcentaje_Desviacion_Decimal]*'ProyectosPadre'[cost])
		formatString: 0.00
		lineageTag: 9aa430a9-53ff-4d14-a945-021fecf6603d
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Porcentaje_Desviacion_Decimal_SoloProyectosEnergia = if(and(or(ProyectosPadre[dv_phase]="Executing", ProyectosPadre[dv_phase]="In Pause"), ProyectosPadre[CandidatosENERGIAParaCalcular_GradoAvance] = "Candidato"), ProyectosPadre[Porcentaje_Desviacion_Decimal], 0)
		formatString: 0.00
		lineageTag: ae8ecbf1-e4b5-4bb2-93de-a3f3587d5ec1
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Suma_Porcentaje_Desviacion_Decimal_SoloProyectosEnergia = SUM(ProyectosPadre[Porcentaje_Desviacion_Decimal_SoloProyectosEnergia])+0
		formatString: 0.00
		lineageTag: cfb7a581-d223-4cda-a297-4ac4290ae770
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Desviacion_Ponderada_Por_Presupuesto_SoloProyectosEnergia = if(and(or(ProyectosPadre[dv_phase]="Executing", ProyectosPadre[dv_phase]="In Pause"), ProyectosPadre[CandidatosENERGIAParaCalcular_GradoAvance] = "Candidato"), ProyectosPadre[Desviacion_Ponderada_Por_Presupuesto_Decimal], 0)
		formatString: 0.00
		lineageTag: 52abbbcc-c4b8-494b-9aa0-71849cda0ee6
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Suma_Desviacion_Ponderada_Por_Presupuesto = SUM(ProyectosPadre[Desviacion_Ponderada_Por_Presupuesto_SoloProyectosEnergia])+0
		formatString: 0.00
		lineageTag: 3b7d2d64-fe74-45e6-a34f-1db90f4f0155
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Desviacion_Ponderada_Por_PresupuestoEnergia = DIVIDE ('ProyectosPadre'[Suma_Desviacion_Ponderada_Por_Presupuesto], 'ProyectosPadre'[Suma_Presupuestos_BudgetCost_GradoAvance_SoloProyectosEnergia], 0)
		formatString: 0.00
		lineageTag: ec9b2e63-a363-4ec6-880d-bf7a2bbafd8c
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column percent_complete_ProyectosEnergia = if(and(or(ProyectosPadre[dv_phase]="Executing", ProyectosPadre[dv_phase]="In Pause"), ProyectosPadre[CandidatosENERGIAParaCalcular_GradoAvance] = "Candidato"), ProyectosPadre[percent_complete], 0)
