	column ProyectoDemandaEnergia = if(CONTAINS(Demandas,Demandas[sys_id], ProyectosPadre[demand]), TRUE(), FALSE())
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 6af02956-e0b6-4cd6-ad93-1cdea5e9118c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

