table ProyectosPadre
	lineageTag: 9c0d021c-cc49-4bec-9248-05ff4e6d6a2c

	measure '_% Percent_complete_SIN_ERROR_ProyectosPadre' = (AVERAGE('ProyectosPadre'[percent_complete_ProyectosEnergia])/100)+0
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 954fd49c-b100-4d16-bd98-11c8a51bcc17

	measure 1_Ponderacion_Suma_Presuspuestos = SUM(ProyectosPadre[budget_cost])
		lineageTag: 194c3b1d-4376-460d-ac55-0e69b9ee653c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Avance_Ponderado_SinERROR = (SUM(ProyectosPadre[Avance_Ponderado]))+0
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: bf5d2d3d-48d6-41c1-be0a-71f468c36c7b

	measure Porcentaje_Desviacion_SinERROR = (AVERAGE(ProyectosPadre[Porcentaje_Desviacion_Decimal])/100)+0
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: d089b4d2-a399-4bcb-a1f3-c113e8636cdd

	measure Medida_SUMA_Desviacion_Ponderada_Por_Presupuesto = SUM(ProyectosPadre[Desviacion_Ponderada_Por_Presupuesto_SoloProyectosEnergia])+0
		formatString: 0.00
		lineageTag: 0c1a3290-c5c0-4079-b071-cefcd3db2cdd

	measure 'Medida_ Desviacion_Ponderada_Por_PresupuestoEnergia' = (('ProyectosPadre'[Medida_SUMA_Desviacion_Ponderada_Por_Presupuesto] / 'ProyectosPadre'[Medida_SUMA_Presupuestos_BudgetCost_GradoAvance_SoloProyectosEnergia])/100)+0
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 6964297e-04ee-41c3-9905-c9456617ad32

	measure Medida_SUMA_Presupuestos_BudgetCost_GradoAvance_SoloProyectosEnergia = SUM(ProyectosPadre[BudgetCost_GradoAvance_SoloProyectosEnergia])+0
		lineageTag: 7ab7b9a2-1e98-4af8-b4b6-d8b284c7b9fc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Avance_Ponderado_Filtros =
			
			VAR SelectedFPlanificadaInicio = SELECTEDVALUE( ProyectosPadre[_start_date - SoloFecha] )
			VAR SelectedAplicacion = SELECTEDVALUE( ProyectosPadre[dv_cmdb_ci_business_app] )
			VAR SelectedTallaje = SELECTEDVALUE( ProyectosPadre[Tallaje-Demanda] )
			VAR SelectedRelevante = SELECTEDVALUE( ProyectosPadre[u_relevant_español] )
			VAR SelectedPrioridad = SELECTEDVALUE( ProyectosPadre[_dv_priority - español] )
			VAR myFilteredTable  =
			    CALCULATETABLE(
			        ProyectosPadre,
			        ProyectosPadre[_start_date - SoloFecha] = SelectedFPlanificadaInicio,
			        ProyectosPadre[dv_cmdb_ci_business_app] = SelectedAplicacion,
			        ProyectosPadre[Tallaje-Demanda] = SelectedTallaje,
			        ProyectosPadre[u_relevant_español] = SelectedRelevante,
			        ProyectosPadre[_dv_priority - español] = SelectedPrioridad
			    )
			RETURN
			    DIVIDE(SUMX(ProyectosPadre, ProyectosPadre[_% Percent_complete]*ProyectosPadre[BudgetCost_GradoAvance_SoloProyectosEnergia]),
			     SUMX(ProyectosPadre, ProyectosPadre[BudgetCost_GradoAvance_SoloProyectosEnergia]))
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: d38352b6-e68d-457a-bfd8-8e63c5b80f83

	measure Avance_Ponderado_Filtros_SinERROR = if(ProyectosPadre[Avance_Ponderado_Filtros] > 0, ProyectosPadre[Avance_Ponderado_Filtros], 0)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 0e5fc2d1-ec72-4e06-b54c-4175ef40c0f7

	measure 'Medida_ Desviacion_Ponderada_Por_PresupuestoEnergia_SinError' = if (ProyectosPadre[Medida_ Desviacion_Ponderada_Por_PresupuestoEnergia]>0, ProyectosPadre[Medida_ Desviacion_Ponderada_Por_PresupuestoEnergia],0)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: a36c9df6-cf7d-4153-92cf-eb1a75b8e1da

