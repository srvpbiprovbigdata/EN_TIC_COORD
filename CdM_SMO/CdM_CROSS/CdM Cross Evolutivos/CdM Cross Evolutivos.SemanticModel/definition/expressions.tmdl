expression 'Transformar archivo (3)' =
		let
		    Origen = (Parámetro3 as binary) => let
		    Origen = Excel.Workbook(Parámetro3, null, true),
		    Hoja1_Sheet = Origen{[Item="Hoja1",Kind="Sheet"]}[Data]
		in
		    Hoja1_Sheet
		in
		    Origen
