expression 'Archivo de ejemplo (3)' =
		let
		    Origen = SharePoint.Files("https://acciona365.sharepoint.com/sites/EN_TIC_COORD_PRE/", [ApiVersion = 15]),
		    #"Filas filtradas" = Table.SelectRows(Origen, each ([Extension] = ".xlsx") and ([Name] = "Aplicaciones_Evolutivos.xlsx")),
		    Navegación1 = #"Filas filtradas"{0}[Content]
		in
		    Navegación1
	lineageTag: ad449029-a8ce-4e48-866a-fdc5be312d96
