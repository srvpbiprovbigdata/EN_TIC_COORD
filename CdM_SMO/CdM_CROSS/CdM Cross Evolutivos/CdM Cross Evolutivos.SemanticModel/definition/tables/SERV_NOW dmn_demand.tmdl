		summarizeBy: none
		sourceColumn: TAREAS-SINDEMANDA-Proyectos_Padre_Evo4&5.dv_phase

		annotation SummarizationSetBy = Automatic

	column EVOLUTIVOS_PROYECTOS_PROYECTOSPADRE_dv_phase
		dataType: string
		lineageTag: ea6e9d8c-ad94-4819-b226-68d97c87512c
		summarizeBy: none
		sourceColumn: EVOLUTIVOS_PROYECTOS_PROYECTOSPADRE_dv_phase

		annotation SummarizationSetBy = Automatic

	column EVOLUTIVOS_PROYECTOS_PROYECTOSPADRE_dv_phase-español
		dataType: string
		lineageTag: 695f921d-7860-4e4c-92a7-294286545125
		summarizeBy: none
		sourceColumn: EVOLUTIVOS_PROYECTOS_PROYECTOSPADRE_dv_phase-español

		annotation SummarizationSetBy = Automatic

	column MEJORAS_FASE_FICTICIA_2 = if ('SERV_NOW dmn_demand'[MEJORAS_FASE_FICTICIA_1] = "Borrador", "Iniciando", if([MEJORAS_FASE_FICTICIA_1] = "En Análisis", "Ejecución", if([MEJORAS_FASE_FICTICIA_1] = "En Proceso", "Ejecución", if([MEJORAS_FASE_FICTICIA_1] = "En Pruebas", "Ejecución", if([MEJORAS_FASE_FICTICIA_1] = "Despliegue", "Ejecución", if([MEJORAS_FASE_FICTICIA_1] = "En espera", "En Pausa", if([MEJORAS_FASE_FICTICIA_1] = "Cerrado completo", "Cierre", if([MEJORAS_FASE_FICTICIA_1] = "Cancelado", "Cancelado"))))))))
		lineageTag: 3f89cf76-dbac-4b54-9517-8b999f149828
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column EVOLUTIVOS_COMPLETO_Fase = CONCATENATE('SERV_NOW dmn_demand'[EVOLUTIVOS_PROYECTOS_PROYECTOSPADRE_dv_phase-español], 'SERV_NOW dmn_demand'[MEJORAS_FASE_FICTICIA_2])
		lineageTag: 611c2809-84e6-44f3-9523-efa85aef74fe
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column MEJORAS_FASE_FICTICIA_1 = if('SERV_NOW dmn_demand'[TABLA_SEGUN_ID] = "Mejora", 'SERV_NOW dmn_demand'[EVOLUTIVOS_FINAL_dv_state])
		lineageTag: 577cd96d-f51d-4d87-bf60-4d5261fba913
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column '_% Percent_complete_EVOLUTIVOS_ESTADO_ENCURSO' = (('SERV_NOW dmn_demand'[_percent_complete_EVOLUTIVOS_ESTADO_ENCURSO])/100)+0
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: d565abb4-ffc7-4652-93d4-df995212a3bd
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column EVOLUTIVOS_FINAL_EstadoGenerico = LOOKUPVALUE(ESTADO_Evolutivos[Estado_Generico], ESTADO_Evolutivos[Estado_es], [EVOLUTIVOS_FINAL_dv_state])
		lineageTag: dc728bc8-cd41-4b7e-a346-93878460d7c8
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column _percent_complete_EVOLUTIVOS_ESTADO_ENCURSO = if(and('SERV_NOW dmn_demand'[EVOLUTIVOS_FINAL_EstadoGenerico] ="En curso", 'SERV_NOW dmn_demand'[DMN-APLIC-ES-ENERGIA] =TRUE()), 'SERV_NOW dmn_demand'[EVOLUTIVOS_COMPLETO_percent_complete], 0)
		formatString: 0.00
		lineageTag: 3ec89e92-14b2-490a-bad4-75126d9f88d1
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column GRADO_AVANCE_LineasCandidatas = if(and('SERV_NOW dmn_demand'[EVOLUTIVOS_FINAL_EstadoGenerico]="En curso", 'SERV_NOW dmn_demand'[DMN-APLIC-ES-ENERGIA] =TRUE()), "Candidata")
		lineageTag: 076ba965-e381-4c80-8e5e-cf6d85321c54
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column DuracionProyecto = IF('SERV_NOW dmn_demand'[GRADO_AVANCE_LineasCandidatas] = "Candidata", (DATEDIFF('SERV_NOW dmn_demand'[EVOLUTIVOS_COMPLETO_end_date],'SERV_NOW dmn_demand'[EVOLUTIVOS_COMPLETO_start_date],DAY)*(-1)))
		formatString: 0
		lineageTag: 07ffb3f7-1aed-407e-a28e-0f13638c3ebc
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Dias de avance teorico' = ```
			IF('SERV_NOW dmn_demand'[GRADO_AVANCE_LineasCandidatas] = "Candidata",
			IF('SERV_NOW dmn_demand'[EVOLUTIVOS_COMPLETO_end_date]<TODAY(), 
			(DATEDIFF('SERV_NOW dmn_demand'[EVOLUTIVOS_COMPLETO_end_date], 'SERV_NOW dmn_demand'[EVOLUTIVOS_COMPLETO_start_date],DAY)*(-1)), 
			(DATEDIFF(TODAY(),'SERV_NOW dmn_demand'[EVOLUTIVOS_COMPLETO_start_date],DAY)*(-1))))
			```
		formatString: 0
		lineageTag: 1bc2637a-99ee-4b1f-b9d9-9353e73fe8bb
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column '% avance teorico' = IF('SERV_NOW dmn_demand'[GRADO_AVANCE_LineasCandidatas] = "Candidata", DIVIDE('SERV_NOW dmn_demand'[Dias de avance teorico], 'SERV_NOW dmn_demand'[DuracionProyecto], 0))
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 84c49ea8-74b9-45b2-a13b-55902612b2e5
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column '% comparativo entre teorico y real' = IF('SERV_NOW dmn_demand'[GRADO_AVANCE_LineasCandidatas] = "Candidata",'SERV_NOW dmn_demand'[% avance teorico] - ('SERV_NOW dmn_demand'[EVOLUTIVOS_COMPLETO_percent_complete]/100))
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: cc818af8-6b93-45f9-bb26-74e0f20e0753
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

