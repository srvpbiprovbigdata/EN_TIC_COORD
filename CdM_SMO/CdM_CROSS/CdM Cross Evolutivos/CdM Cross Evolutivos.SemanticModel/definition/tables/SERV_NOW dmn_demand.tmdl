	column 'Count DemandasRepetidas' =
			
			Var DemandaRepetida = [DEMANDA_NUMBER_FICTICIO]
			RETURN
			CALCULATE(
			    COUNTROWS('SERV_NOW dmn_demand'),
			    all('SERV_NOW dmn_demand'),
			    'SERV_NOW dmn_demand'[DEMANDA_NUMBER_FICTICIO] = DemandaRepetida
