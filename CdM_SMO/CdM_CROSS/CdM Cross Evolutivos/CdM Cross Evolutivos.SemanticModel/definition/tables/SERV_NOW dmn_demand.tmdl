table 'SERV_NOW dmn_demand'
	lineageTag: 74c8654c-e6dd-4be3-bbf6-072bd65c7593

	measure '_% Percent_complete_SIN_ERROR' = ((SUM('SERV_NOW dmn_demand'[_percent_complete_EVOLUTIVOS_ESTADO_ENCURSO])/[LINEAS_ENERGIA])/100)+0
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 64985bc3-d089-45d9-acbb-1342029aae7e

	measure LINEAS_ENERGIA = COUNTX('SERV_NOW dmn_demand','SERV_NOW dmn_demand'[GRADO_AVANCE_LineasCandidatas])
		formatString: 0
		lineageTag: 3e2bd041-8306-42d3-bccf-bdc1e42f5582

	measure '_% comparativo entre teorico y real_SIN_ERROR' = (AVERAGE('SERV_NOW dmn_demand'[% comparativo entre teorico y real]))+0
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 90c6adfe-0c38-4cc2-bc4f-1fad3fef1de4

	measure 'MES_ACTUAL_Abiertos - Evolutivos'
		lineageTag: 605b64d7-1431-4b5c-a0f4-c05fa72cfaf4

	measure 'LINEAS_ENERGIA_SIN REPETIR' =
			CALCULATE(
			    DISTINCTCOUNT('SERV_NOW dmn_demand'[DEMANDA_NUMBER_FICTICIO]),
			    FILTER('SERV_NOW dmn_demand','SERV_NOW dmn_demand'[GRADO_AVANCE_LineasCandidatas] = "Candidata"))
		formatString: 0
		lineageTag: 06571c51-1cee-486f-811f-7213817be76c

	measure '_% Percent_complete_LineasNoREpetidas_SIN_ERROR' = ((SUM('SERV_NOW dmn_demand'[_percent_complete_EVOLUTIVOS_ESTADO_ENCURSO])/[LINEAS_ENERGIA_SIN REPETIR])/100)+0
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 61810c32-5ca3-478f-b782-700a565c7f91

	measure '_% comparativo entre teorico y real_LineasNoREpetidas_SIN_ERROR' = (SUM('SERV_NOW dmn_demand'[% comparativo entre teorico y real])/[LINEAS_ENERGIA_SIN REPETIR])+0
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: bb367d4b-ad19-45d7-9c4a-b428d574dbf9

	measure GradoAvanceMedio_DemandasRepetidasConNoRepetidas = ```
			
			var GradoAvanceMedio_DemandasRepetidas =
			SUMMARIZE(
			    'SERV_NOW dmn_demand', 
			    'SERV_NOW Demandas_Unicas'[DEMANDA_NUMBER_FICTICIO],
			    "Media", AVERAGE('SERV_NOW dmn_demand'[EVOLUTIVOS_COMPLETO_percent_complete])
			    )
			RETURN
			    AVERAGEX(GradoAvanceMedio_DemandasRepetidas, [Media])/100
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 05db9ee9-9a0d-423f-9418-4076f20e99c6

	measure PRUEBA_GradoAvanceMedio_DemandasNORepetidas = ```
			
			 IF('SERV_NOW dmn_demand'[LINEAS_ENERGIA_SIN REPETIR]>0, 
			AVERAGE ( 'SERV_NOW dmn_demand'[_percent_complete_EVOLUTIVOS_ESTADO_ENCURSO])+0,0)
			```
		lineageTag: 824eed4b-aa5f-4d0c-927c-2d1011e08e9c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure DesviacionMedia_DemandasRepetidasConNoRepetidas = ```
			
			var DesviacionMedia_DemandasRepetidas =
			SUMMARIZE(
			    'SERV_NOW dmn_demand', 
			    'SERV_NOW Demandas_Unicas'[DEMANDA_NUMBER_FICTICIO],
			    "Media", AVERAGE('SERV_NOW dmn_demand'[% comparativo entre teorico y real])
			    )
			RETURN
			    AVERAGEX(DesviacionMedia_DemandasRepetidas, [Media])
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 388d2849-ee18-4442-86fc-02bd9096c242

