table '_backlog_EVOLUTIVOS_SERV_NOW dmn_demand'
	lineageTag: 0eaa1a31-9cad-4e25-b18e-7bc069484c13

	measure AcumuladoTotal =
			
			CALCULATE(
			    Sum('_backlog_EVOLUTIVOS_SERV_NOW dmn_demand'[Util_AbiertosTotal])+0,
			    FILTER(ALLSELECTED('_backlog_EVOLUTIVOS_SERV_NOW dmn_demand'),
			    '_backlog_EVOLUTIVOS_SERV_NOW dmn_demand'[Fecha]<=MAX('_backlog_EVOLUTIVOS_SERV_NOW dmn_demand'[Fecha]))
			)
		formatString: 0
		lineageTag: 6abac61f-825c-409c-95e8-8388dac261ac

	column _BackLOG_EVOL_MYMesAño-Abierto
		lineageTag: 851388bf-eaee-461f-ab36-14180e5deb9d
