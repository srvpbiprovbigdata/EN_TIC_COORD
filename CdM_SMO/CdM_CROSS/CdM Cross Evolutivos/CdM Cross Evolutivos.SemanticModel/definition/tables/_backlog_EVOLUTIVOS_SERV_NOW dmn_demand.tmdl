	column MesesPasadosTotal = [AcumuladoTotal]-'_backlog_EVOLUTIVOS_SERV_NOW dmn_demand'[Util_AbiertosTotal]
		formatString: 0
		lineageTag: d237c86e-004c-4e84-8b6f-64d51963b853
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column EVOLUTIVOS_Cerrados =
			CALCULATE(COUNTROWS('SERV_NOW dmn_demand'),
			FILTER ('SERV_NOW dmn_demand', and('SERV_NOW dmn_demand'[_BackLOG_EVOL_UTIL]="Si", AND
			('_backlog_EVOLUTIVOS_SERV_NOW dmn_demand'[_BackLOG_EVOL_MYMesAño-Abierto] = 'SERV_NOW dmn_demand'[_BackLOG_EVOL_MYMesAño-Abierto],
			'SERV_NOW dmn_demand'[_BackLOG_EVOL_EstadoGeneral]="Cerrado"))))
		formatString: 0
		lineageTag: 984c1181-46be-4776-9c06-2c31c977bd7a
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

