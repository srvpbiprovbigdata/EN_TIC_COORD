	partition '_backlog_EVOLUTIVOS_SERV_NOW dmn_demand-38347e86-94d3-4971-9833-cc526b9aa2f8' = calculated
		mode: import
		source = ```
				
				    SUMMARIZE (
				    'SERV_NOW dmn_demand',
				    'SERV_NOW dmn_demand'[_BackLOG_EVOL_MYMesAño-Abierto],
				    'SERV_NOW dmn_demand'[EVOLUTIVOS_COMPLETO_Fecha Apertura ConFormatoFecha].[NroMes], 
				    'SERV_NOW dmn_demand'[EVOLUTIVOS_COMPLETO_Fecha Apertura ConFormatoFecha].[Año],
				    "AbiertosTotal", CALCULATE(COUNT('SERV_NOW dmn_demand'[_BackLOG_EVOL_MYMesAño-Abierto]),
				    FILTER('SERV_NOW dmn_demand',and('SERV_NOW dmn_demand'[_BackLOG_EVOL_UTIL]="Si",'SERV_NOW dmn_demand'[_BackLOG_EVOL_EstadoGeneral]="Abierto"))),
				    "AbiertosTotal_EnBlanco", CALCULATE(COUNT('SERV_NOW dmn_demand'[_BackLOG_EVOL_MYMesAño-Abierto]),
				    FILTER('SERV_NOW dmn_demand',and(and('SERV_NOW dmn_demand'[_BackLOG_EVOL_UTIL]="Si",'SERV_NOW dmn_demand'[_BackLOG_EVOL_EstadoGeneral]="Abierto"),'SERV_NOW dmn_demand' [_dv_size - SoloLetra]="(En blanco)"))),
				    "AbiertosTotal_XS", CALCULATE(COUNT('SERV_NOW dmn_demand'[_BackLOG_EVOL_MYMesAño-Abierto]),
				    FILTER('SERV_NOW dmn_demand',and(and('SERV_NOW dmn_demand'[_BackLOG_EVOL_UTIL]="Si",'SERV_NOW dmn_demand'[_BackLOG_EVOL_EstadoGeneral]="Abierto"),'SERV_NOW dmn_demand' [_dv_size - SoloLetra]="XS"))),
				    "AbiertosTotal_S", CALCULATE(COUNT('SERV_NOW dmn_demand'[_BackLOG_EVOL_MYMesAño-Abierto]),
				    FILTER('SERV_NOW dmn_demand',and(and('SERV_NOW dmn_demand'[_BackLOG_EVOL_UTIL]="Si",'SERV_NOW dmn_demand'[_BackLOG_EVOL_EstadoGeneral]="Abierto"),'SERV_NOW dmn_demand'[_dv_size - SoloLetra]="S"))),
				    "AbiertosTotal_M", CALCULATE(COUNT('SERV_NOW dmn_demand'[_BackLOG_EVOL_MYMesAño-Abierto]),
				    FILTER('SERV_NOW dmn_demand',and(and('SERV_NOW dmn_demand'[_BackLOG_EVOL_UTIL]="Si",'SERV_NOW dmn_demand'[_BackLOG_EVOL_EstadoGeneral]="Abierto"),'SERV_NOW dmn_demand'[_dv_size - SoloLetra]="M"))),
				    "AbiertosTotal_L", CALCULATE(COUNT('SERV_NOW dmn_demand'[_BackLOG_EVOL_MYMesAño-Abierto]),
				    FILTER('SERV_NOW dmn_demand',and(and('SERV_NOW dmn_demand'[_BackLOG_EVOL_UTIL]="Si",'SERV_NOW dmn_demand'[_BackLOG_EVOL_EstadoGeneral]="Abierto"),'SERV_NOW dmn_demand'[_dv_size - SoloLetra]="L"))),
				    "AbiertosTotal_XL", CALCULATE(COUNT('SERV_NOW dmn_demand'[_BackLOG_EVOL_MYMesAño-Abierto]),
				    FILTER('SERV_NOW dmn_demand',and(and('SERV_NOW dmn_demand'[_BackLOG_EVOL_UTIL]="Si",'SERV_NOW dmn_demand'[_BackLOG_EVOL_EstadoGeneral]="Abierto"),'SERV_NOW dmn_demand'[_dv_size - SoloLetra]="XL"))),
				    "AbiertosTotal_XXL", CALCULATE(COUNT('SERV_NOW dmn_demand'[_BackLOG_EVOL_MYMesAño-Abierto]),
				    FILTER('SERV_NOW dmn_demand',and(and('SERV_NOW dmn_demand'[_BackLOG_EVOL_UTIL]="Si",'SERV_NOW dmn_demand'[_BackLOG_EVOL_EstadoGeneral]="Abierto"),'SERV_NOW dmn_demand'[_dv_size - SoloLetra]="XXL"))))
				```

	annotation PBI_Id = d6f9f6a8f7fd4c77b6da3e7ca065201b

