	column Util_AbiertosTotal = if('_backlog_EVOLUTIVOS_SERV_NOW dmn_demand'[AbiertosTotal]=BLANK(), 0, '_backlog_EVOLUTIVOS_SERV_NOW dmn_demand'[AbiertosTotal])
		formatString: 0
		lineageTag: a26a52c9-bb9b-48ba-a5e2-7a86490749ea
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Fecha = DATE('_backlog_EVOLUTIVOS_SERV_NOW dmn_demand'[Año], '_backlog_EVOLUTIVOS_SERV_NOW dmn_demand'[NroMes], 1)
		formatString: Short Date
		lineageTag: f9aaa9a3-a84f-4878-834f-2cc53a7b5d86
