		lineageTag: 0d6e6ffa-8a51-4521-9441-bc45cb924926
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Estado proyectos desviados en alcance' = IF('Ev1&2'[% comparativo entre teorico y real]<=0.10,"Entre 0 y 10%",IF('Ev1&2'[% comparativo entre teorico y real]<=0.25,"Entre 11 y 25%",IF('Ev1&2'[% comparativo entre teorico y real]>0.25,">25%","Sin avance")))
