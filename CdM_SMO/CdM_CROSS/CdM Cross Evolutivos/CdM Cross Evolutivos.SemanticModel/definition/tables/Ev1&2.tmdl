		summarizeBy: none
		sourceColumn: dv_demand

		annotation SummarizationSetBy = Automatic

	column Ev1 = if(and(and(related(Demandas[EvTipo1])=TRUE(), 'Ev1&2'[dv_u_project_type]="Project"), CONTAINS(Aplicaciones, Aplicaciones[Aplicación de Negocio],'Ev1&2'[dv_cmdb_ci_business_app])), TRUE(), FALSE())
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 9de32ee0-a632-4353-a0ef-b5a5c94c017b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Ev2 = if(and(and(related(Demandas[EvTipo2])=TRUE(),'Ev1&2'[dv_u_project_type]="Multitask Enhancement"),CONTAINS(Aplicaciones, Aplicaciones[Aplicación de Negocio],'Ev1&2'[dv_cmdb_ci_business_app])), TRUE(), FALSE())
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 5b6628c1-ccb8-4def-88ac-296edcf7c11e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Ev1&2Aux1 = CONCATENATE('Ev1&2'[Ev1], 'Ev1&2'[Ev2])
		lineageTag: 70c05c12-a4db-474d-8bd2-ab04320a2529
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Ev1&2Aux2 = SUBSTITUTE('Ev1&2'[Ev1&2Aux1], "TRUEFALSE", "Proyecto")
