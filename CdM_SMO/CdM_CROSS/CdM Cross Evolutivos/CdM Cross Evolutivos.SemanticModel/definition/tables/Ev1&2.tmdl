	column 'Dias de avance teorico' = ```
			IF('Ev1&2'[end_date]<TODAY(), 
			(DATEDIFF('Ev1&2'[end_date], 'Ev1&2'[start_date],DAY)*(-1)), 
			(DATEDIFF(TODAY(),'Ev1&2'[start_date],DAY)*(-1)))
			```
		formatString: 0
		lineageTag: 1e9718f2-b780-4d4d-8b9f-b1b9efe9584f
