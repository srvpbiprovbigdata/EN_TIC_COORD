		lineageTag: bd341d8f-a1c8-4374-a4b2-45ff373afd0b
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column '% comparativo entre teorico y real' = ('Ev1&2'[% avance teorico] - ('Ev1&2'[percent_complete]/100))
