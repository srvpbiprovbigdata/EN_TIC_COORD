	column Demanda_con_iniciativa = IF(OR([Iniciativa_generada] = "0",[Iniciativa_generada] = ""),FALSE(),TRUE())
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: e71a44e2-cca4-4f33-8681-2281ece5482a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Demanda_con_planificación = not(ISBLANK([Fecha inicio]))
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: ee82566c-3c3a-4d82-8b71-8065bb950426
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Iniciativa_planificada = IF(AND([Demanda_con_iniciativa]=TRUE(),[Demanda_con_planificación]=TRUE()),TRUE(),FALSE())
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 7dfd27f0-85b3-47d8-bc06-4f673ae80a69
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Iniciativa_descripcion = [Iniciativa_generada] & " - " & [Descripcion]
