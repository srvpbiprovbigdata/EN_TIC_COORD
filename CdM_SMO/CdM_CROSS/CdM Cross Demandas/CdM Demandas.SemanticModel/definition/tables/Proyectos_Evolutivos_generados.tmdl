	partition Proyectos_Evolutivos_generados = calculated
		mode: import
		source =
				
				SELECTCOLUMNS('Traza_Demandas',
				 "ID", 'Traza_Demandas'[number],
				 "Proyecto generado", 'Traza_Demandas'[Proyecto_generado],
				 "Descripción proyecto", RELATED(pm_project[short_description]),
				 "F.inicio proyecto", RELATED(pm_project[start_date]),
				 "F.fin proyecto", RELATED(pm_project[end_date]),
				 "Evolutivo generado", 'Traza_Demandas'[Evolutivo_generado],
				 "Descripción evolutivo", RELATED(rm_enhancement[short_description]),
				 "F.inicio evolutivo", RELATED(rm_enhancement[start_date]),
				 "F.fin evolutivo", RELATED(rm_enhancement[end_date]),
				 "Traza_demanda", 'Traza_Demandas'[Traza_demanda],
				 "% Proyecto completo", RELATED('pm_project'[percent_complete]),
				 "% Evolutivo completo", RELATED('rm_enhancement'[percent_complete])
				)

	annotation PBI_Id = 5177f2539c0240b88c62501f26b75e24

