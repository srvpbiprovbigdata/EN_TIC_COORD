	partition Backlog_demandas_abierto = calculated
		mode: import
		source = ```
				
				    SELECTCOLUMNS(
				        'dmn_demand',
				        "1 - Number", dmn_demand[number],
				        "2 - Estado", dmn_demand[dv_state],
				        "3 - MesAño", dmn_demand[MesAño],
				        "4 - NroMes", dmn_demand[opened_at].[NroMes], 
				        "5 - Año", dmn_demand[opened_at].[Año],
				        "6 - Porfolio", dmn_demand[dv_portfolio],
				        "7 - Prioridad", dmn_demand[dv_priority],
				        "8 - Tallaje", dmn_demand[Tallaje],
				        "9 - Presupuesto", dmn_demand[u_total_budget],
				        "10 - Tipo", "Abiertas"
				            )
				```

	annotation PBI_Id = b738e377f8104d30933ff870fa1f1fa4

