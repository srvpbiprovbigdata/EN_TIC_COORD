table Backlog_demandas
	lineageTag: 369896eb-382b-4e3a-9bc5-58d4656d793c

	measure abiertas_este_mes = COUNTROWS(FILTER(Backlog_demandas, [10 - Tipo] = "Abiertas"))
		formatString: 0
		lineageTag: 428c8092-8bd0-4112-9140-3ad1244c6543

	measure cerradas_este_mes = COUNTROWS(FILTER(Backlog_demandas, [10 - Tipo] = "Cerradas"))
		formatString: 0
		lineageTag: e72c735e-7c27-4065-9672-42fbc1fe64bf

	measure Presupuesto_abierto_este_mes =
			CALCULATE(
			    SUM('Backlog_demandas'[9 - Presupuesto]),
			    'Backlog_demandas'[10 - Tipo] = "Abiertas"
			)
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: fd6e0872-3c41-472c-b390-5175398621a6

	measure Presupuesto_cerrado_este_mes =
			CALCULATE(
			    SUM('Backlog_demandas'[9 - Presupuesto]),
			    'Backlog_demandas'[10 - Tipo] = "Cerradas"
			)
		lineageTag: 573fb1c9-4eae-4971-82fc-b531a465bee2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Backlog_demandas_acumulado = ```
			
			VAR MesActual = MAX('Backlog_demandas'[Fecha])
			RETURN
			    CALCULATE(
			        COUNTROWS('Backlog_demandas'),
			        FILTER(
			            ALLEXCEPT('Backlog_demandas', 'Backlog_demandas'[2 - Estado],'Backlog_demandas'[6 - Porfolio] , Backlog_demandas[7 - Prioridad],Backlog_demandas[8 - Tallaje]),
			            'Backlog_demandas'[Fecha] < MesActual &&
			            'Backlog_demandas'[10 - Tipo] = "Abiertas"
			        )
			    ) - 
			    CALCULATE(
			        COUNTROWS('Backlog_demandas'),
			        FILTER(
			            ALLEXCEPT('Backlog_demandas', 'Backlog_demandas'[2 - Estado],'Backlog_demandas'[6 - Porfolio] , Backlog_demandas[7 - Prioridad],Backlog_demandas[8 - Tallaje]),
			            'Backlog_demandas'[Fecha] < MesActual &&
			            'Backlog_demandas'[Fecha] >= DATE(2019,12,1) &&
			            'Backlog_demandas'[10 - Tipo] = "Cerradas"           
			        )
			    )
			```
		formatString: 0
		lineageTag: bab71353-da3e-44d9-9fce-afa042e2c23d

	measure Valores_backlog = [Backlog_demandas_acumulado] - [cerradas_este_mes]
		formatString: 0
		lineageTag: d826dd7e-a3e5-442d-ba3c-755cbdca9174

	measure Backlog_presupuesto_acumulado = ```
			
			VAR MesActual = MAX('Backlog_demandas'[Fecha])
			RETURN
			    CALCULATE(
			        SUM('Backlog_demandas'[9 - Presupuesto]),
			        FILTER(
			            ALLEXCEPT('Backlog_demandas', 'Backlog_demandas'[2 - Estado],'Backlog_demandas'[6 - Porfolio] , 'Backlog_demandas'[7 - Prioridad],'Backlog_demandas'[8 - Tallaje]),
			            'Backlog_demandas'[Fecha] < MesActual &&
			            'Backlog_demandas'[10 - Tipo] = "Abiertas"
			        )
			    ) - 
			    CALCULATE(
			        SUM('Backlog_demandas'[9 - Presupuesto]),
			        FILTER(
			            ALLEXCEPT('Backlog_demandas', 'Backlog_demandas'[2 - Estado],'Backlog_demandas'[6 - Porfolio] , 'Backlog_demandas'[7 - Prioridad],'Backlog_demandas'[8 - Tallaje]),
			            'Backlog_demandas'[Fecha] < MesActual &&
			            'Backlog_demandas'[Fecha] >= DATE(2019,12,1) &&
			            'Backlog_demandas'[10 - Tipo] = "Cerradas" 
			            
			        )
			    )
			```
		lineageTag: 14734f56-9095-42bb-a35a-dbd7f6a67c06

		annotation PBI_FormatHint = {"isGeneralNumber":true}

