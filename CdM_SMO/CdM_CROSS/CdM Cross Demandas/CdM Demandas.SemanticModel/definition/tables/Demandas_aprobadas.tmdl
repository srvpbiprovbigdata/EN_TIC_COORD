	partition Demandas_aprobadas = calculated
		mode: import
		source =
				SELECTCOLUMNS('dmn_demand',
				"1 - Number", 'dmn_demand'[number],
				"2 - Tipo", "Aprobada",
				"3 - Fecha", 'dmn_demand'[u_approved_date - Copia],
				"4 - Año", 'dmn_demand'[u_approved_date - Copia].[Año],
				"5 - Mes", 'dmn_demand'[u_approved_date - Copia].[NroMes],
				"6 - Porfolio", 'dmn_demand'[dv_portfolio],
				"7 - Estado", dmn_demand[dv_state],
				"8 - Prioridad", dmn_demand[dv_priority],
				"9 - Tallaje", dmn_demand[Tallaje]
				)

