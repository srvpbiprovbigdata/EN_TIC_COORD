	column PresupuestoTotalMes =
			
			CALCULATE(
			    SUMX(
			        SUMMARIZE(
			            'dmn_demand',
			            'dmn_demand'[MesAño],
			            "Presupuesto por MesAño", SUM('dmn_demand'[capital_budget])
			        ),
			        [Presupuesto por MesAño]
			    )
			)
		lineageTag: e3da51e1-8dc6-49a2-a266-4edc7287643d
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Duracion =
			
			IF(
			    OR(
			        [dv_state] = "Completado",
			        [dv_state] = "Rechazado"
			    ),
			    DATEDIFF([opened_at], [closed_at], DAY),
			    BLANK()
			)
