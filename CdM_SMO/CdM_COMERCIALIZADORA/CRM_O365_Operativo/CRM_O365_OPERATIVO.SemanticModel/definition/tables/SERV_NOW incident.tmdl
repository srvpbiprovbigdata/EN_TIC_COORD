	column Lunes_Anterior_abierto =
			
			VAR DiaSemana = WEEKDAY('SERV_NOW incident'[opened_at], 2)  -- 2 hace que la semana empiece el lunes (Lunes = 1, Domingo = 7)
			VAR FechaInicio = 'SERV_NOW incident'[opened_at]
			RETURN
			    IF(
			        DiaSemana = 1,  -- Si es lunes, la fecha no cambia
			        FechaInicio,
			        FechaInicio - DiaSemana + 1  -- Si no es lunes, retrocede al lunes anterior
			    )
		formatString: Short Date
		lineageTag: 9a80feac-70d1-4003-b013-1a18b87d66cd
		summarizeBy: none

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column Lunes_Anterior_cerrada =
			
			VAR DiaSemana = WEEKDAY('SERV_NOW incident'[closed_at], 2)  -- 2 hace que la semana empiece el lunes (Lunes = 1, Domingo = 7)
			VAR FechaInicio = 'SERV_NOW incident'[closed_at]
			var Fecha=
			    IF(
			        DiaSemana = 1,  -- Si es lunes, la fecha no cambia
			        FechaInicio,
			        FechaInicio - DiaSemana + 1  -- Si no es lunes, retrocede al lunes anterior
			    )
			RETURN IF(ISBLANK('SERV_NOW incident'[closed_at]),BLANK(),Fecha)
		formatString: Short Date
		lineageTag: a27b132f-c379-43c6-aecb-38df28a04467
		summarizeBy: none

