			VAR FechaHoy = TODAY()
			VAR SemanaActual = WEEKNUM(FechaHoy, 2)
			VAR AnioActual = YEAR(FechaHoy)
			VAR SemanaAnterior = IF(SemanaActual = 1, 52, SemanaActual - 1)
			VAR AnioAnterior = IF(SemanaActual = 1, AnioActual - 1, AnioActual)
			RETURN
			COALESCE(
			    CALCULATE(
