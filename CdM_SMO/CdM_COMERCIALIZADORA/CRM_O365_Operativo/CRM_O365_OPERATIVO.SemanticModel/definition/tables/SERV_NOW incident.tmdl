	column Incidencia_Relevante = ```
			
			VAR FechaLimite = TODAY() - 14
			RETURN
			IF(
			    'SERV_NOW incident'[active] = TRUE()
			    || 'SERV_NOW incident'[opened_at] >= FechaLimite
			    || 'SERV_NOW incident'[closed_at] >= FechaLimite
			    || 'SERV_NOW incident'[resolved_at] >= FechaLimite,
			    "Sí",
			    "No"
			)
			
			```
		lineageTag: 35939057-ad34-4cbc-aa9d-4a9ee876c7e7
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition 'SERV_NOW incident' = m
		mode: import
		source =
				let
