			defaultHierarchy: LocalDateTable_1b46fa84-2d7f-4c22-9fc6-23625de78656.'Jerarquía de fechas'

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column Primer_Dia_Mes_abierto = ```
			
			VAR FechaInicio = 'SERV_NOW incident'[opened_at]
			VAR MesActual = MONTH(FechaInicio)  -- Obtiene el mes de la fecha de apertura
			VAR AnoActual = YEAR(FechaInicio)  -- Obtiene el año de la fecha de apertura
			RETURN 
			    DATE(AnoActual, MesActual, 1)  -- Devuelve el primer día del mes actual
			
			```
		formatString: Short Date
		lineageTag: f35bc3a0-677c-4a55-93c7-7b9300c51573
		summarizeBy: none

		variation Variación
			isDefault
			relationship: 85c6e606-62ff-42b7-95e4-159adbf6e97d
			defaultHierarchy: LocalDateTable_99bdc36d-0ea7-4df4-8249-62abea8c6c7a.'Jerarquía de fechas'

		annotation SummarizationSetBy = Automatic

	column Primer_Dia_Mes_Cerrado = ```
			
			VAR FechaCierre = 'SERV_NOW incident'[closed_at]  -- Referencia a la fecha de cierre
			VAR FechaInicio = IF(NOT(ISBLANK(FechaCierre)), DATEVALUE(FechaCierre), BLANK())  -- Si la fecha de cierre no está en blanco, convierte a solo fecha
			VAR MesActual = IF(NOT(ISBLANK(FechaInicio)), MONTH(FechaInicio), BLANK())  -- Obtiene el mes si la fecha no está en blanco
			VAR AnoActual = IF(NOT(ISBLANK(FechaInicio)), YEAR(FechaInicio), BLANK())  -- Obtiene el año si la fecha no está en blanco
			RETURN 
			    IF(
			        NOT(ISBLANK(FechaInicio)),  -- Si la fecha no está en blanco
			        DATE(AnoActual, MesActual, 1),  -- Devuelve el primer día del mes
			        BLANK()  -- Si la fecha está en blanco, devuelve BLANK()
			    )
			
			
			```
		formatString: Short Date
		lineageTag: 1ba04542-1daa-496a-8910-69f11380847b
		summarizeBy: none

		variation Variación
			isDefault
			relationship: bd140cee-e67b-4e45-ac46-c90f91263e9f
			defaultHierarchy: LocalDateTable_f2878cf3-e7c3-49a1-8f82-7882eaa5b5ec.'Jerarquía de fechas'

		annotation SummarizationSetBy = Automatic

