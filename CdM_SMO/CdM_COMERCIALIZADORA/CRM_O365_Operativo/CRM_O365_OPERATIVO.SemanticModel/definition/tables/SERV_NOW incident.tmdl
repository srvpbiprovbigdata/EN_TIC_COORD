		lineageTag: 4aa2f8a9-a3d2-495a-9162-22bc00dc0787

	measure Semana_Anterior = ```
			
			VAR SemanaActual = WEEKNUM(TODAY(), 2)  -- Semana actual
			VAR SemanaAnterior = IF(SemanaActual = 1, 52, SemanaActual - 1)  -- Si la semana actual es 1, la anterior será 52
			RETURN SemanaAnterior
			
			```
		formatString: 0
		lineageTag: cee7d59e-f1db-46c6-a880-59a5fa5a7e72

	measure 'Semana_anterior total' = "Total semana " & [Semana_Anterior]
		lineageTag: 974541b9-5406-4cb5-b330-c9f9d84f2591

	measure IncidenciasAbiertas_SemanaAnterior = ```
			
			VAR FechaHoy = TODAY()
			VAR SemanaActual = WEEKNUM(FechaHoy, 2)
			VAR AnioActual = YEAR(FechaHoy)
			VAR SemanaAnterior = IF(SemanaActual = 1, 52, SemanaActual - 1)
			VAR AnioAnterior = IF(SemanaActual = 1, AnioActual - 1, AnioActual)
			RETURN
			COALESCE(
			    CALCULATE(
			        COUNTROWS('SERV_NOW incident'),
			        WEEKNUM('SERV_NOW incident'[opened_at], 2) = SemanaAnterior,
			        YEAR('SERV_NOW incident'[opened_at]) = AnioAnterior
			    ),
			    0
			)
			
			```
		formatString: 0
		lineageTag: 650299fb-971e-4e2b-aa32-91139497bafd

