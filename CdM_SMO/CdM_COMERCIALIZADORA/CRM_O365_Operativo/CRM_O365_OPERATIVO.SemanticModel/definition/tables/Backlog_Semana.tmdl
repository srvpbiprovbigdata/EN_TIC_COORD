table Backlog_Semana
	lineageTag: b2a3d906-d0c2-46e9-bb93-1fa189f3e53c

	measure abiertas_este_semana = COUNTROWS(FILTER(Backlog_Semana, [5 - Tipo] = "abiertas"))
		formatString: 0
		lineageTag: a1c0ea03-b053-4ff8-8b6c-5f4a0accb059

	measure cerradas_este_semana = COUNTROWS(FILTER(Backlog_Semana, [5 - Tipo] = "cerradas"))
		formatString: 0
		lineageTag: 0a938e73-d397-4525-9154-99a776e21d62

	measure Backlog_semana_acumulado = ```
			
			VAR semanaActual = MAX('Backlog_Semana'[3 - Lunes])
			RETURN
			    CALCULATE(
			        COUNTROWS('Backlog_Semana'),
			        FILTER(
			            ALLEXCEPT('Backlog_Semana', Backlog_Semana[Etiqueta_Semana]),
			            'Backlog_Semana'[3 - Lunes] < semanaActual &&
			            'Backlog_Semana'[5 - Tipo] = "abiertas"
			        )
			    ) - 
			    CALCULATE(
			        COUNTROWS('Backlog_Semana'),
			        FILTER(
			            ALLEXCEPT('Backlog_Semana', Backlog_Semana[Etiqueta_Semana]),
			            'Backlog_Semana'[3 - Lunes] < semanaActual &&
			            'Backlog_Semana'[3 - Lunes] >= DATE(2023,1,1) &&
			            'Backlog_Semana'[5 - Tipo] = "cerradas"           
			        )
			    )
			```
		formatString: 0
		lineageTag: e324ae8a-a67c-4d3c-b0e7-7f1bf487bf37

	measure Valores_backlog = [abiertas_este_semana] - [cerradas_este_semana]
		formatString: 0
		lineageTag: 49498b18-4f5c-4598-aaca-52a855177ae3

