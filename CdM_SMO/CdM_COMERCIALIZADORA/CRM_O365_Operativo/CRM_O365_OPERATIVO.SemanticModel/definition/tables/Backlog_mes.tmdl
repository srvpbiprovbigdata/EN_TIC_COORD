table Backlog_mes
	lineageTag: f6c7e5d3-a824-4d7c-add3-957a75b32d63

	measure abiertas_este_mes = COUNTROWS(FILTER(Backlog_mes, [5 - Tipo] = "abiertas"))
		formatString: 0
		lineageTag: 87a7d9f9-c2d7-487b-b2bd-1be9267063e0

	measure cerradas_este_mes = COUNTROWS(FILTER(Backlog_mes, [5 - Tipo] = "cerradas"))
		formatString: 0
		lineageTag: 2a4be519-904f-4945-8702-adcc5ce506e9

	measure Backlog_mes_acumulado = ```
			
			VAR mesActual = MAX('Backlog_mes'[3 - mes])
			RETURN
			    CALCULATE(
			        COUNTROWS('Backlog_mes'),
			        FILTER(
			            ALLEXCEPT('Backlog_mes', Backlog_mes[4 - Subcategoría], Backlog_mes[1 - Number]),
			            'Backlog_mes'[3 - mes] < mesActual &&
			            'Backlog_mes'[5 - Tipo] = "abiertas"
			        )
			    ) - 
			    CALCULATE(
			        COUNTROWS('Backlog_mes'),
			        FILTER(
			            ALLEXCEPT('Backlog_mes', Backlog_mes[4 - Subcategoría],Backlog_mes[1 - Number]),
			            'Backlog_mes'[3 - mes] < mesActual &&
			            'Backlog_mes'[3 - mes] >= DATE(2023,1,1) &&
			            'Backlog_mes'[5 - Tipo] = "cerradas"           
			        )
			    )
			```
		formatString: 0
		lineageTag: f587fd4b-5290-479c-8033-d16b70e5bfdb

