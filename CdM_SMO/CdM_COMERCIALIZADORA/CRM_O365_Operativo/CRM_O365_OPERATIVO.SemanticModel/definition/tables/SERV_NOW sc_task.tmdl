		annotation SummarizationSetBy = Automatic

	column Primer_Dia_Mes_cerrado_task = ```
			
			VAR FechaCierre = 'SERV_NOW sc_task'[closed_at]
			VAR FechaSolo = IF(NOT(ISBLANK(FechaCierre)), DATEVALUE(FechaCierre), BLANK())
			VAR MesActual = IF(NOT(ISBLANK(FechaSolo)), MONTH(FechaSolo), BLANK())
			VAR AnoActual = IF(NOT(ISBLANK(FechaSolo)), YEAR(FechaSolo), BLANK())
			RETURN 
			    IF(
			        NOT(ISBLANK(FechaSolo)),
			        DATE(AnoActual, MesActual, 1),
			        BLANK()
			    )
			
			```
		formatString: General Date
