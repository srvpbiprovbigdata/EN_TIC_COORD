	column Primer_Dia_Mes_abierto_task = ```
			
			VAR FechaInicio = 'SERV_NOW sc_task'[opened_at]
			VAR MesActual = MONTH(FechaInicio)
			VAR AnoActual = YEAR(FechaInicio)
			RETURN
			    IF(
			        NOT(ISBLANK(FechaInicio)),
			        DATE(AnoActual, MesActual, 1),
			        BLANK()
			    )
			
			```
		formatString: General Date
		lineageTag: d43963d2-3014-41b8-b34d-48e7a00425d9
		summarizeBy: none

		variation Variación
			isDefault
