		    #"Valor reemplazado" = Table.ReplaceValue(
		#"Tipo cambiado", 
		each [Valor],
		each if [Valor] = "Closed Skipped" then "Cerrado omitido" 
		else if [Valor] = "Work in Progress" then "En curso"
		else if [Valor] = "On hold" then "En espera"
		else if [Valor] = "Canceled" then "Cancelado"
		else if [Valor] = "Closed Complete" then "Cerrado completo"
		else if [Valor] = "Closed Incomplete" then "Cerrado incompleto"
		else if [Valor] = "Open" then "Abierto"
		else [Valor],
		Replacer.ReplaceValue,{"Valor"}
		),
		    #"Duración por horas" = Table.AddColumn(#"Valor reemplazado", "Duración por horas", each [Duración]/3600),
		    #"Inicio sin hora" = Table.AddColumn(#"Duración por horas", "Inicio sin hora", each [Inicio]),
