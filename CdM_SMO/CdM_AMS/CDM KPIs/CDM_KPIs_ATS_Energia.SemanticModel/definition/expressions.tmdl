		    #"Motivo espera" = Table.AddColumn(#"Tipo cambiado1", "Motivo espera", each if [Valor] = "En espera" then [Motivo pendiente] else null),
		    #"Columnas quitadas" = Table.RemoveColumns(#"Motivo espera",{"Motivo pendiente"}),
		    #"Valor reemplazado1" = Table.ReplaceValue(#"Columnas quitadas","",null,Replacer.ReplaceValue,{"Motivo espera"})
		in
		    #"Valor reemplazado1"
		```
