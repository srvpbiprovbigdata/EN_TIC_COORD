expression 'Incidencias 2020 - Energía' = ```
		let
		    URL = sharepointSource & Entorno & sharepointSource2 & incidencias,
		    Origen = Excel.Workbook(Web.Contents(URL & "Incidencias Portfolio energía-2020" & xlsx), null, true),
		    #"Se expandió Data" = Origen{[Item="Page 1",Kind="Sheet"]}[Data],
		    #"Encabezados promovidos" = Table.PromoteHeaders(#"Se expandió Data", [PromoteAllScalars=true]),
		    #"Tipo cambiado" = Table.TransformColumnTypes(#"Encabezados promovidos",{{"Número", type text}, {"Descripción", type text}, {"Elemento de configuración", type text}, {"Estado de la incidencia", type text}, {"Motivo de espera", type text}, {"Grupo de asignación", type text}, {"Prioridad", type text}, {"Valor", type text}, {"Inicio", type datetime}, {"Fin", type datetime}, {"Duración", Int64.Type}, {"Nombre", type text}, {"Subcategoría", type text}, {"Volver a abrir recuento", Int64.Type}}),
		    #"Valor reemplazado" = Table.ReplaceValue(
		#"Tipo cambiado", 
		each [Valor],
		each if [Valor] = "New" then "Nuevo" 
		else if [Valor] = "In progress" then "En curso"
		else if [Valor] = "On hold" then "En espera"
		else if [Valor] = "Canceled" then "Cancelado"
		else if [Valor] = "Closed" then "Cerrado"
		else if [Valor] = "Resolved" then "Resuelto"
		else [Valor],
		Replacer.ReplaceValue,{"Valor"}
		),
		    #"Duración por horas" = Table.AddColumn(#"Valor reemplazado", "Duración por horas", each [Duración]/3600),
		    #"Inicio sin horas" = Table.AddColumn(#"Duración por horas", "Inicio sin hora", each [Inicio]),
		    #"Fin sin horas" = Table.AddColumn(#"Inicio sin horas", "Fin sin hora", each [Fin]),
		    #"Tipo cambiado1" = Table.TransformColumnTypes(#"Fin sin horas",{{"Duración por horas", type number}, {"Inicio sin hora", type date}, {"Fin sin hora", type date}}),
		    Reabierto = Table.AddColumn(#"Tipo cambiado1", "Incidencia reabierta", each if [Volver a abrir recuento] = 0 then "No" else if [Volver a abrir recuento] > 0 then "Sí" else null),
		    #"Columnas quitadas" = Table.RemoveColumns(Reabierto,{"Volver a abrir recuento"}),
		    #"Filas filtradas" = Table.SelectRows(#"Columnas quitadas", each ([Nombre] = "Aplicaciones" or [Nombre] = "Aplicaciones de Negocio (Ingeniería, Operación, Ventas...)")),
		    #"Motivo espera" = Table.AddColumn(#"Filas filtradas", "Motivo espera", each if [Valor] = "En espera" then [Motivo de espera] else null),
		    #"Columnas quitadas1" = Table.RemoveColumns(#"Motivo espera",{"Motivo de espera"}),
		    #"Valor reemplazado1" = Table.ReplaceValue(#"Columnas quitadas1","",null,Replacer.ReplaceValue,{"Motivo espera"}),
		    #"Personalizada agregada" = Table.AddColumn(#"Valor reemplazado1", "Valor final", each [Valor] & "" & [Motivo espera]),
		    #"Columnas quitadas2" = Table.RemoveColumns(#"Personalizada agregada",{"Valor final"})
		in
		    #"Columnas quitadas2"
		```
	lineageTag: 5589a693-8fc4-4dd5-ab72-e986ce09af74
	queryGroup: 'Tablas No Modelo'

