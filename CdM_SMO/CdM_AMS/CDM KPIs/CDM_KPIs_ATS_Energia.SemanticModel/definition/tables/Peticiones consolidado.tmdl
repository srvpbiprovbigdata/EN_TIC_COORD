	column 'Último estado' =
			
			
			VAR _lastdate = CALCULATE(MAX('Peticiones consolidado'[Inicio]), ALLEXCEPT('Peticiones consolidado','Peticiones consolidado'[Número]))
			
			RETURN
			    CALCULATE(DISTINCT('Peticiones consolidado'[Valor final]),'Peticiones consolidado'[Inicio] = _lastdate)
		lineageTag: fafce8e5-a034-4a43-8807-db8d0ce999fa
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Motivo espera'
		dataType: string
