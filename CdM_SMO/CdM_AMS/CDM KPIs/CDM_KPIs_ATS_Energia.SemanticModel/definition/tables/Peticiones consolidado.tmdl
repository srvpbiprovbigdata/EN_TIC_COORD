		summarizeBy: none
		sourceColumn: Motivo espera

		annotation SummarizationSetBy = Automatic

	column 'Valor final' = IF(NOT(ISBLANK('Peticiones consolidado'[Motivo espera])), 'Peticiones consolidado'[Valor] & " - " & 'Peticiones consolidado'[Motivo espera], 'Peticiones consolidado'[Valor])
		lineageTag: b0caeecb-893b-4679-86bb-71d6304f7bb0
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

