		summarizeBy: none
		sourceColumn: Motivo espera

		annotation SummarizationSetBy = Automatic

	column 'Valor final' = IF(NOT(ISBLANK('Incidencias consolidado'[Motivo espera])), 'Incidencias consolidado'[Valor] & " - " & 'Incidencias consolidado'[Motivo espera], 'Incidencias consolidado'[Valor])
		lineageTag: 8940e727-68d6-4b22-87bb-0d5a6ca88c11
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

