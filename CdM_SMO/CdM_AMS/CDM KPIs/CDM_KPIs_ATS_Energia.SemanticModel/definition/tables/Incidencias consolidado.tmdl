	partition 'Incidencias consolidado-1e376c73-a892-41bb-a173-948a7f4f0725' = m
		mode: import
		queryGroup: 'Tablas Modelo'
		source =
				let
				    Origen = Table.Combine({#"Incidencias 2020 - Energía", #"Incidencias 2021 - Energía", #"Incidencias 2022 - Energía", #"Incidencias 2020 - ATS", #"Incidencias 2021 - ATS", #"Incidencias 2022 - ATS"}),
				    #"Consultas combinadas" = Table.NestedJoin(Origen, {"Grupo de asignación"}, #"Relación grupo asignación", {"Grupo de asignación"}, "Relación grupo asignación", JoinKind.LeftOuter),
				    #"Se expandió Relación grupo asignación" = Table.ExpandTableColumn(#"Consultas combinadas", "Relación grupo asignación", {"Servicio TIC"}, {"Servicio TIC"}),
				    #"Personalizada agregada" = Table.AddColumn(#"Se expandió Relación grupo asignación", "Concatenado", each if [Servicio TIC] is null then [Subcategoría] else [Subcategoría] & " - " & [Servicio TIC])
				in
				    #"Personalizada agregada"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navegación

