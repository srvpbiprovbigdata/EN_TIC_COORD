	column 'Último estado' =
			
			
			VAR _lastdate = CALCULATE(MAX('Incidencias consolidado'[Inicio]), ALLEXCEPT('Incidencias consolidado','Incidencias consolidado'[Número]))
			
			RETURN
			    CALCULATE(DISTINCT('Incidencias consolidado'[Valor final]),'Incidencias consolidado'[Inicio] = _lastdate)
		lineageTag: 68b8ff96-8f0d-40f6-bdb5-35d2f1bbb2be
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Motivo espera'
		dataType: string
