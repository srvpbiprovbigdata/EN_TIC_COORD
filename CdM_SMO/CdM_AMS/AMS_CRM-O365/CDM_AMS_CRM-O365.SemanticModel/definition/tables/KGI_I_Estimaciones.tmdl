	partition KGI_I_Estimaciones-6c038d24-7398-4a9c-a5f4-fbb4fdfc03ee = m
		mode: import
		queryGroup: 'Tablas Modelo'
		source = ```
				let
				    Origen = #"KGI_I_Estimaciones (stagging)",
				    #"Tipo cambiado" = Table.TransformColumnTypes(Origen,{  {"Prioridad", type text}, {"Tarea", type text}, {"Etapa", type text}, {"Tiempo de negocio restante", Int64.Type}, {"Duración del negocio", Int64.Type}, {"Porcentaje de negocio trascurrido", type number}, {"Hora de inicio", type datetime}, {"Tiempo de pausa", type any}, {"Hora de finalización", type datetime}, {"Grupo de asignación", type text}, {"Infringido", type logical}, {"Hora de infracción", type datetime}, {"Duración", Int64.Type}}),
				    #"Inicio de mes insertado" = Table.AddColumn(#"Tipo cambiado", "Finalización mes", each Date.StartOfMonth([Hora de finalización]), type date),
				    #"Tipo cambiado1" = Table.TransformColumnTypes(#"Inicio de mes insertado",{{"Finalización mes", type date}}),
				    #"Texto en mayúsculas" = Table.TransformColumns(#"Tipo cambiado1",{{"Aplicación de Negocio", Text.Upper, type text}}),
				
				// Homologa prioridades
				
				    #"Columna condicional agregada" = Table.AddColumn(#"Texto en mayúsculas", "Prioridad grupo", each if [Prioridad] = "1 - Crítica" then "Alta" else if [Prioridad] = "2 - Alta" then "Alta" 
				else if [Prioridad] = "3 - Moderada" then "Media" else if [Prioridad] = "4 - Baja" then "Baja" else if [Prioridad] = "5 - Muy Baja" then "Baja" else null, type text),
				    #"Columna condicional agregada1" = Table.AddColumn(#"Columna condicional agregada", "ID_KGI1.1", each if [Prioridad grupo] = "Alta" then "1-1-2-1" else if [Prioridad grupo] = "Alta" then "1-1-2-1" else if [Prioridad grupo] = "Media" then "1-1-2-2" else if [Prioridad grupo] = "Baja" then "1-1-2-3" else null, type text),
				    #"Duración cambiado a Duración SLA" = Table.RenameColumns(#"Columna condicional agregada1",{{"Duración", "Duración SLA"}}),
				    #"Cálculo Duración excedida" = Table.AddColumn(#"Duración cambiado a Duración SLA", "Duración excedida", 
				    each if ([Duración del negocio]-[Duración SLA])<0 then 0 else 
				    ([Duración del negocio]-[Duración SLA])),
				    #"Transformado %_negocio" = Table.TransformColumns(#"Cálculo Duración excedida", {{"Porcentaje de negocio trascurrido", each _ / 100, Percentage.Type}}),
				    #"Consultas combinadas1" = Table.NestedJoin(#"Transformado %_negocio", {"Tarea"}, T_Alegaciones, {"ID"}, "T_Alegaciones", JoinKind.LeftOuter),
				    #"Se expandió T_Alegaciones" = Table.ExpandTableColumn(#"Consultas combinadas1", "T_Alegaciones", {"ID Alegación", "Solicitante", "ANS", "Estado"}, {"T_Alegaciones.ID Alegación", "T_Alegaciones.Solicitante", "T_Alegaciones.ANS", "T_Alegaciones.Estado"}),
				    #"Infringido con alegaciones" = Table.AddColumn( #"Se expandió T_Alegaciones", "Infringido_alegaciones", each if [Infringido] = true and [T_Alegaciones.Estado] = "1 - Aprobada" and [T_Alegaciones.ANS] = "KGI 1-1" then false else [Infringido], Logical.Type),
				    #"Filas filtradas" = Table.SelectRows(#"Infringido con alegaciones", each ([Duración del negocio] <> 62538)),
				    #"Duplicados quitados" = Table.Distinct(#"Filas filtradas", {"Tarea"})
				in
				    #"Duplicados quitados"
				```

