	measure Puntos_proy_evo = ```
			
			
			VAR _servicio = SELECTEDVALUE(Maestro_tipo_proyecto[Servicio])
			
			
			
			RETURN 
			
			IF(_servicio = 1 || _servicio = 2,
			    CALCULATE(AVERAGE('Parámetros - Pesos'[Peso del KGI dentro del servicio (%)]),
			            FILTER('Parámetros - Pesos','Parámetros - Pesos'[Id_Servicio] = _servicio)
			            )
			        ,IF(_servicio = 0
			            ,CALCULATE(AVERAGE('Parámetros - Pesos'[Peso del KGI dentro del servicio (%)]))
			                ,BLANK()
			            )
			)
			```
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: 28bd2604-f4c4-45fc-84bc-1a32b9fb4e2d

