	measure LB_Card_desv_natural = ```
			
			
			VAR _tipologia = SELECTEDVALUE(LB_Pivot[LB tipo.2])
			VAR _anioContrato = SELECTEDVALUE(Fechas[Año])
			VAR _maxFecha = CALCULATE(MAX(LB_Pivot[Período]), LB_Pivot[LB tipo.1] = "LB Real")
			VAR _calcVol = CALCULATE(IFERROR([LB_Global_Real_Acumulado] / [LB_Card_plan],0)  , FILTER(Fechas,Fechas[Año] = _anioContrato), LB_Pivot[Período] <= _maxFecha)
			VAR _calcVolBlank = COALESCE(_calcVol,0)
			VAR _calcEur = CALCULATE(IFERROR([LB_Global_Real_Acumulado] - [LB_Card_plan],0)  , FILTER(Fechas,Fechas[Año] = _anioContrato), LB_Pivot[Período] <= _maxFecha)
			VAR _calcEurBlank = _calcEur + 0
			
			RETURN
			
			IF(_tipologia = "€",
			    CONVERT(_calcEurBlank * -1,CURRENCY),
			    CONVERT(_calcVolBlank * 100,INTEGER) & " %" 
			)
			```
