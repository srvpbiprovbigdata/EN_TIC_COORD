	measure 01_Total_Puntos_Obtenidos_antiguo = ```
			
			
			VAR _iniContrato = DATE(2023,6,1)
			VAR _fechaIni = CALCULATE(MAX(Fechas[Date_1er_día_mes]),REMOVEFILTERS(Maestro_tipo_proyecto[Proyectos / Evolutivos]))
			VAR _ptos =
			[KGI_1.1_Ptos_Serv] +
			[KGI_1.2_Ptos_Serv] + 
			[KGI_1.3_Ptos_Serv] + 
			[KGI_1.4_Ptos_Serv] + 
			[KGI_1.5_Ptos_Serv] + 
			[KGI_1.6_Ptos_Serv]  +
			[KGI_1.2_Ptos_Proy] +
			[KGI_1.3_Ptos_Proy] + 
			[KGI_1.4_Ptos_Proy] +
			[KGI_1.5_Ptos_Proy] +
			[KGI_1.6_Ptos_Proy] +
			[KGI_2.1_Ptos_Serv] + 
			[KGI_2.2_Ptos_Serv] +
			[KGI_2.3_Ptos_Serv] + 
			[KGI_2.4_Ptos_Serv] + 
			[KGI_4.1_Ptos_Serv] + 
			[KGI_4.2_Ptos_Serv] + 
			[KGI_4.3_Ptos_Serv] + 
			  + 25
			 
			
			
			RETURN 
			
			IF(_fechaIni < _iniContrato || _fechaIni > TODAY(),
			    "N/A",
			    _ptos
			)
			```
		lineageTag: 64bbd384-0ca6-44ba-8e28-40a2fe1e34fa

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'KGIs T Umbral Alcanzado' = ```
			
			
			VAR _ptosObtenidos = '0 - Medidas'[01_Total_Puntos_Obtenidos_antiguo]
			
			RETURN
			
			IF(MAX(Fechas[SERVICE_P])=0,
			                            "N/A", 
			                            IF(_ptosObtenidos>=0.9,
			                                "Objetivo",
			                                IF(_ptosObtenidos>=0.5,
			                                    "Admisible",
			                                    IF(_ptosObtenidos>=0,
			                                    "Crítico"
			                                    )
			                                )
			                            ))
			```
		formatString: 0
		lineageTag: f7f04777-d51f-40b1-8668-782a79338cc8

	measure 01_Bonificaciones =
			
			
			
			VAR _KGI17 = IF([KGI_1.7_Cumple] = "Si",
			            0.025,
			            0
			            )
			
			VAR _KGI23 = IF([KGI_2.3_%_Reduc_Real]<=-0.05,
			            0.025,
			            0
			            )
			
			RETURN
			
			_KGI17 + _KGI23
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: 23ca4e1a-f844-453f-a041-f5895135f410

	measure 01_Penalizaciones = ```
			
			
			VAR _date = SELECTEDVALUE(Fechas[Date_1er_día_mes])
			VAR _ptos = IF(_date >= DATE(2021,7,1) && _date <= TODAY(),
			                [01_Total_Puntos_Obtenidos],
			                0
			)
			
			RETURN
			
			IF(_date >= DATE(2021,7,1) && _date <= TODAY(),
			    IF(_ptos > 90,
			        0,
			        IF(_ptos < 50,
			            -0.15,
			            -0.15*((_ptos-90)/(50-90))
			            )
			        ),
			        "N/A"
			    )
			
			/*
			VAR _ptos = IF([01_Total_Puntos_Obtenidos] = "N/A",
			                0,
			                [01_Total_Puntos_Obtenidos]
			)
			
			VAR _penal = IF(100 - _ptos > 15,
			                         0.15,
			                        (100 - _ptos) / 100
			)
			
			VAR _date = SELECTEDVALUE(Fechas[Date_1er_día_mes])
			
			RETURN 
			
			IF(_date >= DATE(2021,6,1) && _date <= TODAY()
			    ,IF([01_Total_Puntos_Obtenidos] > 99.99,
			        0,
			        -_penal
			        )
			    ,"N/A"
			)*/
			```
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: 06433ad6-7227-40f9-b3f5-79bffda24cc7

	measure 01_Total_sobre_fact = ```
			
			
			VAR _date = SELECTEDVALUE(Fechas[Date_1er_día_mes])
			
			RETURN
			
			IF(_date >= DATE(2021,6,1) && _date <= TODAY()
			    ,[01_Bonificaciones] + [01_Penalizaciones]
			    ,"N/A"
			)
			
			
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 29f3aafe-f629-4f92-8777-e4e14919538e

