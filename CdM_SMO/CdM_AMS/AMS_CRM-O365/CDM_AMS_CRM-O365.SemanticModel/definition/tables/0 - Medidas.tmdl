	measure LB_Card_desv = ```
			
			
			VAR _tipologia = SELECTEDVALUE(LB_Pivot[LB tipo.2])
			VAR _anioContrato = SELECTEDVALUE(Fechas[AñoContrato])
			VAR _maxFecha = CALCULATE(MAX(LB_Pivot[Período]), LB_Pivot[LB tipo.1] = "LB Real")
			VAR _calcVol = CALCULATE(IFERROR([LB_Global_Real_Acumulado] / [LB_Card_plan],0)  , FILTER(Fechas,Fechas[AñoContrato] = _anioContrato), LB_Pivot[Período] <= _maxFecha)
			VAR _calcVolBlank = COALESCE(_calcVol,0)
			VAR _calcEur = CALCULATE(IFERROR([LB_Global_Real_Acumulado] - [LB_Card_plan],0)  , FILTER(Fechas,Fechas[AñoContrato] = _anioContrato), LB_Pivot[Período] <= _maxFecha)
			VAR _calcEurBlank = _calcEur + 0
			
			RETURN
			
			IF(_tipologia = "€",
			    CONVERT(_calcEurBlank * -1,CURRENCY),
			    CONVERT(_calcVolBlank * 100,INTEGER) & " %" 
			
			//    FORMAT(_calcEurBlank * -1, "#,#€"),
			//   per FORMAT(_calcVolBlank, "Percent")
			)
			```
		displayFolder: LB
		lineageTag: 527f399e-4dc9-4c27-9b05-060e37b76ce4

