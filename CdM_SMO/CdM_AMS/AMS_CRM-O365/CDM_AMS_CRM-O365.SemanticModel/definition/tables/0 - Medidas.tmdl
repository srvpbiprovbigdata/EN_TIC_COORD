	measure LB_Global_Plan_Acumulado_Vol = ```
			
			
			VAR _tipologia = SELECTEDVALUE(LB_Pivot[LB tipo.2])
			VAR _anio = SELECTEDVALUE(Fechas[AñoContrato])
			VAR _maxDate = CALCULATE(MAX(LB_Pivot[Período]),FILTER(Fechas,Fechas[AñoContrato] = _anio))
			var _descAmbito = SELECTEDVALUE(LB_Pivot[Descripción Ámbito Servicio])
			VAR _switchDesc = SWITCH(_descAmbito, "Correctivo", "LB Comprometida"
			                                    , "Peticiones de Servicio", "LB Comprometida"
			                                    , "Evolutivo", "LB Comprometida")
			VAR _plan = 
			            COALESCE(
			            CALCULATE(SUM(LB_Pivot[Valor]),
			                                    FILTER(ALLSELECTED(LB_Pivot),LB_Pivot[Período]<=_maxDate && LB_Pivot[LB tipo.1] = _switchDesc))
