	measure 01_Neto_Bonif_Penal = ```
			
			
			VAR _fechaCont = [00_fContrato]
			VAR _fechaSel = SELECTEDVALUE(Fechas[Date_1er_día_mes])
			VAR _today = TODAY()
			VAR _bonif =  [01_Bonificaciones_anual_serv_tab] 
			VAR _penal =  [01_Penalizaciones] 
			VAR _categoryValues = VALUES(Fechas[MesNombreComp])
			VAR _calc = IF(_bonif <> "N/A" && _penal <> "N/A"
			                , _bonif + _penal
			                , "N/A"
			                )
			
			VAR _avg = AVERAGEX(_categoryValues,
						            _calc
			                    )
			
			RETURN
			
			IF(_fechaSel >= _fechaCont && _fechaSel <= _today,
			    _avg,
			        "N/A"
			    )
			```
