	measure LB_Desv_Total = ```
			
			
			VAR _tipologia = SELECTEDVALUE(LB_Pivot[LB tipo.2])
			VAR _calcEur =
			
			            COALESCE(
			
			                COALESCE(
			                CALCULATE(SUM(LB_Pivot[Valor]), FILTER(LB_Pivot, LB_Pivot[LB tipo.1] = "LB Esperada"))
			                , CALCULATE(SUM(LB_Pivot[Valor]), FILTER(LB_Pivot, LB_Pivot[LB tipo.1] = "LB Esperada")) 
