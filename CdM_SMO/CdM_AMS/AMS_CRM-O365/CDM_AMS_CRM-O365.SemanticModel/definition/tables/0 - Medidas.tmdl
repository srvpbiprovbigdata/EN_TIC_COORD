	measure 'KGI_1.1_%_Cumplimiento' = ```
			
			
			VAR _cumplimiento = [KGI_1.1_Cumplidas] / [KGI_1.1_Total]
			VAR _fechaUlt = SELECTEDVALUE(Fechas[Date_ult_día_mes])
			VAR _fechaIni = CALCULATE(MAX(Fechas[Date_1er_día_mes]))
			
			RETURN 
			
			IF(_fechaIni >= DATE(2021,06,01) && _fechaIni <= TODAY(),
			    IF([KGI_1.1_Total] >0,
			        _cumplimiento,
			        1
			        ),
			    BLANK()
			)
