	measure 'KGI_1.1_Incumplidas' = ```
			
			
			VAR _incumplidas = CALCULATE([KGI_1.1_Total],
			                                FILTER(KGI_I_Estimaciones,[Infringido] = TRUE()
			                                )
			                            )
			VAR _alegadas = CALCULATE([KGI_1.1_Total],
			                                FILTER(KGI_I_Estimaciones,[Infringido] = TRUE() 
			                                        && KGI_I_Estimaciones[T_Alegaciones.Estado] = "1 - Aprobada" 
			                                        && KGI_I_Estimaciones[T_Alegaciones.ANS] = "KGI 1-1"
			                                )
			                            )
			
			
			RETURN 
			
			_incumplidas - _alegadas
			
			/*
			VAR _incumplidas = CALCULATE([KGI_1.1_Total],
			                                FILTER(KGI_I_Estimaciones,[Infringido] = TRUE() && 
			                                ((KGI_I_Estimaciones[T_Alegaciones.Estado] <> "1 - Aprobado" && KGI_I_Estimaciones[T_Alegaciones.ANS] =                                 "KGI 1-1") 
			                                || KGI_I_Estimaciones[T_Alegaciones.Estado] = BLANK()
			                                || KGI_I_Estimaciones[T_Alegaciones.Estado] = "0 - Pendiente")
			                                )
			                )
			*/
			
			/*
			IF(_Incumplidas > 0,
			    _Incumplidas,
			    0
			    )^
			*/
			```
		formatString: 0
		displayFolder: KGI_1.1
		lineageTag: c5493b68-b716-4037-b597-f88d9039d9be

