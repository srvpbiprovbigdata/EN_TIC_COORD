	measure LB_Card_plan_eur_ajustable = ```
			
			
			VAR _maxDate = SELECTEDVALUE(Fechas[Date_1er_día_mes])
			VAR _selectedYear = SELECTEDVALUE(Fechas[AñoContrato])
			Var _tillapril22 = CALCULATE(SUM('LB € y volumétrica'[LB Comprometida €]), 
			            FILTER('LB € y volumétrica',
			                    'LB € y volumétrica'[LB Real €] <> BLANK()), FILTER(Fechas,Fechas[Date_1er_día_mes] < DATE(2022, 3, 31)))
			
			Var _postapril22 = CALCULATE(SUM('LB € y volumétrica'[LB Comprometida €]), 
			            FILTER('LB € y volumétrica',
			                    'LB € y volumétrica'[LB Real €] <> BLANK()), FILTER(Fechas,Fechas[Date_1er_día_mes] > DATE(2022, 3, 31))
			        )
			RETURN
			
			_tillapril22 + _postapril22
			```
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
