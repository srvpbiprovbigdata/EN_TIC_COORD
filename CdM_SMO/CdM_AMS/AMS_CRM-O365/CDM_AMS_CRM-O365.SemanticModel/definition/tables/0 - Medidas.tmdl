	measure LB_Card_plan = ```
			
			
			VAR _tipologia = SELECTEDVALUE(LB_Pivot[LB tipo.2])
			VAR _maxDate = CALCULATE(MAX('LB_Pivot'[Período]),FILTER(LB_Pivot,LB_Pivot[LB tipo.1] = "LB Real"))--MAX(Fechas[Date])
			VAR _selAmbito = SELECTEDVALUE(LB_Pivot[Descripción Ámbito Servicio])
			VAR _tipo = IF(SELECTEDVALUE(Fechas[AñoContrato])= "Año 1", "LB Esperada", "LB Objetivo 0")
			/*
			IF(_selAmbito IN {"Correctivo", "Evolutivo"}
			    , "LB Esperada"
			    , "LB Esperada"
			)
			*/
			RETURN
			
			
			COALESCE(
			            CALCULATE(SUM('LB_Pivot'[Valor]), 
			                        FILTER('LB_Pivot',
			                                'LB_Pivot'[LB tipo.1] = _tipo && 'LB_Pivot'[LB tipo.2] = _tipologia
			                                && 'LB_Pivot'[Descripción Ámbito Servicio] =_selAmbito
			                                && LB_Pivot[Período] <= _maxDate--&& 'LB € y volumétrica'[LB Real €] <> BLANK())
			                                )
			                    )
			        ,0
			        )
			```
