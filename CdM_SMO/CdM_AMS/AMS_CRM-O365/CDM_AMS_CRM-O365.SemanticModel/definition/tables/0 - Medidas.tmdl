	measure 'KGI_3.4_Cumple' = ```
			
			
			VAR _iniContrato = DATE(2021,6,1)
			VAR _fechaIni = CALCULATE(MAX(Fechas[Date_1er_día_mes]),REMOVEFILTERS(Maestro_tipo_proyecto[Proyectos / Evolutivos]))
			VAR _categoria = SELECTEDVALUE('Parámetros - Pesos'[Categorización])
			VAR _cumple = IF((_categoria = "Alta" && [KGI_3.4_Cump_Real] >= [KGI_3.4_Cump_Obj]) || (_categoria = "Alta" && [KGI_3.4_Total] = 0),
			                "Si",
			                IF((_categoria = "Media" || _categoria = "Baja") && [KGI_3.4_Cump_Real] <= [KGI_3.4_Cump_Obj],
			                    "Si",
			                    "No"
			                    )
			                )
			
			
			/*IF([KGI_3.3_Durac_Real] <= [KGI_3.3_Durac_Max],
			                "Si",
			                "No"
			                )*/
			
			RETURN 
			
			IF(_fechaIni >= _iniContrato && _fechaIni <= TODAY(),
			    _cumple,
			    BLANK()
			)
