	measure LB_color_S2_switch = ```
			
			
			VAR _selectedLB = [LB_volumen]
			VAR _selectedDate = SELECTEDVALUE(Fechas[Date_1er_día_mes])
			VAR _LBesperada = CALCULATE(SUM(LB_Pivot[Valor]), LB_Pivot[Período] = _selectedDate, LB_Pivot[LB tipo.1] = "LB Esperada") 
			VAR _LBobj0 = CALCULATE(SUM(LB_Pivot[Valor]), LB_Pivot[Período] = _selectedDate, LB_Pivot[LB tipo.1] = "LB Objetivo 0") 
			VAR _LBobj1 = CALCULATE(SUM(LB_Pivot[Valor]), LB_Pivot[Período] = _selectedDate, LB_Pivot[LB tipo.1] = "LB Objetivo 1")
			VAR _LBobj2 = CALCULATE(SUM(LB_Pivot[Valor]), LB_Pivot[Período] = _selectedDate, LB_Pivot[LB tipo.1] = "LB Objetivo 2")
			VAR _LBobjmax = CALCULATE(SUM(LB_Pivot[Valor]), LB_Pivot[Período] = _selectedDate, LB_Pivot[LB tipo.1] = "LB Objetivo Máximo")
			
			VAR _rangeLB = IF(_selectedLB < _LBesperada,
			                "LB < Esperada",
			                IF(_selectedLB < _LBobj0,
			                    "LB Esperada",
			                    IF(_selectedLB < _LBobj1,
			                        "LB Objetivo 0",
			                        IF(_selectedLB < _LBobj2,
			                            "LB Objetivo 1",
			                            IF(_selectedLB < _LBobjmax,
			                                "LB Objetivo 2",
			                                "LB Objetivo Máximo"
			                            )
			                        )
			                    )
			                )
			            )
			
			RETURN
			
			SWITCH(_rangeLB, 
			        "LB < Esperada", "#FCB714", 
			        "LB Esperada", "#84b4a4", 
			        "LB Objetivo 0", "#5898a8", 
			        "LB Objetivo 1", "#585878", 
			        "LB Objetivo 2", "#5c5844", 
			        "LB Objetivo Máximo", "#2c5c44"
			        )
			```
		displayFolder: LB
		lineageTag: 8dd1ce49-d2c4-469b-879d-303cdab96694

