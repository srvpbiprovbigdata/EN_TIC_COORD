	measure 01_Total_Puntos_Obtenidos = ```
			
			
			VAR _iniContrato = DATE(2021,7,1)
			VAR _fechaIni = CALCULATE(MAX(Fechas[Date_1er_día_mes]),REMOVEFILTERS(Maestro_tipo_proyecto[Proyectos / Evolutivos]))
			VAR _ptos =
			
			[KGI_1.1_Ptos_Serv] + 
			CALCULATE([KGI_1.2_Ptos_Serv] + 
			            [KGI_1.3_Ptos_Serv] + 
			            [KGI_1.4_Ptos_Serv] + 
			            [KGI_1.5_Ptos_Serv] + 
			           [KGI_1.6_Ptos_Serv], 
			            Maestro_tipo_proyecto, Maestro_tipo_proyecto[Servicio] = 2) +
			CALCULATE( [KGI_1.2_Ptos_Proy] + [KGI_1.1_Ptos_Proy] +
			            [KGI_1.3_Ptos_Proy] +
			            [KGI_1.4_Ptos_Proy] +
			            [KGI_1.5_Ptos_Proy] +
			            [KGI_1.6_Ptos_Proy] ,
			            Maestro_tipo_proyecto, Maestro_tipo_proyecto[Servicio] = 1)+
			[KGI_2.1_Ptos_Serv] + 
			[KGI_2.2_Ptos_Serv] +
			[KGI_2.3_Ptos_Serv] + 
			[KGI_2.4_Ptos_Serv] + 
			[KGI_2.5_Ptos_Serv] +
			[KGI_4.1_Ptos_Serv] + 
			[KGI_4.2_Ptos_Serv] + 
			[KGI_4.3_Ptos_Serv]
			--[KGI_4.4_Ptos_Serv]--  
			
			
			RETURN 
			
			IF(_fechaIni < _iniContrato || _fechaIni > TODAY(),
			    "N/A",
			    _ptos
			)
			```
		lineageTag: c479d3ba-522f-40f9-8b9b-54ffb2b8fe79

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'KGI_1.3_Ptos_Proy' = ```
			
			VAR _date = SELECTEDVALUE(Fechas[Date_1er_día_mes])
			
			VAR _ptos =
			
			IF(_date >= DATE(2021,6,1) && _date <= TODAY()
			    ,CALCULATE([KGI_1.3_Ptos_Obtenidos] * AVERAGE('Parámetros - Pesos'[Peso del servicio en el CdM (%)]),
			                FILTER('Parámetros - Pesos','Parámetros - Pesos'[ID_KGI] = "1-3" 
			                        && 'Parámetros - Pesos'[Id_Servicio] = 1)
			                )  
			    ,BLANK()
			)
			
			
			RETURN
			
			_ptos
			```
