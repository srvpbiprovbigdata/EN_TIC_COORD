	measure LB_Global_Plan_Acumulado_Vol_Natural = ```
			
			
			VAR _tipologia = SELECTEDVALUE(LB_Pivot[LB tipo.2])
			VAR _anio = SELECTEDVALUE(Fechas[Año])
			VAR _maxDate = CALCULATE(MAX(LB_Pivot[Período]),FILTER(Fechas,Fechas[Año] = _anio))//FILTER(LB_Pivot,LB_Pivot[LB tipo.1] = "LB Real"))
			//VAR _volEur = SELECTEDVALUE(LB_Pivot[LB tipo.2])
			var _descAmbito = SELECTEDVALUE(LB_Pivot[Descripción Ámbito Servicio])
			VAR _switchDesc = SWITCH(_descAmbito, "Correctivo", "LB Esperada"
			                                    , "Peticiones de Servicio", "LB Esperada"
			                                    , "Evolutivo", "LB Esperada")
			
			Var _SwitchDesc_Anio2 = SWITCH(_descAmbito, "Correctivo", "LB Objetivo 0"
			                                    , "Peticiones de Servicio", "LB Objetivo 0"
			                                    , "Evolutivo", "LB Objetivo 0")
			VAR _plan = 
			            COALESCE(
			            CALCULATE(SUM(LB_Pivot[Valor]),
			                                    FILTER(ALLSELECTED(LB_Pivot),LB_Pivot[Período]<=_maxDate && LB_Pivot[LB tipo.1] = _switchDesc))
			            ,0)
			
			Var _plan_anio2 = COALESCE(
			            CALCULATE(SUM(LB_Pivot[Valor]),
			                                    FILTER(ALLSELECTED(LB_Pivot),LB_Pivot[Período]<=_maxDate && LB_Pivot[LB tipo.1] = _SwitchDesc_Anio2))
			            ,0)
			Var _Fechas=SELECTEDVALUE(Fechas[Año])
			RETURN 
			IF(_Fechas= 2021, _plan, _plan_anio2)
			
			/*
			VAR _maxDate = CALCULATE(MAX(LB_Pivot[Período]),FILTER(LB_Pivot,LB_Pivot[LB tipo.1] = "LB Real"))
			VAR _volEur = SELECTEDVALUE(LB_Pivot[LB tipo.2])
			VAR _plan = CALCULATE(SUM(LB_Pivot[Valor]),
			            FILTER(ALLSELECTED(LB_Pivot),
			                    LB_Pivot[Período]<=_maxDate 
			                    && LB_Pivot[LB tipo.1] = "LB Esperada" 
			                    && 'LB_Pivot'[LB tipo.2] = _volEur
			                    )
			          )
			RETURN _plan
			*/
			```
