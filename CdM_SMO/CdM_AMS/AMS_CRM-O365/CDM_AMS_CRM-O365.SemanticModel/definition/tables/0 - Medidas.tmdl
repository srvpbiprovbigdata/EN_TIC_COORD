	measure LB_Global_Real_Acumulado_Proy_Tarjeta = ```
			
			 VAR _maxDate = CALCULATE(MAX(LB_Pivot[Período]),ALLCROSSFILTERED(LB_Pivot))
			
			RETURN
			
			CALCULATE(SUM(LB_Pivot[Valor]) ,FILTER(ALLSELECTED(LB_Pivot),LB_Pivot[Período]<_maxDate && LB_Pivot[LB tipo.1] IN {"LB Real"})) 
			+
			CALCULATE(SUM(LB_Pivot[Valor]) ,FILTER(ALLSELECTED(LB_Pivot),LB_Pivot[Período]<=_maxDate && LB_Pivot[LB tipo.1] IN { "LB Proyectado/Reservado"}))
			```
