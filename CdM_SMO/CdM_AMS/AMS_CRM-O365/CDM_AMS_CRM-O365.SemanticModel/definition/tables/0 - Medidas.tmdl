			            ,0
			            )
			
			VAR _calcVol =
			
			        IFERROR(
			
			
			                COALESCE(
			                [LB_Global_Real_Acumulado_Proy_Tarjeta],//CALCULATE(SUM(LB_Pivot[Valor]), FILTER(LB_Pivot, LB_Pivot[LB tipo.1] = "LB Real"), LB_Pivot[LB tipo.2] = "Volumen" ),
