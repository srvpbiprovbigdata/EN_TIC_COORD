		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'KGI_3.4_Ptos_Serv' = ```
			
			VAR _date = SELECTEDVALUE(Fechas[Date_1er_día_mes])
			
			VAR _ptos =
			
			IF(_date >= DATE(2021,6,1) && _date <= TODAY()
			    ,CALCULATE([KGI_3.4_Ptos_Obtenidos] * AVERAGE('Parámetros - Pesos'[Peso del servicio en el CdM (%)]),
			                FILTER('Parámetros - Pesos','Parámetros - Pesos'[ID_KGI] = "3-4")
			                )  
			    ,BLANK()
			)
			
			
			RETURN
			
			_ptos
			```
		displayFolder: KGI_4.4
		lineageTag: bc893b25-8f28-42c3-b010-591528f155ad

