	measure 'KGI_1.1_Duracion' =
			
			VAR VDUR13 = SELECTEDVALUE(KGI_I_Estimaciones[Duración del negocio])
			  RETURN INT
			    (VDUR13/86400)&" Día(s) "&
			    RIGHT("0" & INT(MOD(VDUR13/3600,24)),2)&":"&
			    RIGHT("0" & INT(MOD(VDUR13/60,60)),2)&":"&
