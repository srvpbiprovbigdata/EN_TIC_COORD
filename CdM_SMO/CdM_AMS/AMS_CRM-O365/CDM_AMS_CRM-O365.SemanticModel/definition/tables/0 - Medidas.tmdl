			                                        )
			                                    )
			*/
			VAR _categoryValues = VALUES('Parámetros - Pesos'[Categorización])//SELECTCOLUMNS('Parámetros - Pesos', "Caterorización", 'Parámetros - Pesos'[Categorización])
			VAR _fechaCont = DATE(2021,06,01)
			VAR _fechaIni = CALCULATE(MAX(Fechas[Date_1er_día_mes]))
			VAR _pesoTotal = 
			
			CALCULATE(
			    SUMX(
			            _categoryValues
						,CALCULATE([KGI_1.1_Peso_Obtenido])
				)
			    ,'Parámetros - Pesos'[ID_KGI] = "1-1"
			    )
			    
			RETURN
			
			IF(_fechaIni <= TODAY() && _fechaIni >= _fechaCont
			   ,_pesoTotal
			   ,"N/A"
			    
			)
			
			/*
			IF(_fechaUlt > TODAY() || _fechaIni < DATE(2021,06,01),
			    "N/A",
			    _pesoTotal
