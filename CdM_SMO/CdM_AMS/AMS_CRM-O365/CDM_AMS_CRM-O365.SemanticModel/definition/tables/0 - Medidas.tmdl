	measure LB_Global_Plan_Acumulado_Vol_Proyec = ```
			//[LB_Global_Real_Acumulado] + CALCULATE(sum(LB_Pivot[Valor]), LB_Pivot[LB tipo.1] = "LB Proyectado/Reservado")
			
			VAR _tipologia = SELECTEDVALUE(LB_Pivot[LB tipo.2])
			VAR _anio = SELECTEDVALUE(Fechas[AñoContrato])
			VAR _maxDate = CALCULATE(MAX(LB_Pivot[Período]),FILTER(Fechas,Fechas[AñoContrato] = _anio))//FILTER(LB_Pivot,LB_Pivot[LB tipo.1] = "LB Real"))
			//VAR _volEur = SELECTEDVALUE(LB_Pivot[LB tipo.2])
			var _descAmbito = SELECTEDVALUE(LB_Pivot[Descripción Ámbito Servicio])
			VAR _switchDesc = SWITCH(_descAmbito, "Correctivo", "LB Esperada"
			                                    , "Peticiones de Servicio", "LB Esperada"
			                                    , "Evolutivo", "LB Esperada")
			VAR _plan = 
			            COALESCE(
			            CALCULATE(SUM(LB_Pivot[Valor]),
			                                    FILTER(ALLSELECTED(LB_Pivot),LB_Pivot[Período]<=_maxDate && LB_Pivot[LB tipo.1] IN {_switchDesc, "LB Proyectado/Reservado"}))
			            ,0)
			
			RETURN 
			
			_plan
			```
		lineageTag: f970215f-befd-45f7-930d-bb4efc65a2d5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure LB_Global_Real_Acumulado_Proy = ```
			
			
			VAR _maxDate = CALCULATE(MAX(LB_Pivot[Período]),ALLCROSSFILTERED(LB_Pivot), FILTER(LB_Pivot,LB_Pivot[LB tipo.1] IN {"LB Proyectado/Reservado"}))
			
			RETURN
			
			CALCULATE(SUM(LB_Pivot[Valor]) ,FILTER(ALLSELECTED(LB_Pivot),LB_Pivot[Período]<_maxDate && LB_Pivot[LB tipo.1] IN {"LB Real"})) 
			+
			CALCULATE(SUM(LB_Pivot[Valor]) ,FILTER(ALLSELECTED(LB_Pivot),LB_Pivot[Período]<=_maxDate && LB_Pivot[LB tipo.1] IN { "LB Proyectado/Reservado"}))
			```
