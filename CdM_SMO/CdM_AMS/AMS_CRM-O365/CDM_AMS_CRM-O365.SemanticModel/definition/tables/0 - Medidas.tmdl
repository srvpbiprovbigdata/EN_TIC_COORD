	measure 00_Ptos_Serv_2 = ```
			
			
			VAR _date = SELECTEDVALUE(Fechas[Date_1er_día_mes])
			
			VAR _ptos =
			
			IF(_date >= DATE(2021,6,1) && _date <= TODAY()
			    ,CALCULATE(([KGI_1.1_Ptos_Obtenidos]
			                + [KGI_1.2_Ptos_Obtenidos]
			                + [KGI_1.3_Ptos_Obtenidos]
			                + [KGI_1.4_Ptos_Obtenidos]
			                + [KGI_1.5_Ptos_Obtenidos]
			                + [KGI_1.6_Ptos_Obtenidos])  ,
			                FILTER('Parámetros - Pesos','Parámetros - Pesos'[Id_Servicio] = 2)
			                )   
			    ,BLANK()
			)
			--* AVERAGE('Parámetros - Pesos'[Peso del servicio en el CdM (%)])
			
			RETURN
			
			_ptos
			```
