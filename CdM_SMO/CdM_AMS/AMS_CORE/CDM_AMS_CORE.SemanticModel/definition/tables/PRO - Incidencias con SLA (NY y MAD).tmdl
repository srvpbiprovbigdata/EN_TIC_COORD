	partition 'PRO - Incidencias con SLA (NY y MAD)-0372dffc-56a7-4dc5-b546-b758c41a1f06' = m
		mode: import
		queryGroup: KGIs_II
		source = ```
				let
				    Origen = Excel.Workbook(Web.Contents(sharepointRoot2 & incidenciasSN & xlsx), null, true),
				    #"Page 1_Sheet" = Origen{[Item="Page 1",Kind="Sheet"]}[Data],
				    #"Encabezados promovidos" = Table.PromoteHeaders(#"Page 1_Sheet", [PromoteAllScalars=true]),
				    #"Tipo cambiado" = Table.TransformColumnTypes(#"Encabezados promovidos",{{"Número", type text}, {"Breve descripción", type text}, {"Subcategoría", type text}, {"Prioridad", type text}, {"Abierto", type datetime}, {"Cerrado", type datetime}, {"Fecha de resolución", type datetime}, {"Duración", Int64.Type}, {"Duración real", Int64.Type}, {"Infringido", type logical}, {"Tiempo original de incumplimiento", type datetime}, {"Estado", type text}, {"Estado SLA", type text}, {"Código de cierre", type text}, {"Reabierta", type logical}, {"Tipo de solución", type text}, {"Duración SLA", Int64.Type}, {"Porcentaje de negocio trascurrido", Int64.Type}}),
				
				    #"Appended Query" = Table.Combine({#"Tipo cambiado", #"PRO - Incidencias con SLA (NY)"}),
				    #"Duplicated Column" = Table.DuplicateColumn(#"Appended Query", "Cerrado", "Cerrado - Copy"),
				    #"Tipo cambiado1" = Table.TransformColumnTypes(#"Duplicated Column",{{"Estado", type text}}),
				    #"Calculated Start of Month" = Table.TransformColumns(#"Tipo cambiado1",{{"Cerrado - Copy", Date.StartOfMonth, type datetime}}),
				    #"Extracted Date" = Table.TransformColumns(#"Calculated Start of Month",{{"Cerrado - Copy", DateTime.Date, type date}}),
				
				    #"Renamed Columns" = Table.RenameColumns(#"Extracted Date",{{"Subcategoría", "Sistema"}}),
				    // Se une con las alegaciones que afectarán a todos los KGIs de M.Correctivo (Cambio de criticidad y cambio de estado).
				      
				   #"Consultas combinadas" = Table.NestedJoin(#"Renamed Columns", {"Número"}, #"PRO - Alegaciones del Servicio Todos KGIs", {"ID"}, "PRO - Alegaciones del Servicio Todos KGIs", JoinKind.LeftOuter),
				    #"Se expandió PRO - Alegaciones del Servicio Todos KGIs" = Table.ExpandTableColumn(#"Consultas combinadas", "PRO - Alegaciones del Servicio Todos KGIs", {"ANS", "Estado", "Solicitante", "Acción"}, {"PRO - Alegaciones del Servicio Todos KGIs.ANS", "PRO - Alegaciones del Servicio Todos KGIs.Estado", "PRO - Alegaciones del Servicio Todos KGIs.Solicitante", "PRO - Alegaciones del Servicio Todos KGIs.Acción"}),
				    #"Columnas con nombre cambiado1" = Table.RenameColumns(#"Se expandió PRO - Alegaciones del Servicio Todos KGIs",{{"PRO - Alegaciones del Servicio Todos KGIs.ANS", "ANS"}, {"PRO - Alegaciones del Servicio Todos KGIs.Estado", "Estado_Alegado"}, {"PRO - Alegaciones del Servicio Todos KGIs.Acción", "Acción_ANS"}, {"PRO - Alegaciones del Servicio Todos KGIs.Solicitante", "Solicitante"}}),
				    //Realiza la correción sobre el campo Estado y modificarlo de cancelado a cerrado si la alegación es pedida por el Cliente (Acciona).
				
				    #"Replaced Value" = Table.ReplaceValue(#"Columnas con nombre cambiado1", each [Estado],
				        each if [Estado_Alegado] = "1 - Aprobada" and [ANS] = "Cambio_Estado_Incidencia" and [Acción_ANS] = "Cambio Estado Incidencia" and [Solicitante]="Cliente"  then "Cerrado" else [Estado],Replacer.ReplaceValue,{"Estado"}),
				
				    // Realiza la correción sobre el campo Estado y modificarlo de cerrado a cancelado si la alegación es pedida por el Proveedor
				
				    #"Replaced Value1" = Table.ReplaceValue(#"Replaced Value", each [Estado],
				        each if [Estado_Alegado] = "1 - Aprobada" and [ANS] = "Cambio_Estado_Incidencia" and [Acción_ANS] = "Cambio Estado Incidencia" and [Solicitante]="Proveedor"  then "Cancelado" else [Estado],Replacer.ReplaceValue,{"Estado"}),
				        
				        
				     //Cambio criticidad a crítica si la alegación es de cambio de criticidad
				     
				     #"Replaced Value2" = Table.ReplaceValue(#"Replaced Value1", each [Prioridad],
				        each if [Estado_Alegado] = "1 - Aprobada" and [ANS] = "Cambio_Prioridad_Incidencia" and [Acción_ANS]="Cambio Prioridad a Crítica" then "Crítica" else [Prioridad],Replacer.ReplaceValue,{"Prioridad"}),
				    //Cambio criticidad a Alta si la alegación es de cambio de criticidad
				     #"Replaced Value3" = Table.ReplaceValue(#"Replaced Value2", each [Prioridad],
				        each if [Estado_Alegado] = "1 - Aprobada" and [ANS] = "Cambio_Prioridad_Incidencia" and [Acción_ANS]="Cambio Prioridad a Alta" then "Alta" else [Prioridad],Replacer.ReplaceValue,{"Prioridad"}),
				    //Cambio criticidad a Media si la alegación es de cambio de criticidad
				     #"Replaced Value4" = Table.ReplaceValue(#"Replaced Value3", each [Prioridad],
				        each if [Estado_Alegado] = "1 - Aprobada" and [ANS] = "Cambio_Prioridad_Incidencia" and [Acción_ANS]="Cambio Prioridad a Media" then "Media" else [Prioridad],Replacer.ReplaceValue,{"Prioridad"}),
				    
				    //Cambio criticidad a Baja si la alegación es de cambio de criticidad
				     #"Replaced Value5" = Table.ReplaceValue(#"Replaced Value4", each [Prioridad],
				        each if [Estado_Alegado] = "1 - Aprobada" and [ANS] = "Cambio_Prioridad_Incidencia" and [Acción_ANS]="Cambio Prioridad a Baja" then "Baja" else [Prioridad],Replacer.ReplaceValue,{"Prioridad"}),
				
				    //Reemplazamos la duración de la criticidad Crítica a la duración correcta:
				     #"Replaced Value6" = Table.ReplaceValue(#"Replaced Value5", each [Duración SLA],
				        each if [Estado_Alegado] = "1 - Aprobada" and [ANS] = "Cambio_Prioridad_Incidencia" and [Acción_ANS]="Cambio Prioridad a Crítica" then "14400" else [Duración SLA],Replacer.ReplaceValue,{"Duración SLA"}),
				    
				     #"Replaced Value7" = Table.ReplaceValue(#"Replaced Value6", each [Duración SLA],
				        each if [Estado_Alegado] = "1 - Aprobada" and [ANS] = "Cambio_Prioridad_Incidencia" and [Acción_ANS]="Cambio Prioridad a Alta" then "43200" else [Duración SLA],Replacer.ReplaceValue,{"Duración SLA"}),
				
				    #"Replaced Value8" = Table.ReplaceValue(#"Replaced Value7", each [Duración SLA],
				        each if [Estado_Alegado] = "1 - Aprobada" and [ANS] = "Cambio_Prioridad_Incidencia" and [Acción_ANS]="Cambio Prioridad a Media" then "173800" else [Duración SLA],Replacer.ReplaceValue,{"Duración SLA"}),
				    
				    #"Replaced Value9" = Table.ReplaceValue(#"Replaced Value8", each [Duración SLA],
				        each if [Estado_Alegado] = "1 - Aprobada" and [ANS] = "Cambio_Prioridad_Incidencia" and [Acción_ANS]="Cambio Prioridad a Baja" then "345600" else [Duración SLA],Replacer.ReplaceValue,{"Duración SLA"}),
				    //Nuevo campo de Duración excedida, respecto a SLA
				    #"Added Custom" = Table.AddColumn(#"Replaced Value9", "Duración excedida", 
				    each if ([Duración real]-[Duración SLA])<0 then 0 else 
				    ([Duración real]-[Duración SLA])),
				    #"Divided Column" = Table.TransformColumns(#"Added Custom", {{"Porcentaje de negocio trascurrido", each _ / 100, Percentage.Type}}),
				    #"Filas filtradas" = Table.SelectRows(#"Divided Column", each ([Estado] = "Cerrado")),
				    #"Duplicados quitados" = Table.Distinct(#"Filas filtradas", {"Número"})
				in
				    #"Duplicados quitados"
				```

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

