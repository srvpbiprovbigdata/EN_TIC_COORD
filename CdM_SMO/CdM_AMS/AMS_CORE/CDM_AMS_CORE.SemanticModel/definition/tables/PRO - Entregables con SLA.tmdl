				    #"Duplicated Column" = Table.DuplicateColumn(#"Changed Type", "Cerrado", "Cerrado - Copy"),
				    #"Extracted Date" = Table.TransformColumns(#"Duplicated Column",{{"Cerrado - Copy", DateTime.Date, type date}}),
				    #"Calculated Start of Month" = Table.TransformColumns(#"Extracted Date",{{"Cerrado - Copy", Date.StartOfMonth, type date}}),
				    
				    #"Replaced Value" = Table.ReplaceValue(#"Calculated Start of Month","1 - Crítica","Grave",Replacer.ReplaceText,{"Prioridad"}),
				    #"Replaced Value1" = Table.ReplaceValue(#"Replaced Value","2 - Alta","Grave",Replacer.ReplaceText,{"Prioridad"}),
				    #"Replaced Value2" = Table.ReplaceValue(#"Replaced Value1","3 - Moderada","Grave",Replacer.ReplaceText,{"Prioridad"}),
				    #"Replaced Value3" = Table.ReplaceValue(#"Replaced Value2","4 - Baja","Leve",Replacer.ReplaceText,{"Prioridad"}),
				    #"Replaced Value4" = Table.ReplaceValue(#"Replaced Value3","5 - Muy Baja","Leve",Replacer.ReplaceText,{"Prioridad"}),
				
				    #"Renamed Columns" = Table.RenameColumns(#"Replaced Value4",{{"Prioridad", "Tipo de incumplimiento"}}),
				
				    //Une con las alegaciones
				    #"Merged Queries" = Table.NestedJoin(#"Renamed Columns", {"Número_1"}, #"PRO - Alegaciones del Servicio KGI14", {"ID"}, "PRO - Alegaciones del Servicio", JoinKind.LeftOuter),
				    #"Se expandió PRO - Alegaciones del Servicio1" = Table.ExpandTableColumn(#"Merged Queries", "PRO - Alegaciones del Servicio", {"Entrada alegada", "ANS", "Acción", "Estado"}, {"PRO - Alegaciones del Servicio.Entrada alegada", "PRO - Alegaciones del Servicio.ANS", "PRO - Alegaciones del Servicio.Acción", "PRO - Alegaciones del Servicio.Estado"}),
				    #"Columnas con nombre cambiado" = Table.RenameColumns(#"Se expandió PRO - Alegaciones del Servicio1",{{"PRO - Alegaciones del Servicio.Entrada alegada", "Entrada_Alegada"}, {"PRO - Alegaciones del Servicio.ANS", "ANS"}, {"PRO - Alegaciones del Servicio.Acción", "Acción"}, {"PRO - Alegaciones del Servicio.Estado", "Estado_Alegación"}}),
				    //Realiza la corrección sobre el cumplimiento de la columna "Rechazado" si la alegación es aceptada y pedida por el Proveedor
				    #"Replaced Value5" = Table.ReplaceValue(#"Columnas con nombre cambiado",each [Estado],each if [Estado_Alegación] = "1 - Aprobada" and [Acción]= "Cambio Estado Entregable" and [Solicitante]= "Proveedor" then "Cerrado completo" else [Estado],Replacer.ReplaceValue,{"Estado"}),
				
				    #"Replaced Value6" = Table.ReplaceValue(#"Replaced Value5",each [Estado],each if [Estado_Alegación] = "1 - Aprobada" and [Acción]= "Cambio Estado Entregable" and [Solicitante]= "Acciona" then "Cerrado completo" else [Estado],Replacer.ReplaceValue,{"Estado"}),
				
				    #"Replaced Value7" = Table.ReplaceValue(#"Replaced Value6",each [Tipo de incumplimiento],each if [Estado_Alegación] = "1 - Aprobada" and [Acción]= "Cambio Prioridad a Grave" then "Grave" else [Tipo de incumplimiento],Replacer.ReplaceValue,{"Tipo de incumplimiento"}),
				
				    #"Replaced Value8" = Table.ReplaceValue(#"Replaced Value7",each [Tipo de incumplimiento],each if [Estado_Alegación] = "1 - Aprobada" and [Acción]= "Cambio Prioridad a Leve" then "Leve" else [Tipo de incumplimiento],Replacer.ReplaceValue,{"Tipo de incumplimiento"})
				in
				    #"Replaced Value8"
