	column 'Duración D:HH:MM:SS' =
			
			VAR VDUR13 = 'PRO - Estimaciones con SLA'[Duración del negocio]
			  RETURN INT
			    (VDUR13/86400)&" Día(s) "&
			    RIGHT("0" & INT(MOD(VDUR13/3600,24)),2)&":"&
			    RIGHT("0" & INT(MOD(VDUR13/60,60)),2)&":"&
			    RIGHT("0" & INT(MOD(VDUR13,60)),2)
		lineageTag: 575b3a12-bbb4-4a85-850a-3a35fca346d2
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Duración_EX D:HH:MM:SS' =
			
			VAR VDUR13_EX = 'PRO - Estimaciones con SLA'[Duración excedida]
			  RETURN INT
			    (VDUR13_EX/86400)&" Día(s) "&
			    RIGHT("0" & INT(MOD(VDUR13_EX/3600,24)),2)&" HH"
		lineageTag: 7cf1a4fa-e743-450a-82f5-140904f08721
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

