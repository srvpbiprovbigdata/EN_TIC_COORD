	partition 'PRO - Estimaciones con SLA-5a40b48a-1e50-4be9-880e-a8884b495a6d' = m
		mode: import
		queryGroup: KGIs_I
		source = ```
				let
				    Source = #"PRO - Estimaciones con SLA (staging)",
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"Creado", type datetime}, {"Número", type text}, {"Aplicación de Negocio", type text}, {"Prioridad", type text}, {"Tarea", type text}, {"Etapa", type text}, {"Tiempo de negocio restante", Int64.Type}, {"Duración del negocio", Int64.Type}, {"Porcentaje de negocio trascurrido", Percentage.Type}, {"Hora de inicio", type datetime}, {"Tiempo de pausa", type any}, {"Hora de finalización", type datetime}, {"Grupo de asignación", type text}, {"Infringido", type logical}, {"Hora de infracción", type datetime}, {"Duración", Int64.Type}}),
				    
				    //Genera Columna de Cerrado
				    #"Duplicated Column" = Table.DuplicateColumn(#"Changed Type", "Hora de finalización", "Hora de finalización - Copy"),
				    #"Changed Type1" = Table.TransformColumnTypes(#"Duplicated Column",{{"Hora de finalización - Copy", type date}}),
				    #"Inserted Start of Month" = Table.AddColumn(#"Changed Type1", "Start of Month", each Date.StartOfMonth([#"Hora de finalización - Copy"]), type date),
				   
				   //Homologa las prioridades
				    #"Replaced Value" = Table.ReplaceValue(#"Inserted Start of Month",  "1 - Crítica",  "Alta",Replacer.ReplaceText,{"Prioridad"}),
				    #"Replaced Value1" = Table.ReplaceValue(#"Replaced Value",          "2 - Alta",     "Alta",Replacer.ReplaceText,{"Prioridad"}),
				    #"Replaced Value2" = Table.ReplaceValue(#"Replaced Value1",         "3 - Moderada", "Media",Replacer.ReplaceText,{"Prioridad"}),
				    #"Replaced Value3" = Table.ReplaceValue(#"Replaced Value2",         "4 - Baja",     "Baja",Replacer.ReplaceText,{"Prioridad"}),
				    #"Replaced Value4" = Table.ReplaceValue(#"Replaced Value3",         "5 - Muy Baja", "Baja",Replacer.ReplaceText,{"Prioridad"}),
				
				    //Pone "Nuevo Servicio" sobre Estimaciones de Demandas que no son Evolutivos
				    #"Replaced Value5" = Table.ReplaceValue(#"Replaced Value4",         "",             "Nuevo Servicio",Replacer.ReplaceValue,{"Aplicación de Negocio"}),
				    //Une con las alegaciones
				    #"Merged Queries" = Table.NestedJoin(#"Replaced Value5", {"Tarea"}, #"PRO - Alegaciones del Servicio KGI11", {"ID"}, "PRO - Alegaciones del Servicio", JoinKind.LeftOuter),
				    #"Expanded PRO - Alegaciones del Servicio" = Table.ExpandTableColumn(#"Merged Queries", "PRO - Alegaciones del Servicio", {"Solicitante", "Acción", "ANS", "Estado"}, {"PRO - Alegaciones del Servicio.Solicitante", "PRO - Alegaciones del Servicio.Acción", "PRO - Alegaciones del Servicio.ANS", "PRO - Alegaciones del Servicio.Estado"}),
				    #"Renamed Columns" = Table.RenameColumns(#"Expanded PRO - Alegaciones del Servicio",{{"PRO - Alegaciones del Servicio.Estado", "Estado_Alegación"}, {"PRO - Alegaciones del Servicio.Solicitante", "Solicitante"}, {"PRO - Alegaciones del Servicio.Acción", "Acción"}, {"PRO - Alegaciones del Servicio.ANS", "ANS"}}),
				
				    //Realiza la corrección sobre el cumplimiento de la columna "Infringido" si la alegación es aceptada y pedida por el Proveedor del Servicio (De True a False)
				    #"Replaced Value6" = Table.ReplaceValue(#"Renamed Columns",each [Infringido],each if [Estado_Alegación] = "1 - Aprobada" and [ANS]="KGI_11" and [Solicitante]="Proveedor" and [Acción] ="Cambio Estimación Infringida"  then "FALSE" else [Infringido],Replacer.ReplaceValue,{"Infringido"}),
				
				    // Realiza la correción sobre el cumplimiento de la columna INfringido si la alegación es aceptada y pedida por el Cliente (De false a True)
				    #"Replaced Value7" = Table.ReplaceValue(#"Replaced Value6",each [Infringido],each if [Estado_Alegación] = "1 - Aprobada" and [ANS]="KGI _11" and [Solicitante]="Cliente" and [Acción] = "Cambio Estimación Infringida" then "TRUE" else [Infringido],Replacer.ReplaceValue,{"Infringido"}),
				
				    //Realiza la correción sobre la columna Prioridad si la alegación es aceptada y la Prioridad es Crítica
				    #"Replaced Value8" = Table.ReplaceValue(#"Replaced Value7",each [Prioridad],each if [Estado_Alegación] = "1 - Aprobada" and [ANS]="KGI _11" and [Acción]="Cambio Prioridad a Crítica" then "Alta" else [Prioridad],Replacer.ReplaceValue,{"Prioridad"}),
				
				    //Realiza la correción sobre la columna Prioridad si la alegación es aceptada y la Prioridad es Alta
				    #"Replaced Value9" = Table.ReplaceValue(#"Replaced Value8",each [Prioridad],each if [Estado_Alegación] = "1 - Aprobada" and [ANS]="KGI _11" and [Acción]="Cambio Prioridad a Alta" then "Alta" else [Prioridad],Replacer.ReplaceValue,{"Prioridad"}),
				
				    //Realiza la correción sobre la columna Prioridad si la alegación es aceptada y la Prioridad es Media
				    #"Replaced Value10" = Table.ReplaceValue(#"Replaced Value9",each [Prioridad],each if [Estado_Alegación] = "1 - Aprobada" and [ANS]="KGI _11" and [Acción]="Cambio Prioridad a Media" then "Media" else [Prioridad],Replacer.ReplaceValue,{"Prioridad"}),
				
				    //Realiza la correción sobre la columna Prioridad si la alegación es aceptada y la Prioridad es Baja
				    #"Replaced Value11" = Table.ReplaceValue(#"Replaced Value10",each [Prioridad],each if [Estado_Alegación] = "1 - Aprobada" and [ANS]="KGI _11" and [Acción]="Cambio Prioridad a Baja" then "Baja" else [Prioridad],Replacer.ReplaceValue,{"Prioridad"}),
				
				    #"Changed Type2" = Table.TransformColumnTypes(#"Replaced Value11",{{"Infringido", type logical}}),
				
				    //Elimina los duplicados, y deja el último SLA finalizado
				    #"Sorted Rows" = Table.Buffer(Table.Sort(#"Changed Type2",{{"Hora de finalización - Copy", Order.Descending}})),
				    #"Removed Duplicates" = Table.Distinct(#"Sorted Rows", {"Tarea"}),
				
				    #"Renamed Columns1" = Table.RenameColumns(#"Removed Duplicates",{{"Duración", "Duración SLA"}}),
				
				    //Nuevo campo de Duración Excedida, respecto a SLA
				    #"Added Custom" = Table.AddColumn(#"Renamed Columns1", "Duración excedida", 
				    each if ([Duración del negocio]-[Duración SLA])<0 then 0 else 
				    ([Duración del negocio]-[Duración SLA])),
				    #"Divided Column" = Table.TransformColumns(#"Added Custom", {{"Porcentaje de negocio trascurrido", each _ / 100, Percentage.Type}})
				in
				    #"Divided Column"
				```

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navegación

