		formatString: 0
		lineageTag: ebdeac1a-c9dd-41ec-94fa-d6da91c7672c

	measure 'Puntuación KGI2.1' = if(SUMX('Parametros KGI2-1',[% Cumplimiento]-[% Cumplimiento KGI2.1])>0,0,CALCULATE(SUM('Parametros KGI2-1'[Pesos])))
		lineageTag: 4c68d89c-30e3-4869-be0a-47f6970cf21c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

