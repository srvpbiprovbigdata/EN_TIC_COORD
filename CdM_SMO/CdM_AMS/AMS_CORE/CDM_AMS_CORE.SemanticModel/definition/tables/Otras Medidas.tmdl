	measure 'KGI23 % Dif Trim Anterior_M' =
			
			VAR __BASELINE_VALUE = [No. INCs abiertas_M]
			VAR __VALUE_TO_COMPARE = [KGI23 Dif No. INCs Trim Anterior_M]
			RETURN
				IF(
					NOT ISBLANK(__VALUE_TO_COMPARE),
					DIVIDE(__VALUE_TO_COMPARE, __BASELINE_VALUE), 0
				)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: b6cc1543-11ea-45e3-8f73-8a4b162405cf

		extendedProperty MeasureTemplate =
				{
