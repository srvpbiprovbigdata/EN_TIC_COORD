	measure 'KGI23 Dif No. INCs Trim Anterior_M' = [No. INCs abiertas_M]-[KGI23 Media INCs Trim Anterior_M]
		formatString: 0
		lineageTag: 6cab627d-a56f-4ca0-981a-d359797536d6

	measure 'KGI23 Media INCs Trim Anterior_M' = ```
			
			(CALCULATE([No. INCs abiertas_M],PARALLELPERIOD(Fechas[Date],-1,MONTH)) + 
			CALCULATE([No. INCs abiertas_M],PARALLELPERIOD(Fechas[Date],-2,MONTH)) +
			CALCULATE([No. INCs abiertas_M],PARALLELPERIOD(Fechas[Date],-3,MONTH)))/3
			```
		formatString: 0.0
		lineageTag: 57bd7e68-837c-49e3-a006-4709c057e920

	measure KGI21_Final =
			if(((1- calculate(count('PRO - Incidencias con SLA (NY y MAD)'[Número]),'PRO - Incidencias con SLA (NY y MAD)'[Infringido]=TRUE(),'PRO - Incidencias con SLA (NY y MAD)'[Prioridad]="Crítica")/CALCULATE(count('PRO - Incidencias con SLA (NY y MAD)'[Número]),'PRO - Incidencias con SLA (NY y MAD)'[Prioridad]="Crítica"))-CALCULATE(SUM('Parametros KGI2-1'[% Cumplimiento]),'Parametros KGI2-1'[Prioridad ]="Crítica"))<0,0,calculate(sum('Parametros KGI2-1'[Pesos]),'Parametros KGI2-1'[Prioridad ]="Crítica"))+
			if(((1- calculate(count('PRO - Incidencias con SLA (NY y MAD)'[Número]),'PRO - Incidencias con SLA (NY y MAD)'[Infringido]=TRUE(),'PRO - Incidencias con SLA (NY y MAD)'[Prioridad]="Alta")/CALCULATE(count('PRO - Incidencias con SLA (NY y MAD)'[Número]),'PRO - Incidencias con SLA (NY y MAD)'[Prioridad]="Alta"))-CALCULATE(SUM('Parametros KGI2-1'[% Cumplimiento]),'Parametros KGI2-1'[Prioridad ]="Alta"))<0,0,calculate(sum('Parametros KGI2-1'[Pesos]),'Parametros KGI2-1'[Prioridad ]="Alta"))+
			
			if(((1- calculate(count('PRO - Incidencias con SLA (NY y MAD)'[Número]),'PRO - Incidencias con SLA (NY y MAD)'[Infringido]=TRUE(),'PRO - Incidencias con SLA (NY y MAD)'[Prioridad]="Media")/CALCULATE(count('PRO - Incidencias con SLA (NY y MAD)'[Número]),'PRO - Incidencias con SLA (NY y MAD)'[Prioridad]="Media"))-CALCULATE(SUM('Parametros KGI2-1'[% Cumplimiento]),'Parametros KGI2-1'[Prioridad ]="Media"))<0,0,calculate(sum('Parametros KGI2-1'[Pesos]),'Parametros KGI2-1'[Prioridad ]="Media"))+
			
			if(((1- calculate(count('PRO - Incidencias con SLA (NY y MAD)'[Número]),'PRO - Incidencias con SLA (NY y MAD)'[Infringido]=TRUE(),'PRO - Incidencias con SLA (NY y MAD)'[Prioridad]="Baja")/CALCULATE(count('PRO - Incidencias con SLA (NY y MAD)'[Número]),'PRO - Incidencias con SLA (NY y MAD)'[Prioridad]="Baja"))-CALCULATE(SUM('Parametros KGI2-1'[% Cumplimiento]),'Parametros KGI2-1'[Prioridad ]="Baja"))<0,0,calculate(sum('Parametros KGI2-1'[Pesos]),'Parametros KGI2-1'[Prioridad ]="Baja"))
		lineageTag: 9fab0e62-6228-471b-8fb8-fab1cca39e9a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Media Incidencias Last Year 2' =
			
			IF  (
			    HASONEVALUE('PRO - Incidencias con SLA - Por mes'[Cerrado - Copy]),
			    CALCULATE(
			      SUM('PRO - Incidencias con SLA - Por mes'[No. de Incidencias]),
			      DATESINPERIOD(
			        'PRO - Incidencias con SLA - Por mes'[Cerrado - Copy],
			        VALUES('PRO - Incidencias con SLA - Por mes'[Cerrado - Copy]),
			        -2,
			        MONTH
			    )
			  )
			)
		formatString: 0
		lineageTag: 7a4c3869-c4a2-4c8c-9f83-a5e87c9f1e5d

	measure 'KGI13 Media INCs Año Anterior_M' =
			
			(CALCULATE([No. INCs abiertas_M],PARALLELPERIOD(Fechas[Date],-1,MONTH)) +
			CALCULATE([No. INCs abiertas_M],PARALLELPERIOD(Fechas[Date],-2,MONTH)) +
			CALCULATE([No. INCs abiertas_M],PARALLELPERIOD(Fechas[Date],-3,MONTH)) +
			CALCULATE([No. INCs abiertas_M],PARALLELPERIOD(Fechas[Date],-4,MONTH)) +
			CALCULATE([No. INCs abiertas_M],PARALLELPERIOD(Fechas[Date],-5,MONTH)) +
			CALCULATE([No. INCs abiertas_M],PARALLELPERIOD(Fechas[Date],-6,MONTH)) +
			CALCULATE([No. INCs abiertas_M],PARALLELPERIOD(Fechas[Date],-7,MONTH)) +
			CALCULATE([No. INCs abiertas_M],PARALLELPERIOD(Fechas[Date],-8,MONTH)) +
			CALCULATE([No. INCs abiertas_M],PARALLELPERIOD(Fechas[Date],-9,MONTH)) +
			CALCULATE([No. INCs abiertas_M],PARALLELPERIOD(Fechas[Date],-10,MONTH)) +
			CALCULATE([No. INCs abiertas_M],PARALLELPERIOD(Fechas[Date],-11,MONTH)) +
			CALCULATE([No. INCs abiertas_M],PARALLELPERIOD(Fechas[Date],-12,MONTH)))/12
		formatString: 0.0
		lineageTag: 2d5e59a3-e998-4934-8aa6-90bb7587c7cb

	measure 'Tasa de Incremento de INCs_M' = ([Total INCs abiertas del periodo_M]-[KGI13 Media INCs Año Anterior_M])/[KGI13 Media INCs Año Anterior_M]
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: 21fa3543-b78f-4463-82ea-e360c29e8733

	measure 'KGI23 Tasa de Reducción de INCs_M' = ([KGI23 Media INCs Trim Anterior_M]-[Total INCs abiertas del periodo_M])/[KGI23 Media INCs Trim Anterior_M]
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: bcf1baf1-c0dc-4b9e-8c02-7e52a666bacd

