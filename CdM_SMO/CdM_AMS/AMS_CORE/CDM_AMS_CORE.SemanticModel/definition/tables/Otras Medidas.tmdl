table 'Otras Medidas'
	lineageTag: 73d08da6-f8f3-495a-a0b3-0cb0d86d24f3

	measure '% Cumplimiento KGI2.1' = ```
			
			VAR __BASELINE_VALUE = [Total INCs cerradas del Periodo_M]
			VAR __VALUE_TO_COMPARE = [KGI21 INCs_No Infringidas_M]
			RETURN
				IF(
					NOT ISBLANK(__VALUE_TO_COMPARE),
					DIVIDE(__VALUE_TO_COMPARE, __BASELINE_VALUE),1
				)   
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: d70dee8a-e4a3-45f4-b39f-9a85f782cb07

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "MathematicalPercentageDifference"
				}

	measure 'KGI21 INCs Infringidas_M' = SUM('PRO - Incidencias con SLA (NY y MAD) KGI21'[Infringidos Numérico])
		formatString: 0
		lineageTag: e2776339-b32d-40a0-a724-c84e791c04fb

	measure 'KGI21 INCs_No Infringidas_M' = ```
