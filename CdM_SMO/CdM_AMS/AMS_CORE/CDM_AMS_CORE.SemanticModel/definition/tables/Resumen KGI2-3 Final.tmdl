table 'Resumen KGI2-3 Final'
	lineageTag: 395a14bd-5c33-4b2a-bab4-e24780ef6fbb

	measure 'Puntos de KGI23_M' =
			
			var _KGI23_V = MIN('Resumen KGI2-3 Final'[Puntos de KGI23])
			return
			IF(ISBLANK(_KGI23_V),5,_KGI23_V)
		lineageTag: 6b67e076-106a-4882-9a62-71854395db63

	measure 'Peso Obtenido KGI23_M' = IF(MAX(Fechas[SERVICE_P])=0,"N/A",1-SUM('Resumen KGI2-3 Final'[Peso No Obtenido %]))
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: 14798588-10d8-42d7-8277-f3e76de56b68

	measure 'Puntos Obtenidos KGI23_M' = IF(MAX(Fechas[SERVICE_P])=0,"N/A",IF([Total INCs cerradas del Periodo_M]=0,5,[Peso Obtenido KGI23_M]*[Puntos de KGI23_M]))
		formatString: 0
		lineageTag: bbd3a744-e924-429c-bc52-c42b1ba53150

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Peso Obtenido KGI23_M average' =
			
			AVERAGEX(
				KEEPFILTERS(VALUES('Fechas'[MesNombreComp])),
				CALCULATE([Peso Obtenido KGI23_M])
			)
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: 74e744ef-b14e-4371-af77-49ccf2cabddf

	measure 'Puntos Obtenidos KGI23_M average' =
			
			AVERAGEX(
				KEEPFILTERS(VALUES('Fechas'[MesNombreCorto])),
				CALCULATE([Puntos Obtenidos KGI23_M])
			)
		formatString: 0.0
		lineageTag: e4bff42a-ef49-4ded-979a-c3ec87c4c9b6

	column 'Total Incidencias'
		dataType: int64
		lineageTag: 1a93df6c-7cd6-4b46-baba-05367bdbb6ff
