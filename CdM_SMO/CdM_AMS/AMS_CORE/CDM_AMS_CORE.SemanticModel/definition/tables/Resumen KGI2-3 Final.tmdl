		summarizeBy: none
		sourceColumn: Puntos de KGI23

		annotation SummarizationSetBy = Automatic

	column ¿Cumple? = IF([KGI23 Tasa de Reducción de INCs_M]>='Resumen KGI2-3 Final'[Tasa mínima objetivo %],"Si","No")
		lineageTag: 8b8434a9-74c8-41bb-a961-7238553b0267
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Peso Obtenido %' = IF('Resumen KGI2-3 Final'[¿Cumple?]="Si",'Resumen KGI2-3 Final'[Peso del KGI %],0)
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: 4b8f8fc3-8837-4133-9972-32fcd6c2ad6f
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Peso No Obtenido %' = IF('Resumen KGI2-3 Final'[¿Cumple?]="No",'Resumen KGI2-3 Final'[Peso del KGI %],0)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: cf526288-7874-4a9c-be4d-b31769dc2a9a
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

