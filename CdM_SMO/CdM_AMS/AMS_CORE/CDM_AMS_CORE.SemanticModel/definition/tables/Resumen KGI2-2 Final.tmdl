		annotation SummarizationSetBy = Automatic

	column ¿Cumple? = IF('Resumen KGI2-2 Final'[Cump. Real %]<='Resumen KGI2-2 Final'[Cump. Objetivo %],"Si","No")
		lineageTag: 1ef9a6a5-2d21-4658-b22c-da4701c32ba8
