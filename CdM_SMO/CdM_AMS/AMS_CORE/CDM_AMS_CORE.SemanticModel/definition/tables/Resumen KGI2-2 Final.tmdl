table 'Resumen KGI2-2 Final'
	lineageTag: 7ef61e09-acf9-420e-876a-d1581c07b175

	measure 'Puntos de KGI22_M' =
			
			var _KGI22_V = MIN('Resumen KGI2-2 Final'[Puntos de KGI22])
			return
			IF(ISBLANK(_KGI22_V),5,_KGI22_V)
		lineageTag: f7f0b430-be17-45c9-9930-4e4970a870a3

	measure 'Peso Obtenido KGI22_M' = IF(MAX(Fechas[SERVICE_P])=0,"N/A",1-SUM('Resumen KGI2-2 Final'[Peso No Obtenido %]))
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: 0df3df61-34aa-4906-9e4c-df29e886b502

	measure 'Puntos Obtenidos KGI22_M' = IF(MAX(Fechas[SERVICE_P])=0,"N/A",[Peso Obtenido KGI22_M]*[Puntos de KGI22_M])
		formatString: 0
		lineageTag: e9b2868a-61a6-4647-ae4f-8ff66e928583

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Peso Obtenido KGI22_M average' =
			
			AVERAGEX(
				KEEPFILTERS(VALUES('Fechas'[MesNombreComp])),
				CALCULATE([Peso Obtenido KGI22_M])
			)
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: 34a4e0e3-aaa0-4719-9f00-89275ec7df5e

	measure 'Puntos Obtenidos KGI22_M average' =
			
			AVERAGEX(
				KEEPFILTERS(VALUES('Fechas'[MesNombreCorto])),
				CALCULATE([Puntos Obtenidos KGI22_M])
			)
		formatString: 0.0
		lineageTag: 5cd7db12-a2a4-4457-b9a9-6c79b262e44f

