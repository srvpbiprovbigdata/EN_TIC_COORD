table 'Parametros Generales KGIs'
	excludeFromModelRefresh
	lineageTag: 3f65c1dc-178c-4ac9-8afa-706d8e272b41

	measure 'Total de Puntos Obtenidos KGIs_M' = IF(MAX(Fechas[SERVICE_P])=0,"N/A", [Puntos Obtenidos KGI11_M]+[Puntos Obtenidos KGI12_M]+[Puntos_obtenidos KGI13]+[Puntos Obtenidos KGI14_M]+[Puntos Obtenidos KG21_M]+[Puntos Obtenidos KGI22_M]+[Puntos Obtenidos KGI23_M])
		formatString: 0.0
		lineageTag: fe2cd49c-0f96-44b0-8f16-b3932dd172c0

	measure 'Umbral alcanzado' = IF([Total de Puntos Obtenidos KGIs_M]="N/A","N/A",IF([Total de Puntos Obtenidos KGIs_M]>=90,"OBJETIVO",IF([Total de Puntos Obtenidos KGIs_M]>=50,"ADMISIBLE","CRÍTICO")))
		lineageTag: b8b0c6c8-e325-4336-913f-fcd21ac59596

	measure 'Total de Puntos Obtenidos KGIs_M_AV' =
			
			AVERAGEX(
				KEEPFILTERS(VALUES('Fechas'[MesNombreCorto])),
				CALCULATE([Total de Puntos Obtenidos KGIs_M]))
		formatString: 0.0
		lineageTag: 79f5845a-6ea5-4a92-bfe6-96f69ac135fd

	column KGI
		dataType: string
		lineageTag: 683114b2-9bc2-4f19-9b3c-953c8498fe93
