		summarizeBy: sum
		sourceColumn: Puntos por KGI

		annotation SummarizationSetBy = Automatic

	column 'Puntos Obtenidos' = ('Parametros Generales KGIs'[Puntos por KGI]*1)
		formatString: 0
		lineageTag: 24b18c1b-49a8-4007-b2ba-5f6e2dbb354e
		summarizeBy: sum

