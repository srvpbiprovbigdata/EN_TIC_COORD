table 'Resumen KGI1-2 Final'
	lineageTag: 6994b197-8fb8-4ca8-841f-e4de729f174f

	measure 'Peso Obtenido KGI12_M' = IF(MAX(Fechas[SERVICE_P])=0,"N/A",1-SUM('Resumen KGI1-2 Final'[Peso No Obtenido %]))
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: 6cc513f2-fe91-420f-a070-e81af8be248e

	measure 'Puntos de KGI12_M' =
			
			var _KGI12_V = MIN('Resumen KGI1-2 Final'[Puntos de KGI12])
			return
			IF(ISBLANK(_KGI12_V),35,_KGI12_V)
		formatString: 0
		lineageTag: c3a615c3-1b24-45f7-82fc-e83190ce86bf

	measure 'Puntos Obtenidos KGI12_M' = IF(MAX(Fechas[SERVICE_P])=0,"N/A",[Peso Obtenido KGI12_M]*[Puntos de KGI12_M])
		formatString: 0
		lineageTag: 6e746655-a2fb-46ef-ab0c-943d20b574da

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Peso Obtenido KGI12_M average' =
			
			AVERAGEX(
				KEEPFILTERS(VALUES('Fechas'[MesNombreComp])),
				CALCULATE([Peso Obtenido KGI12_M])
			)
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: 0b0cdc3f-bf3c-4050-9ba0-59c37c9d596c

	measure 'Puntos Obtenidos KGI12_M average' =
			
			AVERAGEX(
				KEEPFILTERS(VALUES('Fechas'[MesNombreCorto])),
				CALCULATE([Puntos Obtenidos KGI12_M])
			)
		formatString: 0.0
		lineageTag: ead9ca41-1daa-4a77-ba6f-cc177a2d2198

