	column ¿Cumple? = IF('Resumen KGI1-2 Final'[Cump. Real %]>='Resumen KGI1-2 Final'[Cump. Objetivo %],"Si","No")
		lineageTag: 1681504c-cb01-4ecd-b6bb-adee6bc70888
