	column 'Planificaciones Cumplidas' = 'Resumen KGI1-2 Final'[Total Planificaciones]-'Resumen KGI1-2 Final'[Planificaciones Incumplidas]
		formatString: 0
		lineageTag: 7b75edf3-bc05-4a2c-997c-63e215f2b8cb
