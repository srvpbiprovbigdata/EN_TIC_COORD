		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

	column 'Cump. Real %' = ('Resumen KGI1-2 Final'[Planificaciones Cumplidas])/('Resumen KGI1-2 Final'[Total Planificaciones])
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: 8ae9333d-8d7d-4af8-8dfb-003ad8acd32d
