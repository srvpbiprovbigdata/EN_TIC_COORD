table BI_Aplicación
	lineageTag: bcb4ca90-aa1b-49cc-8c3e-2dc7a3bac88f

	measure '€ Presupuesto Restante Global' = 'BI_Aplicación'[€_presupuesto restante] + [Linea Base Restante mes] + 'BI_Aplicación'[Linea Base Restante mes _C]
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: d5057606-f58a-403a-aaca-3e2d9320e831

	measure '€_presupuesto restante' = [Presupuesto Real €] - [Línea Base Real consumida €]
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: 2aff5031-3364-4da0-8533-8c93d1c67d80

	measure 'Linea Base Restante mes' = DIVIDE([€_presupuesto restante], [Meses_Restantes_Año_1], 0)
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: 860a68ef-9e7e-4f16-ac4e-a24b1296455c

	measure Meses_Restantes_Año_1 =
			IF(
			    YEAR(TODAY()) > YEAR(MAX('BI_Aplicación'[Periodo])),
			    1,
			    12 - MONTH(CALCULATE(MAX('BI_Aplicación'[Periodo]), 'BI_Aplicación'[Atributo] = "Consumo Real", 'BI_Aplicación'[Descripción Ámbito] = "Evolutivos"))
			)
		formatString: 0
		lineageTag: 5d2b5ed6-e68a-4314-9060-f5bab5c6274e

	measure 'Linea Base Restante mes _C' = DIVIDE('BI_Aplicación'[Linea_Base_esperada_total_C] - 'BI_Aplicación'[Línea Base Real consumida €_C], [Meses_Restantes_Año_1], 0)
		lineageTag: 261b6145-86be-4e68-b6ab-be64c4de5cd4

	measure Linea_Base_esperada_total_C = CALCULATE(SUM('BI_Aplicación'[Valor]), 'BI_Aplicación'[Atributo]="Línea Base Objetivo", 'BI_Aplicación'[Descripción Ámbito] = "Correctivos")
		lineageTag: 568a5ddf-b367-4319-9912-272f69658670

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Línea Base Real consumida €_C' = CALCULATE(SUM('BI_Aplicación'[Valor]), 'BI_Aplicación'[Descripción Ámbito] = "Correctivos", 'BI_Aplicación'[Atributo] = "Consumo Real")
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: efc36f8d-a84d-462a-832e-1cc51e8a13a1

	measure Linea_Base_esperada_total = CALCULATE(SUM('BI_Aplicación'[Valor]), 'BI_Aplicación'[Atributo]="Línea Base Objetivo", 'BI_Aplicación'[Descripción Ámbito] = "Evolutivos")
		lineageTag: 922b2247-65dd-46b8-be67-eec27f9209c1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Línea Base Real consumida €' = CALCULATE(SUM('BI_Aplicación'[Valor]), 'BI_Aplicación'[Descripción Ámbito] = "Evolutivos", 'BI_Aplicación'[Atributo] = "Consumo Real", MONTH('BI_Aplicación'[Periodo]<= MONTH(TODAY())))
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: 7d5289e4-47bc-4cab-94df-99306b1ab71b

	measure 'Presupuesto Real €' = CALCULATE(SUM('BI_Aplicación'[Valor]), 'BI_Aplicación'[Descripción Ámbito] ="Evolutivos", 'BI_Aplicación'[Atributo] = "Presupuesto")
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: a12ed524-4803-49c7-ad70-2f30b4daea0c

	measure Linea_Base_esperada_total_mensual = CALCULATE(SUM('BI_Aplicación'[Valor])/12, 'BI_Aplicación'[Atributo]="Línea Base Objetivo", 'BI_Aplicación'[Descripción Ámbito] = "Evolutivos")
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: 67d5458a-98ab-4038-9e01-731110692590

	measure '€_Linea Base Real por Mes' =
			
			[Línea Base Real consumida €]/ [Meses_Restantes_Año_12_2]
