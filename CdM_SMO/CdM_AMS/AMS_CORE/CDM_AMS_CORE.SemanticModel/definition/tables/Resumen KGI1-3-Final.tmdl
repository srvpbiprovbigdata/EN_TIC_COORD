		lineageTag: 7fd2646c-740b-446e-9d41-685bc6c5a072
		summarizeBy: sum
		sourceColumn: Parametros KGI1-3.Pesos %

		annotation SummarizationSetBy = Automatic

	column Peso_No_Obtenido = IF('Resumen KGI1-3-Final'[¿Cumple?] = "No", 'Resumen KGI1-3-Final'[Parametros KGI1-3.Pesos %], 0)
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: d4e834f7-43c4-47e2-a396-93411bcc2914
		summarizeBy: none

		annotation SummarizationSetBy = User

	column Peso_Obtenido = 'Resumen KGI1-3-Final'[Parametros KGI1-3.Pesos %] - 'Resumen KGI1-3-Final'[Peso_No_Obtenido]
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: d3233ab4-9e1e-4b63-906d-ac9ea0331863
		summarizeBy: none

