table 'Resumen KGI1-3-Final'
	lineageTag: df86aab2-98a3-4ab8-a4c5-2314993c1e59

	measure 'Tasa Máxima Permitida' = 0
		formatString: 0
		lineageTag: 6bfed195-952c-47ac-bf77-804b097c4d57

	measure 'Peso Obtenido KGI13_M' =
			IF(MAX(Fechas[SERVICE_P])=0,"N/A",
			IF(MAX(Fechas[Date_1er_día_mes]) = DATE(2020,01,01), 1,
			IF(MAX(Fechas[Date_1er_día_mes]) = DATE(2020,02,01), 0,
			IF(MAX(Fechas[Date_1er_día_mes]) = DATE(2020,03,01), 1,
			IF(MAX(Fechas[Date_1er_día_mes]) = DATE(2020,04,01), 1,
			IF(MAX(Fechas[Date_1er_día_mes]) = DATE(2020,05,01), 1,
			IF(MAX(Fechas[Date_1er_día_mes]) = DATE(2020,06,01), 1,
			IF(MAX(Fechas[Date_1er_día_mes]) = DATE(2020,07,01), 1,
			IF(MAX(Fechas[Date_1er_día_mes]) = DATE(2020,08,01), 1,
			IF(MAX(Fechas[Date_1er_día_mes]) = DATE(2020,09,01), 0,
			IF(MAX(Fechas[Date_1er_día_mes]) = DATE(2020,10,01), 0,
			IF(MAX(Fechas[Date_1er_día_mes]) = DATE(2020,11,01), 0,
			IF(MAX(Fechas[Date_1er_día_mes]) = DATE(2020,12,01), 1,
			IF(MAX(Fechas[Date_1er_día_mes]) = DATE(2021,01,01), 0,
			IF(MAX(Fechas[Date_1er_día_mes]) = DATE(2021,02,01), 1,
			IF(MAX(Fechas[Date_1er_día_mes]) = DATE(2021,03,01), 1,
			IF(MAX(Fechas[Date_1er_día_mes]) = DATE(2021,04,01), 1,
			IF(MAX(Fechas[Date_1er_día_mes]) = DATE(2021,05,01), 0,
			IF(MAX(Fechas[Date_1er_día_mes]) = DATE(2021,06,01), 0,
			IF(MAX(Fechas[Date_1er_día_mes]) = DATE(2021,07,01), 1,
			IF(MAX(Fechas[Date_1er_día_mes]) = DATE(2021,08,01), 1,
			IF(MAX(Fechas[Date_1er_día_mes]) = DATE(2021,09,01), 1,
			IF(MAX(Fechas[Date_1er_día_mes]) = DATE(2021,10,01), 0,
			IF(MAX(Fechas[Date_1er_día_mes]) = DATE(2021,11,01), 0,
			IF(MAX(Fechas[Date_1er_día_mes]) = DATE(2021,12,01), 0,
			IF(MAX(Fechas[Date_1er_día_mes]) = DATE(2022,01,01), 0,
			IF(MAX(Fechas[Date_1er_día_mes]) = DATE(2022,02,01), 0,
			IF(MAX(Fechas[Date_1er_día_mes]) = DATE(2022,03,01), 0,
			IF(MAX(Fechas[Date_1er_día_mes]) = DATE(2022,04,01), 0,
			1-SUM('Resumen KGI1-3-Final'[Peso_No_Obtenido]))))))))))))))))))))))))))))))
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: 2299f2e4-7ffd-477f-a89b-a13b081ef5a2

	measure 'Puntos KGI13' = 10
		formatString: 0
		lineageTag: 779a4f4e-d626-4216-9d13-9572ad6b75af

	measure 'Puntos_obtenidos KGI13' = IF(MAX(Fechas[SERVICE_P])=0,"N/A",[Peso Obtenido KGI13_M] * [Puntos KGI13])
		formatString: 0
		lineageTag: 8d46ec9c-31d8-4bd3-92c9-12449e2022cf

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Puntos Obtenidos KGI13_M average' =
			
			AVERAGEX(
				KEEPFILTERS(VALUES('Fechas'[MesNombreCorto])),
				CALCULATE([Puntos_obtenidos KGI13])
			)
		lineageTag: 2ae29aa2-8cd1-4e4d-bb9e-7f14a839d507

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Peso Obtenido KGI13_M average' =
			
			AVERAGEX(
				KEEPFILTERS(VALUES('Fechas'[MesNombreComp])),
				CALCULATE([Peso Obtenido KGI13_M])
			)
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: 25c3da44-416f-48b0-b457-58fe82ee9f7e

