		summarizeBy: none
		sourceColumn: Total sin Incidencias

		annotation SummarizationSetBy = Automatic

	column 'Tasa Real %' = DIVIDE('Resumen KGI1-3-Final'[Incidencias relacionadas], 'Resumen KGI1-3-Final'[Recuento], 0)
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: eed4ad13-7ad7-44e2-8750-155c502175ae
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Tasa Máxima permitida_KGI13' = 0.05
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: 1b86610b-aa9d-4199-8dc1-bb277553df41
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column ¿Cumple? = IF('Resumen KGI1-3-Final'[Tasa Real %] >'Resumen KGI1-3-Final'[Tasa Máxima permitida_KGI13], "No", "Sí")
		lineageTag: ce180c70-e0f8-4e27-ae01-3f8e6cf5b176
