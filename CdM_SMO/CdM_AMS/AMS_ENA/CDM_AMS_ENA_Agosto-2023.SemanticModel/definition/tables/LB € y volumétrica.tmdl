	measure Desviacion_Actual = [Total_LB_Real_Volumen]/[Total_Linea_Actual]
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 12598f69-4d1e-4896-8e11-999ca4ff0725

	measure Desviacion_Reservado = ```
			
			
			var proyectado = SUM('LB € y volumétrica'[LB Proyectado/Reservado Volumen])
			
			Var desviacion = (([Total_LB_Real_Volumen] + proyectado) / [Total_Linea_Actual])
			
			Return
			
			desviacion
			
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: f8e9f097-46b9-41ea-9be8-45e3e703aa1a

	measure Total_LB_Evolutivo = sum ('LB € y volumétrica'[LB Esperada Volumen])
		lineageTag: 127f06f6-9f19-4c90-a86f-0f196153627d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure LB_Real_acumulado = ```
			
			
			
			    var real_acumulado =  CALCULATE(
			    
			    TOTALYTD(SUM('LB € y volumétrica'[LB Real Volumen]),Fechas[Date]), FILTER(Fechas, Fechas[Date] <= EOMONTH(TODAY(), -1)))
			
			     RETURN
			
			     real_acumulado
			
			     
			
			     
			
			```
		formatString: 0
		lineageTag: 8976d700-5c10-4b5c-b9ce-98c01a1b50f3

	measure 'LB_Proyectado_acumulado 2' = ```
			
			    
			    var real_acumulado = 
			    
			    CALCULATE
			     (SUM('LB € y volumétrica'[LB Proyectado/Reservado Volumen]), 
			     FILTER(ALLSELECTED('LB € y volumétrica'),
			     'LB € y volumétrica'[Período] <= MAX('LB € y volumétrica'[Período])))
			
			     VAR real_acumulado2 =  CALCULATE
			     (SUM('LB € y volumétrica'[LB Real Volumen]), 
			     FILTER(ALLSELECTED('LB € y volumétrica'),
			     'LB € y volumétrica'[Período] <= MAX('LB € y volumétrica'[Período])))
			
			     var Real = CALCULATE(real_acumulado + real_acumulado2, Fechas[Date] >= EDATE(Fechas[Date],0))
			    
			
			     RETURN
			
			     Real
			```
		formatString: 0
		lineageTag: 7dbc4711-1160-4ac2-9fcc-394a943c7be1

