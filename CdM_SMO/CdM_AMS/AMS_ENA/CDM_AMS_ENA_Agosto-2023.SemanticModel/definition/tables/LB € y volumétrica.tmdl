		lineageTag: 29fc43c3-1d21-4248-9338-26747f87a7aa

	measure Total_Contratado_€ = SUM('LB € y volumétrica'[LB Comprometida €])
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: d3b4061d-9fb2-4f8b-9e94-6def792bd2ad

	measure Desviación_actual_€ = ```
			[Total_Contratado_€] - [Total_Real_€] 
			```
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: f3f232e0-5904-48cd-8980-1931b2c5ddcd

	measure Desviacion_Reservado_€ = ```
			
			
			var proyectado = SUM('LB € y volumétrica'[LB Proyectado/Reservado €])
			
			var proyectado2 =[Total_Contratado_€] - ([Total_Real_€] + proyectado)
			
			return
			
			proyectado2
			
			
			
			```
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: 353f9287-6bca-4e15-bcbd-08864c9b6542

	measure 'Desviacion actual' = ```
			
			
			[LB_Global_Real_Acumulado] / [LB_Global_Plan_Acumulado_Vol_]
			
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: ed3307db-1230-4ff8-902d-212539756091

