		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition Fechas-4d255649-a49d-4b3d-844c-89f20bea1cd2 = calculated
		mode: import
		source = CALENDAR(DATE(2020,01,01),MAX('PRO - Incidencias con SLA_P_y_A'[Cerrado].[Date]))

