	column 'Duración D:HH:MM:SS' =
			
			VAR VDUR21_2 = 'PRO - Incidencias con SLA_P_y_A_KGI21'[Duración real]
			  RETURN INT
			    (VDUR21_2/86400)&" Día(s) "&
			    RIGHT("0" & INT(MOD(VDUR21_2/3600,24)),2)&":"&
			    RIGHT("0" & INT(MOD(VDUR21_2/60,60)),2)&":"&
			    RIGHT("0" & INT(MOD(VDUR21_2,60)),2)
		lineageTag: b351e9f3-4449-4cb4-844b-9b491684f647
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Duración_EX D:HH:MM:SS' =
			
