			  RETURN INT
			    (VDUR21_EX_2/86400)&" Día(s) "&
			    RIGHT("0" & INT(MOD(VDUR21_EX_2/3600,24)),2)&" HH"
		lineageTag: 9a7bba09-93a4-4736-a077-7979532323fd
