table BI_Aplicación
	lineageTag: 82b2279e-d662-45a3-9255-f6bf1a762a3f

	measure 'Presupuesto Real €' = CALCULATE(SUM('BI_Aplicación'[Valor]), 'BI_Aplicación'[Descripción Ámbito] ="Evolutivos", 'BI_Aplicación'[Atributo] = "Presupuesto")
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: f68272cc-4fa2-4b2c-a229-5c91a7e3f12d

	measure 'Línea Base Real consumida €' = CALCULATE(SUM('BI_Aplicación'[Valor]), 'BI_Aplicación'[Descripción Ámbito] = "Evolutivos", 'BI_Aplicación'[Atributo] = "Consumo Real", MONTH('BI_Aplicación'[Periodo]<= MONTH(TODAY())))
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: 8d83a0bd-5eaa-4c04-9bf5-2661f5cacfb8

	measure '€_presupuesto restante' = [Presupuesto Real €] - [Línea Base Real consumida €]
