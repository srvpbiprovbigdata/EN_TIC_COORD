	partition BI_Aplicación-23dc3e5c-be57-4e8e-9c4e-5954961e74e4 = m
		mode: import
		queryGroup: 'Línea Base'
		source =
				let
				    URL = sharepointSource & Entorno & LBEnergia,
				    Origen = Excel.Workbook(Web.Contents(URL & "Líneas Base Energía v0.2 - Nuevos Presupuestos.xlsx"), null, true),
				    BI_Aplicación_Sheet = Origen{[Item="Bi_Maximo",Kind="Sheet"]}[Data],
				    #"Encabezados promovidos" = Table.PromoteHeaders(BI_Aplicación_Sheet, [PromoteAllScalars=true]),
				    #"Tipo cambiado" = Table.TransformColumnTypes(#"Encabezados promovidos",{{"Servicio TIC", type text}, {"Ámbito", type text}, {"Descripción Ámbito", type text}, {"Área", type text}, {"SubÁrea", type text}, {"Aplicación", type text}, {"Línea Base Real", type number}, {"Línea Base Proyectada", type number}, {"Línea Base Real Uts", type number}, {"Línea Base Proyectada Uts", type number}, {"Periodo", type date}, {"Tarifa", Int64.Type}}),
				    #"Columnas quitadas" = Table.RemoveColumns(#"Tipo cambiado",{"Tarifa"}),
				    #"Tipo cambiado3" = Table.TransformColumnTypes(#"Columnas quitadas",{{"Línea Base Real", type number}, {"Línea Base Proyectada", type number}, {"Presupuesto", type number}}),
