		lineageTag: b9d6d799-f4a4-4c9f-a0f8-1b864ae8855c

	measure Meses_Restantes_Año_1 =
			IF(
			    YEAR(TODAY()) > YEAR(MAX('BI_Aplicación'[Periodo])),
			    1,
			    12 - MONTH(TODAY())
			)
		formatString: 0
		lineageTag: 64800829-db79-4da8-9947-cd89c2efec59

	measure Desviacion-Proyectado = [Presupuesto Real €] - [Línea Base Real Consumida €] - [LB proyectada Evo €] - 47058
