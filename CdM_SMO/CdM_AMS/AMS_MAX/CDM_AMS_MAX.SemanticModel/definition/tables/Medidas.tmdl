	measure KGI21_Final =
			if(((1- calculate(count('PRO - Incidencias con SLA_P_y_A'[Número]),'PRO - Incidencias con SLA_P_y_A'[Infringido]=TRUE(),'PRO - Incidencias con SLA_P_y_A'[Prioridad]="Crítica")/CALCULATE(count('PRO - Incidencias con SLA_P_y_A'[Número]),'PRO - Incidencias con SLA_P_y_A'[Prioridad]="Crítica"))-CALCULATE(SUM('Parametros KGI21'[% Cumplimiento]),'Parametros KGI21'[Prioridad ]="Crítica"))<0,0,calculate(sum('Parametros KGI21'[Pesos]),'Parametros KGI21'[Prioridad ]="Crítica"))+
			if(((1- calculate(count('PRO - Incidencias con SLA_P_y_A'[Número]),'PRO - Incidencias con SLA_P_y_A'[Infringido]=TRUE(),'PRO - Incidencias con SLA_P_y_A'[Prioridad]="Alta")/CALCULATE(count('PRO - Incidencias con SLA_P_y_A'[Número]),'PRO - Incidencias con SLA_P_y_A'[Prioridad]="Alta"))-CALCULATE(SUM('Parametros KGI21'[% Cumplimiento]),'Parametros KGI21'[Prioridad ]="Alta"))<0,0,calculate(sum('Parametros KGI21'[Pesos]),'Parametros KGI21'[Prioridad ]="Alta"))+
			
			if(((1- calculate(count('PRO - Incidencias con SLA_P_y_A'[Número]),'PRO - Incidencias con SLA_P_y_A'[Infringido]=TRUE(),'PRO - Incidencias con SLA_P_y_A'[Prioridad]="Media")/CALCULATE(count('PRO - Incidencias con SLA_P_y_A'[Número]),'PRO - Incidencias con SLA_P_y_A'[Prioridad]="Media"))-CALCULATE(SUM('Parametros KGI21'[% Cumplimiento]),'Parametros KGI21'[Prioridad ]="Media"))<0,0,calculate(sum('Parametros KGI21'[Pesos]),'Parametros KGI21'[Prioridad ]="Media"))+
			
			if(((1- calculate(count('PRO - Incidencias con SLA_P_y_A'[Número]),'PRO - Incidencias con SLA_P_y_A'[Infringido]=TRUE(),'PRO - Incidencias con SLA_P_y_A'[Prioridad]="Baja")/CALCULATE(count('PRO - Incidencias con SLA_P_y_A'[Número]),'PRO - Incidencias con SLA_P_y_A'[Prioridad]="Baja"))-CALCULATE(SUM('Parametros KGI21'[% Cumplimiento]),'Parametros KGI21'[Prioridad ]="Baja"))<0,0,calculate(sum('Parametros KGI21'[Pesos]),'Parametros KGI21'[Prioridad ]="Baja"))
		lineageTag: 3b144e43-01f1-4b67-95d4-2d43bf5bb075

