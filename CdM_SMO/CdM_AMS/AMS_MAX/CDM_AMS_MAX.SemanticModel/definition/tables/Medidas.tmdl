	measure 'KGI22 % INCs Reabiertas del Periodo' = ```
			
			VAR __BASELINE_VALUE = [Total INCs cerradas del Periodo_M]
			VAR __VALUE_TO_COMPARE = [KGI22 Total INCs Reabiertas del Periodo_M]
			RETURN
				IF(
					NOT ISBLANK(__VALUE_TO_COMPARE),
					DIVIDE(__VALUE_TO_COMPARE, __BASELINE_VALUE),0
				)   
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
