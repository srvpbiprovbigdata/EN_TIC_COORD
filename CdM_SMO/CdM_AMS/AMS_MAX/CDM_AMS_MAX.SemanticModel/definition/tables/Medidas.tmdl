	measure 'KGIs T Puntos Obtenidos_M' =
			IF(MAX(Fechas[SERVICE_P])=0,"N/A", (
			[KGI11 Puntos Obtenidos_M]+
			[KGI12 Puntos Obtenidos_M]+
			[KGI13_PT Puntos Obtenidos_M]+
			[KGI14 Puntos Obtenidos_M]+
			[KGI15 Puntos Obtenidos_M]+
			[KGI16 Puntos Obtenidos_M])*0.60+
			(
			[KGI21 Puntos Obtenidos_M]+
			[KGI22 Puntos Obtenidos_M]+
			[KGI24 Puntos Obtenidos_M])*0.40)
		formatString: 0.0
		lineageTag: 71dd68ae-6615-4e0c-b00c-09a5c2764d69

	measure 'KGIs T Umbral Alcanzado' = IF (MAX(Fechas[SERVICE_P])=0,"N/A", IF([KGIs T Puntos Obtenidos_M]>=90,"Objetivo",IF([KGIs T Puntos Obtenidos_M]>=50,"Admisible","Crítico")))
		lineageTag: 256e8f2f-3ebd-431e-8363-51699bb6cb93

	measure 'KGIs T Umbral Objetivo_M' = MIN('Parametros Valores de Rendimiento'[Objetivo])
		formatString: 0
		lineageTag: 9c556e98-a43f-473b-b28e-4b773993d7b6

	measure 'KGIs T Penalización Periodo_M' =
			IF(MAX(Fechas[SERVICE_P])=0,"N/A",
			(IF([KGIs T Puntos Obtenidos_M]>=90,
			    0
			,
			IF([KGIs T Puntos Obtenidos_M]>=50,
			    -(([KGIs T Puntos Obtenidos_M]-[KGIs T Umbral Admisible_M])/([KGIs T Umbral Crítico_M]-[KGIs T Umbral Admisible_M]))*[KGIs T Penalización Máxima_M]
			,
			    -0.15
			))))
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: 53f2f826-5b8a-4e2d-b9fa-00b74e12bd7d

