	partition 'PRO - Incidencias con SLA_P_y_A-0372dffc-56a7-4dc5-b546-b758c41a1f06' = m
		mode: import
		queryGroup: KGIs_II
		source = ```
				let
				    URL = sharepointSource & Entorno & sharepointSource2 & incprevias & xlsx,
				    Origen = Excel.Workbook(Web.Contents(URL), null, true),
				    #"Page 1_Sheet" = Origen{[Item="Page 1", Kind="Sheet"]}[Data],
				    #"Encabezados promovidos" = Table.PromoteHeaders(#"Page 1_Sheet", [PromoteAllScalars=true]),
				    #"Tipo cambiado" = Table.TransformColumnTypes(#"Encabezados promovidos",{{"Número", type text}, {"Breve descripción", type text}, {"Subcategoría", type text}, {"Prioridad", type text}, {"Abierto", type datetime}, {"Cerrado", type datetime}, {"Fecha de resolución", type datetime}, {"Duración", Int64.Type}, {"Duración real", Int64.Type}, {"Infringido", type logical}, {"Tiempo original de incumplimiento", type datetime}, {"Estado", type text}, {"Estado SLA", type text}, {"Código de cierre", type text}, {"Reabierta", type logical}, {"Tipo de solución", type text}, {"Duración SLA", Int64.Type}, {"Porcentaje de negocio trascurrido", Int64.Type}}),
				    
				    #"Appended Query" = Table.Combine({#"Tipo cambiado", #"PRO - Incidencias con SLA_A"}),    
				
				      //Homologa las prioridades
				    #"AllReplace" = [#"1 - Crítica" = "Crítica", #"2 - Alta" = "Alta", #"3 - Moderada" = "Media",#"3 - Media" = "Media",#"4 - Baja" = "Baja",#"5 - Muy Baja" = "Baja"],    
				    #"Replaced Value" = Table.TransformColumns(#"Appended Query",{{"Prioridad",each Record.FieldOrDefault(AllReplace,_,_)}}),
				     
				    #"Filtered Rows3" = Table.SelectRows(#"Replaced Value", each ([Cerrado] <> null)),
				
				    #"Duplicated Column" = Table.DuplicateColumn(#"Filtered Rows3", "Cerrado", "Cerrado - Copy"),
				    #"Calculated Start of Month" = Table.TransformColumns(#"Duplicated Column",{{"Cerrado - Copy", Date.StartOfMonth, type datetime}}),
				    #"Extracted Date" = Table.TransformColumns(#"Calculated Start of Month",{{"Cerrado - Copy", DateTime.Date, type date}}),
				
				    #"Renamed Columns" = Table.RenameColumns(#"Extracted Date",{{"Subcategoría", "Sistema"}}),
				
				    //Une con tabla de alegaciones
				    #"Merged Queries" = Table.NestedJoin(#"Renamed Columns", {"Número"}, #"PRO - Alegaciones del Servicio KGI24", {"ID"}, "PRO - Alegaciones del Servicio", JoinKind.LeftOuter),
				    #"Expanded PRO - Alegaciones del Servicio" = Table.ExpandTableColumn(#"Merged Queries", "PRO - Alegaciones del Servicio", {"ANS", "Estado"}, {"PRO - Alegaciones del Servicio.ANS", "PRO - Alegaciones del Servicio.Estado"}),
				    #"Renamed Columns1" = Table.RenameColumns(#"Expanded PRO - Alegaciones del Servicio",{{"PRO - Alegaciones del Servicio.ANS", "ANS_Alegado"}, {"PRO - Alegaciones del Servicio.Estado", "Estado_Alegación"}}),
				
				
				    //Realiza la correcciones si la alegación es aceptada
				    #"Replaced Value2" = Table.ReplaceValue(#"Renamed Columns1",each [Prioridad],
				        each if [Estado_Alegación] = "1 - Aprobada" and [ANS_Alegado] = "KGI 2-4" then "Alta" else [Prioridad],Replacer.ReplaceValue,{"Prioridad"}),
				    #"Changed Type" = Table.TransformColumnTypes(#"Replaced Value2",{{"Prioridad", type text}}),
				
				    //Nuevo campo de Duración excedida, respecto a SLA
				    #"Added Custom" = Table.AddColumn(#"Changed Type", "Duración excedida", 
				    each if ([Duración real]-[Duración SLA])<0 then 0 else 
				    ([Duración real]-[Duración SLA])),
				
				    #"Divided Column" = Table.TransformColumns(#"Added Custom", {{"Porcentaje de negocio trascurrido", each _ / 100, Percentage.Type}})
				in
				    #"Divided Column"
				```

	annotation PBI_ResultType = Table

