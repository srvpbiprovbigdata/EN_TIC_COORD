table 'Resumen KGI12'
	lineageTag: bf625115-7082-47ab-97f7-644bf2dbaf23

	measure 'Puntos de KGI12_M' =
			
			var _KGI12_V = MIN('Resumen KGI12'[Puntos de KGI12])
			return
			IF(ISBLANK(_KGI12_V),30,_KGI12_V)
		lineageTag: 2c247831-4d92-4eaa-b38a-2c60c19229d6

	measure 'Peso Obtenido KGI12_M' = 1-SUM('Resumen KGI12'[Peso No Obtenido %])
		lineageTag: 4330d5c3-d0f5-4846-9c93-7eab3d146bbf

		annotation PBI_FormatHint = {"isGeneralNumber":true}

