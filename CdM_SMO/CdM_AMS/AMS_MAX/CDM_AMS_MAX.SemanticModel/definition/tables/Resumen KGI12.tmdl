		annotation SummarizationSetBy = Automatic

	column 'Planificaciones Cumplidas' = 'Resumen KGI12'[Total Planificaciones]-'Resumen KGI12'[Planificaciones Incumplidas]
		formatString: 0
		lineageTag: 5cce64b1-05b8-484c-9653-92175387b98d
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Cump. Real %' = ('Resumen KGI12'[Planificaciones Cumplidas])/('Resumen KGI12'[Total Planificaciones])
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: 37e27cf3-785b-4b5d-bbc7-54f7e49f90f8
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column ¿Cumple? = IF('Resumen KGI12'[Cump. Real %]>='Resumen KGI12'[Cump. Objetivo %],"Si","No")
		lineageTag: 974f7b25-e0d6-4211-b570-535b5d52ac49
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Peso Obtenido %' = IF('Resumen KGI12'[¿Cumple?]="Si",'Resumen KGI12'[Peso %],0)
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: bbc23f4a-3e88-449f-90c1-a829a3736473
