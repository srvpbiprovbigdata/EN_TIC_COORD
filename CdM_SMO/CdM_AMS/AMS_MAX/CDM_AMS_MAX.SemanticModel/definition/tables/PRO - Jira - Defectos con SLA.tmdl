				    #"Expanded PRO - Jira - Pruebas con SLA" = Table.ExpandTableColumn(#"Merged Queries1", "PRO - Jira - Pruebas con SLA", {"Priority", "Status"}, {"PRO - Jira - Pruebas con SLA.Priority", "PRO - Jira - Pruebas con SLA.Status"}),
				
				    //Homologa las prioridades
