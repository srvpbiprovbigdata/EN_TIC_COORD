	partition 'PRO - Jira - Defectos con SLA-c529664e-4ce4-4b6a-8d96-3f11a751901e' = m
		mode: import
		queryGroup: KGIs_I
		source = ```
				let
				    URL = sharepointSource & Entorno & sharepointSource2 & entregables & xlsx,
