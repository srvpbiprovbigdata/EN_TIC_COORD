	measure 'KGI13 MEDIA INCS ALTAS/CRITICAS' =
			VAR _selMonth = MAX(Fechas[Date_1er_día_mes])
			
			VAR _prevMonth = EDATE(_selMonth,-1)
			
			VAR _totalInc = CALCULATE(
			
			SUM('Resumen KGI13_1_Críticas/Altas'[Total Incidencias])
			
			,REMOVEFILTERS(Fechas)
			
			,DATESINPERIOD(Fechas[Date_1er_día_mes]
			
			,_prevMonth
			
			,-1
			
			,YEAR
			
			)
			
			)
			
			
			
			RETURN
			
			
			
			_totalInc / 12
		lineageTag: 3ec4c094-7f1f-43d2-ba6d-e63160d0f4fc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'KGI13 MEDIA INCS MEDIAS' =
