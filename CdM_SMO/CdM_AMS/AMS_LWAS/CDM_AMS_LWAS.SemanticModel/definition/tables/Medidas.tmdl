	measure 'KGI13 Media INCs "Altas" Movilidad Año Anterior_M' =
			
			(CALCULATE([KGI13 INCs Abiertas 1"Altas" del periodo_M],KEEPFILTERS('Lote_Aplicacion_relacion'[Lote]= "Movilidad"), PARALLELPERIOD(Fechas[Date],-1,MONTH)) +
			CALCULATE([KGI13 INCs Abiertas 1"Altas" del periodo_M],KEEPFILTERS('Lote_Aplicacion_relacion'[Lote]= "Movilidad"), PARALLELPERIOD(Fechas[Date],-2,MONTH)) +
			CALCULATE([KGI13 INCs Abiertas 1"Altas" del periodo_M],KEEPFILTERS('Lote_Aplicacion_relacion'[Lote]= "Movilidad"),PARALLELPERIOD(Fechas[Date],-3,MONTH)) +
			CALCULATE([KGI13 INCs Abiertas 1"Altas" del periodo_M],KEEPFILTERS('Lote_Aplicacion_relacion'[Lote]= "Movilidad"),PARALLELPERIOD(Fechas[Date],-4,MONTH)) +
			CALCULATE([KGI13 INCs Abiertas 1"Altas" del periodo_M],KEEPFILTERS('Lote_Aplicacion_relacion'[Lote]= "Movilidad"),PARALLELPERIOD(Fechas[Date],-5,MONTH)) +
			CALCULATE([KGI13 INCs Abiertas 1"Altas" del periodo_M],KEEPFILTERS('Lote_Aplicacion_relacion'[Lote]= "Movilidad"),PARALLELPERIOD(Fechas[Date],-6,MONTH)) +
			CALCULATE([KGI13 INCs Abiertas 1"Altas" del periodo_M],KEEPFILTERS('Lote_Aplicacion_relacion'[Lote]= "Movilidad"),PARALLELPERIOD(Fechas[Date],-7,MONTH)) +
			CALCULATE([KGI13 INCs Abiertas 1"Altas" del periodo_M],KEEPFILTERS('Lote_Aplicacion_relacion'[Lote]= "Movilidad"),PARALLELPERIOD(Fechas[Date],-8,MONTH)) +
			CALCULATE([KGI13 INCs Abiertas 1"Altas" del periodo_M],KEEPFILTERS('Lote_Aplicacion_relacion'[Lote]= "Movilidad"),PARALLELPERIOD(Fechas[Date],-9,MONTH)) +
			CALCULATE([KGI13 INCs Abiertas 1"Altas" del periodo_M],KEEPFILTERS('Lote_Aplicacion_relacion'[Lote]= "Movilidad"),PARALLELPERIOD(Fechas[Date],-10,MONTH)) +
			CALCULATE([KGI13 INCs Abiertas 1"Altas" del periodo_M],KEEPFILTERS('Lote_Aplicacion_relacion'[Lote]= "Movilidad"),PARALLELPERIOD(Fechas[Date],-11,MONTH)) +
			CALCULATE([KGI13 INCs Abiertas 1"Altas" del periodo_M],KEEPFILTERS('Lote_Aplicacion_relacion'[Lote]= "Movilidad"),PARALLELPERIOD(Fechas[Date],-12,MONTH)))/12
		lineageTag: 5bb4a3ad-a2a3-4201-b83f-40f52d57748b

