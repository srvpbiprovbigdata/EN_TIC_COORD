	measure Datos_Cerrados_AMS =
			IF(MAX(Fechas[Date_1er_día_mes]) > CALCULATE(MAX('PRO - Alegaciones del Servicio'[Periodo de Medida del ANS alegado - Copy]), ALLCROSSFILTERED(Fechas)),
			
			"#B3B3B3",
			
			"#6E817A"
			
