		lineageTag: 7bc9961e-bdb0-42d0-a1b7-33f7cacae162
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column MesNombreComp = UPPER(LEFT(FORMAT(Fechas[Date],"MMMM"),10))
