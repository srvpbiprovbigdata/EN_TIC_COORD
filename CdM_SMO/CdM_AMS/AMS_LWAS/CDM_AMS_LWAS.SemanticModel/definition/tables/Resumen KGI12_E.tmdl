table 'Resumen KGI12_E'
	lineageTag: 80b889eb-aeba-4d3d-acfc-9470dd71d214

	measure 'Puntos de KGI12_M' =
			
			var _KGI12_V = MIN('Resumen KGI12_E'[Puntos de KGI12])
			return
			IF(ISBLANK(_KGI12_V),30,_KGI12_V)
		lineageTag: 6c8a69a8-0902-4813-85eb-bfb3fcb2619e

	measure 'Peso Obtenido KGI12_M' = 1-SUM('Resumen KGI12_E'[Peso No Obtenido %])
		lineageTag: 97c158e1-9f4d-4bc7-9f9c-5c4dbdee1b8d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Puntos Obtenidos KGI12_M' = [Peso Obtenido KGI12_M]*[Puntos de KGI12_M]
		lineageTag: 9e2b0715-0f22-4f4a-a587-952159406181

