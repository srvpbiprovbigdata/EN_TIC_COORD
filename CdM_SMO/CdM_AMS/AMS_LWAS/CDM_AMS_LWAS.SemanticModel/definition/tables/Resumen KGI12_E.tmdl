	column 'Planificaciones Cumplidas' = 'Resumen KGI12_E'[Total Planificaciones]-'Resumen KGI12_E'[Planificaciones Incumplidas]
		formatString: 0
		lineageTag: f7f8448e-9691-435b-a400-83e24edf5c6e
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Cump. Real %' = ('Resumen KGI12_E'[Planificaciones Cumplidas])/('Resumen KGI12_E'[Total Planificaciones])
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: f7a5ca1d-e19d-4e62-ab56-54a727f2291a
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column ¿Cumple? = IF('Resumen KGI12_E'[Cump. Real %]>='Resumen KGI12_E'[Cump. Objetivo %],"Si","No")
		lineageTag: 4381397e-4952-4e29-a28e-ea3751452019
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Peso Obtenido %' = IF('Resumen KGI12_E'[¿Cumple?]="Si",'Resumen KGI12_E'[Peso %],0)
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: 95396440-82d2-48f5-b151-57957b262fea
