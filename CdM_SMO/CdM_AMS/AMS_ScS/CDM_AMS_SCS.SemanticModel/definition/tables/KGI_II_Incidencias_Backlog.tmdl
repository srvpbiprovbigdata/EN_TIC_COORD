				    #"Transforma Porcentaje negocio" = Table.TransformColumns(#"Valor reemplazado", {{"Porcentaje de negocio trascurrido", each _ / 100, Percentage.Type}}),
				    #"Inicio del mes insertado1" = Table.AddColumn(#"Transforma Porcentaje negocio", "Cerrado mes", each Date.StartOfMonth([Cerrado]), type datetime),
				    #"Tipo cambiado1" = Table.TransformColumnTypes(#"Inicio del mes insertado1",{{"Abierto mes", type date}, {"Reabierta", Int16.Type}, {"Duración del negocio", Int64.Type}, {"Infringido", Logical.Type},{"Cerrado mes", type date},{"Cerrado", type date},{"Abierto", type date},{"Extracción", type date}}),
				    #"Columna condicional agregada" = Table.AddColumn(#"Tipo cambiado1", "Prioridad grupo ANS1.3", each if [Prioridad] = "1 - Crítica" then "Crítica" else if [Prioridad] = "2 - Alta" then "Alta" else if [Prioridad] = "3 - Moderada" then "Media" else "Baja", type text),
				    ID_KGI_2.1 = Table.AddColumn(#"Columna condicional agregada", 
				                 "ID_KGI2.1", 
				                 each if [Prioridad] = "1 - Crítica" then "2-1-4-1" 
