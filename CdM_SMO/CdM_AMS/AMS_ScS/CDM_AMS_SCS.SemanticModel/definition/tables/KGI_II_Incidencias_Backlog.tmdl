				    #"Otras columnas quitadas" = Table.SelectColumns(#"Columna condicional agregada4",{"Extracción", "Número", "Subcategoría", "Abierto", "Abierto por", "Cerrado", "Duración del negocio", "Porcentaje de negocio trascurrido", "Elemento de configuración", "Abierto mes", "Cerrado mes", "Prioridad grupo ANS1.3", "ID_KGI_2.5", "Alegación_aceptada", "Estado_abierta"}),
