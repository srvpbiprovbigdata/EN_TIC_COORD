				    #"Se expandió T_Alegaciones" = Table.ExpandTableColumn(#"Consultas combinadas2", "T_Alegaciones_Resumen", {"Alegaciones"}, {"Alegaciones"}),
				    #"Infringido con alegaciones" = Table.AddColumn(#"Se expandió T_Alegaciones", "Alegación_aceptada", each if /*[Infringido] = true and*/ [Alegaciones] <> null and Text.Contains([Alegaciones],"2-5")  then true else false, Logical.Type),
				    #"Columna condicional agregada4" = Table.AddColumn(#"Infringido con alegaciones", "Estado_abierta", 
				                  each if [Abierto mes] <= [Extracción] and (([Cerrado mes] > [Extracción] and [Cerrado mes] > [Abierto mes])
