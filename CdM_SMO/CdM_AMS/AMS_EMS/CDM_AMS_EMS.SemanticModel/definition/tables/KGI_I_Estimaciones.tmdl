	column 'Duración tabla' = ```
			
			
			VAR VDUR21_2 = KGI_I_Estimaciones[Duración del negocio]
			VAR _duracCalculada = INT (VDUR21_2/86400)&" Día(s) "&
			    RIGHT("0" & INT(MOD(VDUR21_2/3600,24)),2)&":"&
			    RIGHT("0" & INT(MOD(VDUR21_2/60,60)),2)&":"&
			    RIGHT("0" & INT(MOD(VDUR21_2,60)),2)
			
			RETURN 
			
			_duracCalculada
			```
		lineageTag: b2bf499a-da62-44b4-b76e-22b3ba31e152
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Duración excedida'
