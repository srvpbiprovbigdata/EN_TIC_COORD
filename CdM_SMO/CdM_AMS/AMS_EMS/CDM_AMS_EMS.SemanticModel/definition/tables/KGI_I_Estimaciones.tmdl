				    #"Inicio de mes insertado" = Table.AddColumn(#"Tipo cambiado", "Finalización mes", each Date.StartOfMonth([Hora de finalización]), type date),
				    #"Tipo cambiado1" = Table.TransformColumnTypes(#"Inicio de mes insertado",{{"Finalización mes", type date}}),
				    #"Texto en mayúsculas" = Table.TransformColumns(#"Tipo cambiado1",{{"Aplicación de Negocio", Text.Upper, type text}}),
				
				// Homologa prioridades
				
				    #"Columna condicional agregada" = Table.AddColumn(#"Texto en mayúsculas", "Prioridad grupo", each if [Prioridad] = "1 - Crítica" then "Crítica" else if [Prioridad] = "2 - Alta" then "Alta" 
				else if [Prioridad] = "3 - Moderada" then "Media" else if [Prioridad] = "4 - Baja" then "Baja" else if [Prioridad] = "5 - Muy Baja" then "Baja" else null, type text),
				    #"Columna condicional agregada1" = Table.AddColumn(#"Columna condicional agregada", "ID_KGI1.1", each if [Prioridad grupo] = "Crítica" then "1-1-2-1" else if [Prioridad grupo] = "Alta" then "1-1-2-2" else if [Prioridad grupo] = "Media" then "1-1-2-3" else if [Prioridad grupo] = "Baja" then "1-1-2-4" else null, type text),
				    #"Duración cambiado a Duración SLA" = Table.RenameColumns(#"Columna condicional agregada1",{{"Duración", "Duración SLA"}}),
				    #"Cálculo Duración excedida" = Table.AddColumn(#"Duración cambiado a Duración SLA", "Duración excedida", 
				    each if ([Duración del negocio]-[Duración SLA])<0 then 0 else 
				    ([Duración del negocio]-[Duración SLA])),
				    #"Transformado %_negocio" = Table.TransformColumns(#"Cálculo Duración excedida", {{"Porcentaje de negocio trascurrido", each _ / 100, Percentage.Type}}),
				    #"Consultas combinadas1" = Table.NestedJoin(#"Transformado %_negocio", {"Tarea"}, T_Alegaciones, {"ID"}, "T_Alegaciones", JoinKind.LeftOuter),
				    #"Se expandió T_Alegaciones" = Table.ExpandTableColumn(#"Consultas combinadas1", "T_Alegaciones", {"ID Alegación", "Solicitante", "ANS", "Estado"}, {"T_Alegaciones.ID Alegación", "T_Alegaciones.Solicitante", "T_Alegaciones.ANS", "T_Alegaciones.Estado"}),
				    #"Infringido con alegaciones" = Table.AddColumn( #"Se expandió T_Alegaciones", "Infringido_alegaciones", each if [Infringido] = true and [T_Alegaciones.Estado] = "1 - Aprobada" and [T_Alegaciones.ANS] = "KGI 1-1" then false else [Infringido], Logical.Type),
				    #"Duplicados quitados" = Table.Distinct(#"Infringido con alegaciones", {"Tarea"}),
				    #"Personalizada agregada" = Table.AddColumn(#"Duplicados quitados", "Duracion Horas", each [Duración del negocio] / 3600),
				    #"Tipo cambiado2" = Table.TransformColumnTypes(#"Personalizada agregada",{{"Duracion Horas", type number}}),
				    #"Columna condicional agregada5" = Table.AddColumn(#"Tipo cambiado2", "Prioridad jornadas", each if [Prioridad grupo] = "Alta" then "Alta - 3 Jornadas" else if [Prioridad grupo] = "Media" then "Media - 4 Jornadas" else if [Prioridad grupo] = "Baja" then "Baja - 5 Jornadas" else null),
				    #"Columna condicional agregada2" = Table.AddColumn(#"Columna condicional agregada5", "Valor Objetivo", each if [Prioridad grupo] = "Alta" then 3 else if [Prioridad grupo] = "Media" then 4 else if [Prioridad grupo] = "Baja" then 5 else null),
				    #"Tipo cambiado3" = Table.TransformColumnTypes(#"Columna condicional agregada2",{{"Valor Objetivo", Int64.Type}}),
				    #"Personalizada agregada1" = Table.AddColumn(#"Tipo cambiado3", "Duración negocio(h)", each [Duración del negocio] / 3600),
				    #"Personalizada agregada2" = Table.AddColumn(#"Personalizada agregada1", "Valor Objetivo (h.)", each [Valor Objetivo] * 8),
				    #"Columnas reordenadas" = Table.ReorderColumns(#"Personalizada agregada2",{"Creado", "Número", "Aplicación de Negocio", "Prioridad", "Tarea", "Etapa", "Tiempo de negocio restante", "Duración del negocio", "Porcentaje de negocio trascurrido", "Hora de inicio", "Tiempo de pausa", "Hora de finalización", "Grupo de asignación", "Infringido", "Hora de infracción", "Duración SLA", "Finalización mes", "Prioridad grupo", "ID_KGI1.1", "Duración excedida", "T_Alegaciones.ID Alegación", "T_Alegaciones.Solicitante", "T_Alegaciones.ANS", "T_Alegaciones.Estado", "Infringido_alegaciones", "Duracion Horas", "Prioridad jornadas", "Valor Objetivo", "Valor Objetivo (h.)", "Duración negocio(h)"}),
				    #"Columnas con nombre cambiado" = Table.RenameColumns(#"Columnas reordenadas",{{"Valor Objetivo", "Valor Objetivo jornadas"}}),
				    #"Tipo cambiado4" = Table.TransformColumnTypes(#"Columnas con nombre cambiado",{{"Valor Objetivo (h.)", Int64.Type}, {"Duración negocio(h)", type number}}),
				    #"Personalizada agregada3" = Table.AddColumn(#"Tipo cambiado4", "Tasa desviación", each [#"Duración negocio(h)"] / [#"Valor Objetivo (h.)"]),
				    #"Tipo cambiado5" = Table.TransformColumnTypes(#"Personalizada agregada3",{{"Tasa desviación", type number}}),
