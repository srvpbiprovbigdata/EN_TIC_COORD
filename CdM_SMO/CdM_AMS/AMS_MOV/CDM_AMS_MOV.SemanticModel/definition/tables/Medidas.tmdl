		formatString: 0.0
		lineageTag: 2810f888-7a96-4099-8484-bd3e3a8bf5fc

	measure KGI21_Final =
			if(((1- calculate(count('PRO - Incidencias con SLA (NY y MAD)'[Número]),'PRO - Incidencias con SLA (NY y MAD)'[Infringido]=TRUE(),'PRO - Incidencias con SLA (NY y MAD)'[Prioridad]="Crítica")/CALCULATE(count('PRO - Incidencias con SLA (NY y MAD)'[Número]),'PRO - Incidencias con SLA (NY y MAD)'[Prioridad]="Crítica"))-CALCULATE(SUM('Parametros KGI21'[% Cumplimiento]),'Parametros KGI21'[Prioridad ]="Crítica"))<0,0,calculate(sum('Parametros KGI21'[Pesos]),'Parametros KGI21'[Prioridad ]="Crítica"))+
			if(((1- calculate(count('PRO - Incidencias con SLA (NY y MAD)'[Número]),'PRO - Incidencias con SLA (NY y MAD)'[Infringido]=TRUE(),'PRO - Incidencias con SLA (NY y MAD)'[Prioridad]="Alta")/CALCULATE(count('PRO - Incidencias con SLA (NY y MAD)'[Número]),'PRO - Incidencias con SLA (NY y MAD)'[Prioridad]="Alta"))-CALCULATE(SUM('Parametros KGI21'[% Cumplimiento]),'Parametros KGI21'[Prioridad ]="Alta"))<0,0,calculate(sum('Parametros KGI21'[Pesos]),'Parametros KGI21'[Prioridad ]="Alta"))+
			
			if(((1- calculate(count('PRO - Incidencias con SLA (NY y MAD)'[Número]),'PRO - Incidencias con SLA (NY y MAD)'[Infringido]=TRUE(),'PRO - Incidencias con SLA (NY y MAD)'[Prioridad]="Media")/CALCULATE(count('PRO - Incidencias con SLA (NY y MAD)'[Número]),'PRO - Incidencias con SLA (NY y MAD)'[Prioridad]="Media"))-CALCULATE(SUM('Parametros KGI21'[% Cumplimiento]),'Parametros KGI21'[Prioridad ]="Media"))<0,0,calculate(sum('Parametros KGI21'[Pesos]),'Parametros KGI21'[Prioridad ]="Media"))+
			
			if(((1- calculate(count('PRO - Incidencias con SLA (NY y MAD)'[Número]),'PRO - Incidencias con SLA (NY y MAD)'[Infringido]=TRUE(),'PRO - Incidencias con SLA (NY y MAD)'[Prioridad]="Baja")/CALCULATE(count('PRO - Incidencias con SLA (NY y MAD)'[Número]),'PRO - Incidencias con SLA (NY y MAD)'[Prioridad]="Baja"))-CALCULATE(SUM('Parametros KGI21'[% Cumplimiento]),'Parametros KGI21'[Prioridad ]="Baja"))<0,0,calculate(sum('Parametros KGI21'[Pesos]),'Parametros KGI21'[Prioridad ]="Baja"))
		lineageTag: 3d5bbcbe-17e6-429a-8f40-9bac861b720a

