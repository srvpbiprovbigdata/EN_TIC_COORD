	measure 'KGI23 Media INCs Trim Anterior_M' = ```
			
			(CALCULATE([Total INCs abiertas del Periodo_M],PARALLELPERIOD(Fechas[Date],-1,MONTH)) + 
			CALCULATE([Total INCs abiertas del Periodo_M],PARALLELPERIOD(Fechas[Date],-2,MONTH)) +
			CALCULATE([Total INCs abiertas del Periodo_M],PARALLELPERIOD(Fechas[Date],-3,MONTH)))/3
