	partition 'PRO - Planificaciones PRJ y ENH con SLA (staging)-3a42133c-ec57-41e7-aa39-51e86a685d73' = m
		mode: import
		queryGroup: KGIs_I
		source =
				let
				    Entorno = Entorno,
				    BaseUrl = "https://acciona365.sharepoint.com",
				    RelativePath ="/sites/EN_TIC_COORD_" & Entorno & "/Documentos compartidos/CdM_SMO/CdM_AMS/AMS_MOV/Ficheros del Servicio/AMS_IAR_CDM_SLA_I_Planificaciones de PRJs" & xlsx, //& AMS_IAR_CDM_ & "Parámetros KGIs" & xlsx,
				    Origen = Excel.Workbook(Web.Contents(BaseUrl & RelativePath), null, true),
				    #"Page 1_Sheet" = Origen{[Item="Page 1",Kind="Sheet"]}[Data]
				in
				    #"Page 1_Sheet"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navegación

