		lineageTag: 597a99f7-a20a-4591-808a-8d1a2ec57530
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Cump. Real %' = ('Resumen KGI12'[Planificaciones Cumplidas])/('Resumen KGI12'[Total Planificaciones])
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: 8da3c9f0-3f88-447e-95ce-5b5f7f3426a6
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column ¿Cumple? = IF('Resumen KGI12'[Cump. Real %]>='Resumen KGI12'[Cump. Objetivo %],"Si","No")
		lineageTag: cbe2be25-3eca-45e2-a89e-17ae00de1096
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Peso Obtenido %' = IF('Resumen KGI12'[¿Cumple?]="Si",'Resumen KGI12'[Peso %],0)
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: 87aa4c13-777a-4b64-85b9-a8cb0b866525
