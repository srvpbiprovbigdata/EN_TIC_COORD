table 'Resumen KGI12'
	lineageTag: 2dbfd5bc-276f-4add-a7f2-a236e18e44b1

	measure 'Puntos de KGI12_M' =
			
			var _KGI12_V = MIN('Resumen KGI12'[Puntos de KGI12])
			return
			IF(ISBLANK(_KGI12_V),30,_KGI12_V)
		lineageTag: c1657fef-6680-4ccd-8cc3-c99d62c04334

	measure 'Peso Obtenido KGI12_M' = 1-SUM('Resumen KGI12'[Peso No Obtenido %])
