				        "Linked Issues.10", 
				        "Linked Issues.11",         
				        "Linked Issues.12",         
				        "Linked Issues.13",         
				        "Linked Issues.14",         
				        "Linked Issues.15",         
				        "Linked Issues.16",         
				        "Linked Issues.17",         
				        "Linked Issues.18",         
				        "Linked Issues.19",         
				        "Linked Issues.20"         
				        }),
				
				    #"Changed Type1" = Table.TransformColumnTypes(#"Split Column by Delimiter",{
				        {"Linked Issues.1", type text}, 
				        {"Linked Issues.2", type text}, 
				        {"Linked Issues.3", type text},
				        {"Linked Issues.4", type text},
				        {"Linked Issues.5", type text},
				        {"Linked Issues.6", type text},
				        {"Linked Issues.7", type text},
				        {"Linked Issues.8", type text},
				        {"Linked Issues.9", type text},
				        {"Linked Issues.10", type text},
				        {"Linked Issues.11", type text},
				        {"Linked Issues.12", type text},
				        {"Linked Issues.13", type text},
				        {"Linked Issues.14", type text},
				        {"Linked Issues.15", type text},
				        {"Linked Issues.16", type text},
				        {"Linked Issues.17", type text},
				        {"Linked Issues.18", type text},
				        {"Linked Issues.19", type text},
				        {"Linked Issues.20", type text}        
				        }),
				
				    #"Split Column by Delimiter1" = Table.SplitColumn(#"Changed Type1", "Sub-tasks", Splitter.SplitTextByDelimiter(";", QuoteStyle.Csv), {
				        "Sub-tasks.1",
				        "Sub-tasks.2",
				        "Sub-tasks.3",
				        "Sub-tasks.4",
				        "Sub-tasks.5"       
				        }),
				
				    #"Changed Type2" = Table.TransformColumnTypes(#"Split Column by Delimiter1",{
				        {"Sub-tasks.1", type text}, 
				        {"Sub-tasks.2", type text}, 
				        {"Sub-tasks.3", type text},
				        {"Sub-tasks.4", type text},
				        {"Sub-tasks.5", type text}
				        }),
				
				    #"Unpivoted Columns" = Table.UnpivotOtherColumns(#"Changed Type2", {"Components","Project", "Issue Type", "Key", "Summary", "Assignee", "Reporter", "Priority", "Status", "Created", "Tipo de prueba", "Resolved"}, "Attribute", "Value (Stories)"),
				
				    //Une con Ejecuciones
				    #"Merged Queries" = Table.NestedJoin(#"Unpivoted Columns", {"Value (Stories)"}, #"PRO - Jira - Ejecuciones", {"Key"}, "PRO - Jira - Ejecuciones", JoinKind.LeftOuter),
				    #"Expanded PRO - Jira - Ejecuciones" = Table.ExpandTableColumn(#"Merged Queries", "PRO - Jira - Ejecuciones", {"Status", "Tipo de prueba"}, {"PRO - Jira - Ejecuciones.Status", "PRO - Jira - Ejecuciones.Tipo de prueba"})
				in
				    #"Expanded PRO - Jira - Ejecuciones"
				```

