	partition 'PRO - Incidencias con SLA (NY y MAD) - Abiertas (staging)-31243fb7-6af3-4013-aa09-732333f18d4a' = m
		mode: import
		queryGroup: KGIs_II
		source =
				let
				    Entorno = Entorno,
				    BaseUrl = "https://acciona365.sharepoint.com",
				    RelativePath ="/sites/EN_TIC_COORD_" & Entorno & "/Documentos compartidos/CdM_SMO/CdM_AMS/AMS_MOV/Ficheros del Servicio/AMS_IAR_CDM_SLA_II_Incidencias (SN Madrid)" & xlsx, //& AMS_IAR_CDM_ & "Parámetros KGIs" & xlsx,
