table incident
	lineageTag: 0836b594-6946-4244-950f-73b37ec28181

	measure 'Total de Incidencias' = COUNT(incident[number])
		formatString: 0
		lineageTag: 00566805-7273-4308-aae0-dc34446a976e

		changedProperty = IsHidden

	measure 'Total abiertos' = CALCULATE(incident[Total de Incidencias],incident[Estado]="Nuevo")+CALCULATE(incident[Total de Incidencias],incident[Estado]="En espera")+CALCULATE(incident[Total de Incidencias],incident[Estado]="En Curso")
		formatString: 0
		lineageTag: 1ad15405-5a0d-4c86-b4b9-477bd50224ad

		changedProperty = IsHidden

	measure 'Total Cerrados' = CALCULATE(incident[Total de Incidencias],incident[Estado]="Cerrado")+CALCULATE(incident[Total de Incidencias],incident[Estado]="Resuelto")
		formatString: 0
		lineageTag: 2a1e8fe4-427a-4e3d-9ebc-f5a2f09f1d4b

		changedProperty = IsHidden

	measure 'Total Backlog' = ```
			
			
			VAR _fechaMaxima = MAX(incident[Fecha Apertura])
			VAR _acumAbiertos = 
			        CALCULATE([Total abiertos],
			                  FILTER(ALLSELECTED(incident),incident[Fecha Apertura] <= _fechaMaxima))
			VAR _acumCerrados =
			        CALCULATE([Total Cerrados],
			                  FILTER(ALLSELECTED(incident),incident[Fecha Apertura] <= _fechaMaxima))
			
			RETURN
			
			_acumAbiertos - _acumCerrados
			```
		formatString: 0
		lineageTag: 1104c0f2-4a66-4f30-ae6c-731cd704de01

		changedProperty = IsHidden

	measure 'Total Prioridad' = CALCULATE(incident[Total de Incidencias],incident[Prioridad]="1 - Critical")+CALCULATE(incident[Total de Incidencias],incident[Prioridad]="2 - High")
		formatString: 0
		lineageTag: fb21e728-6b81-449d-8012-11ce88c0afce

		changedProperty = IsHidden

	measure 'Causadas por Cambios' = CALCULATE(incident[Total de Incidencias],incident[caused_by]<>"")
		formatString: 0
		lineageTag: f1359bc1-b674-4349-b707-88bad8d49368

		changedProperty = IsHidden

	measure 'Incidencias que abren Cambios' = CALCULATE(incident[Total de Incidencias],incident[rfc]<>"")
