	measure _mostRepeatedGeo =
			
			VAR T1 =
			    SUMMARIZE( incident, incident[_geoUsu], "Count", COUNTROWS( incident ) )
			VAR MostRepeated =
			    MAXX( T1, [Count] )
			RETURN
			    MAXX( T1, IF( [Count] = MostRepeated, incident[_geoUsu] ) )
		lineageTag: 54d4cf79-6b98-420c-829c-363b143be7ce

	measure __CerradasUltimaSemana = CALCULATE(COUNTROWS(incident)+0,FILTER('incident',and(incident[__EstadoGeneral]="Cerrada",and(incident[__NumSemanaCerrada]=[__SemanaCerrada], incident[__DiaCerrada].[Año]=year(today())))))
		formatString: 0
		lineageTag: 3ce45f15-e487-4506-b8ed-0ef3fa64ac8a

	measure __AbiertasUltimaSemana = CALCULATE(COUNTROWS(incident)+0,FILTER('incident',and(incident[__NumSemanaAbierta]=[__SemanaCerrada], incident[__DiaAbierta].[Año]=year(today()))))
		formatString: 0
		lineageTag: 8182aecb-e4fa-4262-95b8-fccda18fbbe0

	measure __AbiertasMes = CALCULATE(COUNTROWS(incident)+0,FILTER(incident, and(AND(YEAR(incident[__DiaAbierta].[Date])=year(today()),month(incident[__DiaAbierta].[Date])=month(today())), OR(OR(incident[Estado]="Nueva",incident[Estado]="En espera"), incident[Estado]="En curso"))))
		formatString: 0
		lineageTag: 55a3de60-75e1-496b-b47b-95bccc578b29

	measure __TotalAbiertas = CALCULATE(COUNTROWS(incident)+0,FILTER('incident',OR(OR(incident[Estado]="Nuevo",incident[Estado]="En espera"), incident[Estado]="En curso")))
		formatString: 0
		lineageTag: 014be438-80ec-4e0f-ac96-6fb79aea0963

	measure __TotalCerradas = COUNTROWS(incident)-[TotalIncidencias]-[__TotalCanceladas]+0
