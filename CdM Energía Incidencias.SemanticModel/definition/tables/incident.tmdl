		changedProperty = IsHidden

	measure 'Tasa de cierre mes' = IF(CALCULATE(incident[Total CerradasMesTotal])/CALCULATE(incident[Total Backlog Mes])<>0, CALCULATE(incident[Total CerradasMesTotal])/CALCULATE(incident[Total Backlog Mes]), 0)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
