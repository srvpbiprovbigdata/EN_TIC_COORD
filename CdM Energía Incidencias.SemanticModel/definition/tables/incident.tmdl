	partition incident-7e63c1be-552b-4333-97d0-55c3c2de6042 = m
		mode: import
		source = ```
				let
				Origen = Sql.Database("QECCDWH.acciona.int,60001", "DWH", [Query="select number, INC.sys_id,dv_u_external_vendor,opened_at,caused_by,dv_caused_by,dv_rfc,dv_caller_id,
				  dv_u_category,dv_u_subcategory,dv_priority,dv_state,dv_assignment_group,assignment_group,dv_assigned_to,u_progress,dv_opened_by,reopened_time,
				  actions_taken,INC.active,INC.sys_mod_count,INC.sys_updated_on,INC.sys_updated_by,cmdb_ci_business_app,approval,short_description,INC.dv_u_catalog,cause,closed_at,
				  dv_closed_by,knowledge,INC.sys_created_on,INC.sys_created_by, close_code,dv_u_department,description,upon_approval,upon_reject,dv_u_incident_diagnostic,sys_domain,
				  calendar_duration,business_duration,dv_cmdb_ci,INC.dv_company,user_input,u_oncall_team,escalation,dv_incident_state,major_incident_state,u_size,INC.sys_tags,
				  u_date_unavailability,approval_set,u_state_date,due_date,sla_due,work_end,timeline,severity,u_previous_groups,skills,approval_history,correlation_id,
				  dv_impact,business_impact,dv_parent_incident,child_incidents,expected_start,work_start,additional_assignee_list,group_list,work_notes_list,INC.dv_u_business_line,
				  INC.u_metal,dv_hold_reason,dv_u_subcategory_module,close_notes,work_notes,notify,reassignment_count,comments,comments_and_work_notes,service_offering,
				  u_parent_hold_reason,dv_u_ref_country,delivery_plan,dv_parent,u_acciona_priority,problem_id,promoted_on,promoted_by,proposed_on,proposed_by,
				  u_external_vendor,trigger_rule,u_responded,resolved_at,dv_resolved_by,lessons_learned,overview,INC.sys_domain_path,made_sla,follow_up,business_service,
				  subcategory,delivery_task,dv_task_for,u_phone,u_vendor_type,calendar_stc,business_stc,time_worked,dv_u_solution_type,contact_type,INC.sys_class_name,INC.dv_location,
				  dv_urgency,watch_list,activity_due,correlation_display,reopen_count,dv_reopened_by,u_csc_area,number as task_effective_number, INC.state,rfc,priority, 
				   iif(g.dv_g_u_country=u.dv_u_country,dv_assignment_group ,'GRUPO CORPORACIÓN') as grupodeasignación ,
				   case when dv_state like 'Resolved' then 
				  datediff(hour,opened_at,resolved_at)  else datediff(hour,opened_at,closed_at) end as TResolucion,u.dv_u_country paisusu,u.dv_location as locationusuario,
				  case when dv_state like 'Closed' then 'Cerrado'
				 when dv_state like 'Canceled' then 'Cancelado' when dv_state like 'In progress'then 'En curso' when dv_state like 'New' then 'Nuevo' when dv_state like 'On hold' then 'En espera'
				 when dv_state like 'Resolved' then 'Resuelto' end as Estado, INC.dv_u_ref_country paisIncidencia, g.dv_g_u_country as paisGrupo
				 from DWH.SERV_NOW.incident INC left join DWH.SERV_NOW.sys_user U on INC.opened_by=U.sys_id left join DWH.SERV_NOW.u_groups G on inc.assignment_group=g.g_sys_id
				  where (INC.opened_at BETWEEN '20220101 00:00:00' and getdate())"]),
