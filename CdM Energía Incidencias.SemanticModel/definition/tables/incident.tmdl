	measure 'Total previasCerradas' = ```
			CALCULATE(incident[Total de Incidencias],incident[Estado]="Cerrado",and(
				incident[Fecha Apertura]<today(),
				and(year(incident[Fecha Resuelta])=year(today()),month(incident[Fecha Resuelta])=month(today()))	
