	measure 'Media Resolución' = if(AVERAGEX(incident,incident[Fecha Cierre]-incident[Fecha Apertura])>0,AVERAGEX(incident,incident[Fecha Cierre]-incident[Fecha Apertura]),if(AVERAGEX(incident,incident[Fecha Resuelta]-incident[Fecha Apertura])>0,AVERAGEX(incident,incident[Fecha Resuelta]-incident[Fecha Apertura]),0))
		lineageTag: 48cf6804-a586-4285-b24d-447786ebe1e8

		changedProperty = FormatString

