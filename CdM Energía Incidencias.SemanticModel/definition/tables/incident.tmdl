	measure 'Total AbiertasMesesPasados' =
			CALCULATE(incident[Total de Incidencias],incident[Estado]<>"Cerrado",
				incident[Estado]<>"Cancelado",incident[Estado]<>"Resuelto",NOT(AND(YEAR(incident[Fecha Apertura])=year(today()),month(incident[Fecha Apertura])=month(today()))))
		formatString: 0
