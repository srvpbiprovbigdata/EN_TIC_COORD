	measure 'Total previasAbiertas' =
			CALCULATE(incident[Total de Incidencias],incident[Estado]="En espera",month(incident[Fecha Apertura])<month(today()))+
			CALCULATE(incident[Total de Incidencias],incident[Estado]="En curso",incident[Fecha Apertura])<month(today())+
			CALCULATE(incident[Total de Incidencias],incident[Estado]="Nuevo",incident[Fecha Apertura])<month(today())
